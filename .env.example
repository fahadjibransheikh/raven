GO_ENV=development

# HTTP boundary. The default listener is loopback-only.
RAVEN_ADDR=127.0.0.1:8090
RAVEN_BASE_URL=http://local.localhost:8090
# Optional client-network allowlist for ALL modes. Explicit lists replace defaults.
# Unset: open permits only loopback; personal/managed permit any client network.
# RAVEN_ALLOWED_CIDRS=127.0.0.0/8,::1/128,192.168.0.0/24
# Trust only the actual reverse-proxy peer addresses, if a proxy is used.
# RAVEN_TRUSTED_PROXY_CIDRS=127.0.0.1/32,::1/128
# Legacy unrestricted open-mode flag. A nonempty RAVEN_ALLOWED_CIDRS overrides it.
# RAVEN_ALLOW_UNAUTHENTICATED_REMOTE=false
# Allow a plain-HTTP RAVEN_BASE_URL on a private network address (for example
# http://192.168.0.10:8090) while sign-in is required. Sign-in cookies then travel
# unencrypted on that network, and passkeys are unavailable there.
# RAVEN_ALLOW_INSECURE_LAN=false

# Authentication. Application-login clients are identity-only and separate from mailbox clients.
# open: no login; personal: one protected profile; managed: separate administrators/users.
# When set, RAVEN_AUTH_MODE takes precedence over the legacy RAVEN_AUTH_ENABLED.
RAVEN_AUTH_MODE=open
# Managed mode: maximum user databases kept open (default 16). A higher limit
# reduces reopening for active users but uses more memory and file descriptors.
# RAVEN_USER_DB_MAX_OPEN=16
# Managed mode converts an existing shared database to per-user storage on the
# first start. Set this to refuse to start instead, for example while automatic
# updates are enabled, until you have backed up and are ready to convert.
# RAVEN_PREVENT_STORAGE_CONVERSION=false
# Legacy fallback when RAVEN_AUTH_MODE is unset: false=open, true=managed.
# RAVEN_AUTH_ENABLED=false
RAVEN_GOOGLE_LOGIN_CLIENT_ID=
RAVEN_GOOGLE_LOGIN_CLIENT_SECRET=
# Microsoft secrets are optional. Leave them empty for a public client
# (Azure: "Mobile and desktop applications" redirect, "Allow public client flows" on).
RAVEN_MICROSOFT_LOGIN_CLIENT_ID=
RAVEN_MICROSOFT_LOGIN_CLIENT_SECRET=
RAVEN_MICROSOFT_LOGIN_TENANT=common
# One optional generic OpenID Connect application-login provider. Identity only; no mailbox access.
RAVEN_OIDC_LOGIN_ISSUER=
RAVEN_OIDC_LOGIN_CLIENT_ID=
RAVEN_OIDC_LOGIN_CLIENT_SECRET=
RAVEN_OIDC_LOGIN_NAME=OpenID Connect

# Mailbox authorization. These clients grant Gmail/Outlook data access only after an authenticated Settings action.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
MICROSOFT_OAUTH_CLIENT_ID=
MICROSOFT_OAUTH_CLIENT_SECRET=
MICROSOFT_OAUTH_TENANT=common

# Optional Web Push override. If omitted, Raven generates and stores keys next to the DB.
RAVEN_VAPID_PUBLIC_KEY=
RAVEN_VAPID_PRIVATE_KEY=
RAVEN_VAPID_SUBJECT=https://github.com/fahadjibransheikh/raven
