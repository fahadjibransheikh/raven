<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- WidgetKit only loads sandboxed extensions. The widget reads a file the
	     Raven server writes into this sandbox; it makes no network calls. -->
	<key>com.apple.security.app-sandbox</key>
	<true/>
</dict>
</plist>
