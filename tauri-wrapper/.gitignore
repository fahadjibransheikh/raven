# Rust/Cargo build output
/src-tauri/target/

# Built Tauri config/gen artifacts
/src-tauri/gen/

# The staged Raven sidecar binary(ies) -- build output, not source.
# Keep the placeholder note so the directory itself still exists in git.
/src-tauri/binaries/*
!/src-tauri/binaries/.gitkeep

# Generated icon set (produced by `tauri icon`); icon.png (the source) is kept,
# and so is icon.icns, which scripts/logo/render.sh builds on Apple's icon grid
/src-tauri/icons/*.icns
!/src-tauri/icons/icon.icns
/src-tauri/icons/icon.ico
/src-tauri/icons/*.png
!/src-tauri/icons/icon.png
