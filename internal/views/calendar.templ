package views

import (
	"github.com/fahadjibransheikh/raven/components/checkbox"
	"github.com/fahadjibransheikh/raven/components/datepicker"
	"github.com/fahadjibransheikh/raven/components/dialog"
	"github.com/fahadjibransheikh/raven/components/dropdown"
	"github.com/fahadjibransheikh/raven/components/icon"
	"github.com/fahadjibransheikh/raven/components/popover"
	"github.com/fahadjibransheikh/raven/components/timepicker"
	"github.com/fahadjibransheikh/raven/components/toast"
	"github.com/fahadjibransheikh/raven/components/tooltip"
	"github.com/fahadjibransheikh/raven/internal/models"
	"strconv"
	"time"
)

templ CalendarLayout(accounts []models.Account, month CalendarMonthData, uiSettings map[string]string) {
	<!DOCTYPE html>
	<html lang="en" class={ themeClass(uiSettings) } data-theme-mode={ themeMode(uiSettings) } data-theme={ themeStyle(uiSettings) } data-mail-density={ mailListDensity(uiSettings) }>
		<head>
			<meta charset="UTF-8"/>
			<meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover"/>
			<title>Calendar — Raven</title>
			@AppIconFor(uiSettings)
			@SavedPanelSizeStyle()
			<link rel="stylesheet" href={ AssetURL("/assets/css/output.css") }/>
			@dialog.Script()
			@dropdown.Script()
			@popover.Script()
			@datepicker.Script()
			@timepicker.Script()
			@tooltip.Script()
			@toast.Script()
			@AppSidebarResponsiveStyle()
			<script src={ AssetURL("/assets/js/actions.js") }></script>
		</head>
		<body class="bg-background text-foreground antialiased" data-ui-settings={ uiSettingsJSON(uiSettings) }>
			@SkipToMain()
			@CalendarShell(accounts, month, uiSettings)
			<div id="app-pane-dialogs"></div>
			@ComposeDialog(accounts)
			@ChooseAccountTypeDialog()
			@GmailAccountDialog()
			@OutlookAccountDialog()
			@AddAccountDialog()
			<script src={ AssetURL("/assets/js/account-wizard.js") }></script>
			<div id="edit-account-container"></div>
			@CalendarLoadingTemplates(accounts, uiSettings)
			<script src={ AssetURL("/assets/js/htmx.min.js") }></script>
			<script src={ AssetURL("/assets/js/virtual-scroll.js") }></script>
			<script src={ AssetURL("/assets/js/app.js") }></script>
			<script src={ AssetURL("/assets/js/settings.js") }></script>
			<script src={ AssetURL("/assets/js/settings-page.js") }></script>
			<script src={ AssetURL("/assets/js/ui-settings.js") }></script>
			<script src={ AssetURL("/assets/js/raven.js") }></script>
			<script src={ AssetURL("/assets/js/whats-new.js") }></script>
			<script src={ AssetURL("/assets/js/phone-layout.js") }></script>
			<script src={ AssetURL("/assets/js/calendar-phone.js") }></script>
			<script src={ AssetURL("/assets/js/calendar-keys.js") }></script>
			<script src={ AssetURL("/assets/js/resize.js") }></script>
		</body>
	</html>
}

templ CalendarShell(accounts []models.Account, month CalendarMonthData, uiSettings map[string]string) {
	<div id="app-shell" class="flex h-screen overflow-hidden" data-calendar-app>
		@CalendarSidebar(accounts, uiSettingGet(uiSettings, "sidebar_width", "256px"))
		@ResizeHandle("sidebar")
		@CalendarPage(month, uiSettings)
		@PhoneTabBar("calendar")
	</div>
}

templ CalendarSidebar(accounts []models.Account, width string) {
	<aside class="hidden lg:flex flex-col bg-sidebar text-sidebar-foreground h-full overflow-hidden" style={ "width:" + width } data-app-sidebar data-phone-drawer>
		@SidebarHeader(accounts, "calendar")
		@CalendarSidebarBody(accounts)
		@SidebarFooter("calendar")
	</aside>
}

templ CalendarSidebarBody(accounts []models.Account) {
	@CalendarSidebarContent(accounts, false)
}

templ CalendarSidebarContent(accounts []models.Account, loading bool) {
	{{ configuredAccounts := calendarConfiguredAccounts(accounts) }}
	<div id="sidebar-app-body" class="flex min-h-0 flex-1 flex-col" data-sidebar-app-body="calendar" aria-busy={ strconv.FormatBool(loading) } inert?={ loading }>
		<div class="px-4 pb-4">
			<button type="button" disabled?={ loading || len(configuredAccounts) == 0 } title={ calendarCreateTitle(len(configuredAccounts) > 0) } data-calendar-create-trigger data-calendar-key="new" hx-get="/api/calendar/events/new" hx-target="#app-pane-dialogs" hx-swap="innerHTML" hx-sync="#app-pane-dialogs:replace" hx-disabled-elt="this" class="flex h-9 w-full cursor-pointer items-center justify-center gap-2 rounded-lg bg-primary text-sm font-medium text-primary-foreground transition-colors hover:bg-primary/90 disabled:cursor-wait disabled:opacity-50" aria-haspopup="dialog" aria-controls="calendar-create-dialog">
				@icon.CalendarPlus(icon.Props{Class: "size-4"})
				<span>New event</span>
			</button>
		</div>
		<hr class="divider-etched mx-4"/>
		<nav class="flex min-h-0 flex-1 flex-col overflow-y-auto px-3 pt-3 pb-3">
			<div class="px-2.5 pb-2 text-[11px] font-bold uppercase tracking-[0.16em] text-sidebar-foreground/45">Connected accounts</div>
			if len(configuredAccounts) == 0 && len(calendarUnselectedAccounts(accounts)) == 0 {
				<div class="rounded-md border border-sidebar-border/60 bg-sidebar-accent/20 px-2.5 py-3 text-xs leading-relaxed text-sidebar-foreground/55">
					<p>No calendar accounts configured yet.</p>
					<a href="/settings/accounts" class="mt-2 inline-flex items-center gap-1.5 font-semibold text-sidebar-primary hover:text-sidebar-accent-foreground">
						Open account setup
						@icon.ChevronRight(icon.Props{Class: "size-3"})
					</a>
				</div>
			} else {
				for _, account := range configuredAccounts {
					<div class="flex items-center gap-2.5 rounded-md px-2.5 py-2 text-sm text-sidebar-foreground/70">
						<div class="account-color-marker size-2.5 shrink-0" style={ accountColorStyle(account.Color) }></div>
						<div class="min-w-0 flex-1">
							<div class="truncate font-medium">{ calendarAccountDisplayName(account) }</div>
							<div class="truncate text-xs text-sidebar-foreground/50">{ calendarAccountProviderLabel(account) } account</div>
						</div>
					</div>
					<div class="mb-2 space-y-0.5" role="group" aria-label={ "Calendars for " + calendarAccountDisplayName(account) }>
						for _, source := range account.CalendarSources {
							<label class="group flex min-h-8 cursor-pointer items-center gap-2.5 rounded-md py-1.5 pl-7 pr-2.5 text-[12px] text-sidebar-foreground/80 transition-colors hover:bg-sidebar-accent/60 has-[:focus-visible]:ring-2 has-[:focus-visible]:ring-sidebar-ring" data-calendar-source-row>
								<span class="inline-flex shrink-0">
									@checkbox.Checkbox(checkbox.Props{
										ID:      "calendar-visible-" + source.ID,
										Checked: !source.IsHidden, Disabled: loading,
										Class: "size-3.5 border-sidebar-border checked:border-sidebar-primary checked:bg-sidebar-primary",
										Attributes: templ.Attributes{
											"data-calendar-visibility":    source.ID,
											"data-calendar-source-id":     source.ID,
											"data-calendar-source-hidden": strconv.FormatBool(source.IsHidden),
											"aria-label":                  "Show " + calendarSourceDisplayName(source),
										},
									})
								</span>
								<span class="size-2 shrink-0 rounded-full" style={ calendarEventColorStyle(CalendarEvent{SourceColor: source.Color}) }></span>
								<span class={ "min-w-0 flex-1 truncate", templ.KV("opacity-50", source.IsHidden) } data-calendar-source-name title={ calendarSourceDisplayName(source) }>{ calendarSourceDisplayName(source) }</span>
								<span class="relative inline-flex size-3 shrink-0">
									@CalendarSourceSyncIndicator(source, loading)
									<span data-calendar-visibility-status class="absolute inset-0 opacity-0" aria-hidden="true">@icon.LoaderCircle(icon.Props{Class: "size-3 animate-spin"})
</span>
								</span>
							</label>
						}
					</div>
				}
			}
			for _, account := range calendarUnselectedAccounts(accounts) {
				<div class="flex items-center gap-2.5 rounded-md px-2.5 py-2 text-sm text-sidebar-foreground/70" data-calendar-unselected-account>
					<div class="account-color-marker size-2.5 shrink-0" style={ accountColorStyle(account.Color) }></div>
					<div class="min-w-0 flex-1">
						<div class="truncate font-medium">{ calendarAccountDisplayName(account) }</div>
						<div class="truncate text-xs text-sidebar-foreground/50">{ calendarAccountProviderLabel(account) } account</div>
					</div>
				</div>
				<div class="mb-2 pl-7 pr-2.5 text-xs leading-relaxed text-sidebar-foreground/55">
					<p>No calendars selected.</p>
					<a href="/settings/accounts" class="mt-1 inline-flex items-center gap-1 font-semibold text-sidebar-primary hover:text-sidebar-accent-foreground">
						Choose calendars
						@icon.ChevronRight(icon.Props{Class: "size-3"})
					</a>
				</div>
			}
		</nav>
	</div>
}

templ CalendarPage(month CalendarMonthData, uiSettings map[string]string) {
	<div id="main-content" role="main" tabindex="-1" class="flex flex-1 min-w-0 bg-background">
		@CalendarMainPane(month, uiSettings)
		@ResizeHandle("maillist")
		@CalendarAgendaPane(month)
	</div>
}

templ CalendarSourceSyncIndicator(source models.AccountCalendarSource, loading bool) {
	<span data-calendar-source-sync={ source.ID } data-calendar-sync-attempt={ strconv.Itoa(source.SyncAttempt) } data-calendar-sync-state={ source.SyncState } data-calendar-last-synced={ source.LastSyncedAt } data-calendar-next-attempt={ source.NextAttemptAt } data-calendar-source-error={ source.SyncError } role="img" aria-label={ calendarSourceSyncTitle(source) } title={ calendarSourceSyncTitle(source) } class="absolute inset-0 inline-flex items-center justify-center">
		if loading {
			<span class="calendar-skeleton size-3 rounded bg-sidebar-accent" aria-hidden="true"></span>
		} else {
			<span data-calendar-source-sync-icon="syncing" hidden?={ source.SyncState != "syncing" } class="text-sidebar-primary">@icon.LoaderCircle(icon.Props{Class: "size-3 animate-spin"})
</span>
			<span data-calendar-source-sync-icon="failed" hidden?={ source.SyncState != "failed" } class="text-destructive">@icon.CircleAlert(icon.Props{Class: "size-3"})
</span>
			<span data-calendar-source-sync-icon="ok" hidden?={ source.SyncState != "ok" || source.LastSyncedAt == "" } class="text-emerald-600 dark:text-emerald-400">@icon.Check(icon.Props{Class: "size-3"})
</span>
			<span data-calendar-source-sync-icon="pending" hidden?={ source.SyncState == "syncing" || source.SyncState == "failed" || (source.SyncState == "ok" && source.LastSyncedAt != "") } class="text-sidebar-foreground/45">@icon.Clock3(icon.Props{Class: "size-3"})
</span>
		}
	</span>
}

templ CalendarMainPane(month CalendarMonthData, uiSettings map[string]string) {
	<section id="mail-list" class="flex w-full max-lg:!w-full lg:flex flex-col border-r border-border bg-card h-full min-w-0 overflow-hidden" style={ "width:" + mailListWidthCSS(uiSettingGet(uiSettings, "calendar_list_width", "60%")) } data-list-width-key="calendar_list_width" aria-busy={ strconv.FormatBool(month.Loading) }>
		@CalendarMainContent(month)
	</section>
}

templ CalendarMainContent(month CalendarMonthData) {
	<div id="calendar-main" data-calendar-month={ month.MonthKey } data-calendar-month-label={ month.MonthLabel } data-calendar-today-date={ month.TodayDateKey } data-calendar-view={ month.View } data-calendar-date={ month.DateKey } data-calendar-period={ month.PeriodKey } data-calendar-sync-sources={ month.SyncSourcesJSON } data-calendar-has-sources={ strconv.FormatBool(month.HasSources) } data-calendar-timezone={ month.Month.Location().String() } data-calendar-loading?={ month.Loading } aria-busy={ strconv.FormatBool(month.Loading) } class="relative flex min-h-0 flex-1 flex-col overflow-hidden">
		if month.AutoSync && !month.Loading {
			<div
				class="hidden"
				hx-post="/api/calendar/sync"
				hx-vals={ calendarViewSyncValues(month) }
				hx-trigger="load"
				hx-target="#main-content"
				hx-swap="outerHTML"
				hx-sync="#main-content:drop"
				data-on-htmx-before-request='["handleCalendarSyncStart","$event"]'
				data-on-htmx-after-request='["handleCalendarSyncResult","$event"]'
				data-on-htmx-send-abort='["handleCalendarSyncAbort","$event"]'
				data-calendar-auto-sync
			></div>
		}
		if !month.Loading {
			<div class="hidden" data-calendar-cache-refresh hx-get={ calendarViewURL(month.View, month.DateKey) + "&cache=1" } hx-trigger="calendar-cache-refresh" hx-target="#main-content" hx-select="#main-content" hx-swap="outerHTML" hx-sync="#main-content:drop" data-on-htmx-before-request='["configureCalendarCacheRequest","$event"]'></div>
		}
		<header class="flex shrink-0 flex-wrap items-center gap-x-1.5 gap-y-2 border-b border-border px-4 py-4" inert?={ month.Loading }>
			<div class="flex min-w-0 flex-1 items-center gap-1.5">
				@PhoneNavToggle("-ml-1.5", "Open calendars")
				<h1 class="min-w-0 truncate text-lg font-bold tracking-tight">{ month.MonthLabel }</h1>
			</div>
			<div class="flex shrink-0 items-center gap-1.5">
				<a href={ calendarViewURL(month.View, month.TodayDateKey) } hx-get={ calendarViewURL(month.View, month.TodayDateKey) } hx-target="#main-content" hx-select="#main-content" hx-swap="outerHTML" hx-sync="#main-content:replace" hx-push-url={ calendarViewURL(month.View, month.TodayDateKey) } data-calendar-key="today" class="inline-flex h-8 items-center rounded-md border border-border bg-background px-2.5 text-xs font-semibold text-foreground shadow-sm transition-colors hover:bg-accent">Today</a>
				<div class="inline-flex h-8 items-center rounded-md border border-border bg-background shadow-sm">
					<a href={ calendarNavigationURL(month, -1) } hx-get={ calendarNavigationURL(month, -1) } hx-target="#main-content" hx-select="#main-content" hx-swap="outerHTML" hx-sync="#main-content:replace" hx-push-url={ calendarNavigationURL(month, -1) } data-calendar-navigate="-1" data-calendar-key="prev" class="inline-flex h-full w-8 items-center justify-center rounded-l-md text-muted-foreground transition-colors hover:bg-accent hover:text-foreground" aria-label={ calendarNavigationLabel(month, "Previous") }>
						@icon.ChevronLeft(icon.Props{Class: "size-4"})
					</a>
					<a href={ calendarNavigationURL(month, 1) } hx-get={ calendarNavigationURL(month, 1) } hx-target="#main-content" hx-select="#main-content" hx-swap="outerHTML" hx-sync="#main-content:replace" hx-push-url={ calendarNavigationURL(month, 1) } data-calendar-navigate="1" data-calendar-key="next" class="inline-flex h-full w-8 items-center justify-center rounded-r-md border-l border-border text-muted-foreground transition-colors hover:bg-accent hover:text-foreground" aria-label={ calendarNavigationLabel(month, "Next") }>
						@icon.ChevronRight(icon.Props{Class: "size-4"})
					</a>
				</div>
				<button type="button" disabled?={ !month.HasSources } title={ calendarCreateTitle(month.HasSources) } data-calendar-create-trigger data-calendar-key="new" hx-get="/api/calendar/events/new" hx-target="#app-pane-dialogs" hx-swap="innerHTML" hx-sync="#app-pane-dialogs:replace" hx-disabled-elt="this" class="inline-flex size-8 cursor-pointer items-center justify-center rounded-md bg-primary text-primary-foreground transition-colors hover:bg-primary/90 disabled:cursor-wait disabled:opacity-50 lg:hidden" aria-label="New event" aria-haspopup="dialog" aria-controls="calendar-create-dialog">
					@icon.Plus(icon.Props{Class: "size-4"})
				</button>
			</div>
			<div class="flex shrink-0 items-center gap-1.5 max-lg:order-last max-lg:basis-full max-lg:justify-between">
				<nav aria-label="Calendar view" class="relative grid h-8 w-64 grid-cols-4 gap-0.5 rounded-lg border border-border bg-background p-0.5" data-calendar-view-nav>
					<div data-calendar-view-indicator aria-hidden="true" class="absolute top-0.5 bottom-0.5 left-0.5 rounded-md border border-border bg-card shadow-sm transition-transform duration-200 ease-out motion-reduce:transition-none" style={ calendarViewIndicatorStyle(month.View) }></div>
					for _, view := range calendarViews {
						<a href={ calendarViewURL(view, month.DateKey) } hx-get={ calendarViewURL(view, month.DateKey) } hx-target="#main-content" hx-select="#main-content" hx-swap="outerHTML" hx-sync="#main-content:replace" hx-push-url={ calendarViewURL(view, month.DateKey) } class={ calendarViewSwitchClass(month.View == view) } aria-current={ calendarViewCurrent(month.View == view) } data-calendar-view-switch={ view } data-calendar-key={ view }>{ calendarViewLabel(view) }</a>
					}
				</nav>
				<button type="button" data-calendar-agenda-toggle data-calendar-key="agenda" class="inline-flex h-8 items-center gap-1.5 rounded-md border border-border bg-background px-2.5 text-xs font-semibold text-foreground shadow-sm transition-colors hover:bg-accent focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring lg:hidden">
					@icon.List(icon.Props{Class: "size-3.5"})
					Agenda
				</button>
			</div>
		</header>
		if calendarTimelineDays(month.View) > 0 {
			<div class="flex shrink-0 flex-wrap items-center justify-between gap-2 border-b border-border bg-muted/10 px-4 py-2 sm:px-5" inert?={ month.Loading } hidden?={ !month.HasSources && !month.Loading }>
				<p data-calendar-week-scale-status class="text-xs text-muted-foreground" aria-live="polite">Fit · Empty hours condensed</p>
				<div class="inline-flex items-center gap-1" role="group" aria-label="Week timeline zoom">
					<button type="button" data-calendar-week-zoom="fit" aria-pressed="true" class="inline-flex h-7 items-center rounded-md border border-border bg-accent px-2.5 text-xs font-semibold transition-colors hover:bg-accent focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring">Fit</button>
					<div class="inline-flex overflow-hidden rounded-md border border-border bg-background shadow-sm">
						<button type="button" data-calendar-week-zoom="out" disabled class="inline-flex size-7 items-center justify-center text-muted-foreground transition-colors hover:bg-accent hover:text-foreground focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-inset focus-visible:ring-ring disabled:opacity-35" aria-label="Zoom out week timeline">
							@icon.Minus(icon.Props{Class: "size-3.5"})
						</button>
						<button type="button" data-calendar-week-zoom="in" class="inline-flex size-7 items-center justify-center border-l border-border text-muted-foreground transition-colors hover:bg-accent hover:text-foreground focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-inset focus-visible:ring-ring disabled:opacity-35" aria-label="Zoom in week timeline">
							@icon.Plus(icon.Props{Class: "size-3.5"})
						</button>
					</div>
				</div>
			</div>
		}
		if !month.HasSources && !month.Loading {
			@CalendarConnectEmpty()
		}
		<div class={ "min-h-0 flex-1 overflow-auto", templ.KV("flex flex-col p-3 sm:p-5", calendarTimelineDays(month.View) == 0) } data-calendar-surface data-calendar-week-scroll?={ calendarTimelineDays(month.View) > 0 } inert?={ month.Loading } hidden?={ !month.HasSources && !month.Loading }>
			if calendarTimelineDays(month.View) > 0 {
				@CalendarWeekGrid(month)
			} else {
				<div class="flex min-h-0 flex-1 flex-col overflow-hidden rounded-xl border border-border bg-background shadow-[0_1px_2px_rgba(0,0,0,0.04)]" data-calendar-month-grid>
					<div class="grid shrink-0 grid-cols-7 border-b border-border bg-muted/35">
						for index := 0; index < 7; index++ {
							<div class="px-2 py-2 text-center text-[11px] font-bold uppercase tracking-[0.14em] text-muted-foreground sm:px-3 sm:text-[11px]">{ calendarWeekdayLabel(index) }</div>
						}
					</div>
					<div class="grid min-h-0 flex-1 grid-cols-7" style={ "grid-template-rows:repeat(" + strconv.Itoa(len(month.Weeks)) + ",minmax(0,1fr));" }>
						for _, week := range month.Weeks {
							for dayIndex, day := range week.Days {
								{{ dayEvents := calendarEventsForDay(day, month.Events)
visibleEvents := calendarVisibleEventCount(dayEvents) }}
								<div class={ calendarDayClass(day) } data-calendar-day={ day.ISODate } data-calendar-week-start={ week.Days[0].ISODate } data-calendar-day-event-count={ strconv.Itoa(visibleEvents) } data-calendar-day-selected="false" data-calendar-day-start={ day.Date.Format(time.RFC3339) } data-calendar-day-end={ day.Date.AddDate(0, 0, 1).Format(time.RFC3339) } data-calendar-day-title={ day.Date.Format("Monday, January 2") } aria-label={ calendarDayLabel(day) }>
									<button type="button" disabled?={ month.Loading } data-calendar-select-day={ day.ISODate } aria-label={ "Show events for " + day.Date.Format("Monday, January 2, 2006") } aria-pressed="false" aria-controls="calendar-agenda-list" class="absolute inset-0 rounded-none focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-inset focus-visible:ring-ring">
										<span class="sr-only">{ day.Date.Format("Monday, January 2, 2006") }</span>
									</button>
									<div class="pointer-events-none relative flex shrink-0 items-start justify-between gap-1">
										<span class={ calendarDayNumberClass(day) }>{ day.DayNumber }</span>
										if day.IsToday {
											<span class="hidden rounded-full bg-primary/10 px-1.5 py-0.5 text-[11px] font-bold uppercase tracking-wide text-primary sm:inline-flex">Today</span>
										}
									</div>
									if !month.Loading && len(dayEvents) > 0 {
										<div hidden?={ visibleEvents == 0 } class="pointer-events-none relative z-10 mt-0.5 flex min-h-0 flex-1 flex-col gap-1 sm:mt-1" data-calendar-month-events>
											<div class="grid min-h-0 grid-cols-1 gap-1" data-calendar-month-event-list>
												for _, candidate := range calendarMonthCandidates(dayEvents) {
													{{ event := candidate.Event
continuesBefore := event.AllDay && event.StartDate < day.ISODate
continuesAfter := event.AllDay && event.EndDate > day.Date.AddDate(0, 0, 1).Format("2006-01-02") }}
													<button type="button" hidden?={ !candidate.Visible } data-calendar-source-id={ event.SourceID } data-calendar-source-hidden={ strconv.FormatBool(event.SourceHidden) } data-calendar-response-state={ calendarEventResponseState(event) } data-calendar-month-event={ event.ID } data-calendar-event-all-day={ strconv.FormatBool(event.AllDay) } data-calendar-event-start-date={ event.StartDate } data-calendar-event-end-date={ event.EndDate } data-calendar-continues-before?={ continuesBefore } data-calendar-continues-after?={ continuesAfter } class="group pointer-events-auto relative flex w-full min-w-0 items-center gap-1.5 truncate rounded bg-primary/[0.06] px-1 py-1 text-left text-[11px] leading-tight text-foreground transition-colors hover:bg-primary/15 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring" title={ calendarEventResponseSummary(event) } aria-label={ "Open event: " + calendarEventResponseSummary(event) } aria-haspopup="dialog" aria-controls="calendar-event-details-content" hx-get={ calendarEventDetailsURL(event.ID) } hx-target="#app-pane-dialogs" hx-swap="innerHTML" hx-sync="#app-pane-dialogs:replace" hx-disabled-elt="this" data-calendar-event-trigger>
														<span class={ "flex min-w-0 flex-1 items-center gap-1", templ.KV("invisible", continuesBefore && dayIndex > 0) } data-calendar-chip-body>
															<span class="size-1.5 shrink-0 rounded-full" style={ calendarEventColorStyle(event) }></span>
															if label := calendarEventTimeLabel(event, day.Date.Location()); label != "" {
																<span class="shrink-0 text-[11px] font-semibold tabular-nums text-primary" data-calendar-chip-time>{ label }</span>
															}
															<span class="min-w-0 flex-1 truncate" data-calendar-event-summary><span data-calendar-event-text>{ calendarEventSummary(event) }</span></span>
															@CalendarEventResponseIndicator(event, true)
														</span>
													</button>
												}
											</div>
											<button type="button" hidden?={ visibleEvents <= 3 } data-calendar-select-day={ day.ISODate } data-calendar-day-overflow aria-label={ "Show all events for " + day.Date.Format("Monday, January 2, 2006") } aria-pressed="false" aria-controls="calendar-agenda-list" class="pointer-events-auto max-w-full shrink-0 self-start truncate rounded px-0.5 py-0.5 text-left text-[11px] font-semibold text-muted-foreground hover:bg-primary/10 hover:text-primary focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring sm:px-1.5 sm:text-[11px]">+{ visibleEvents - 3 } more</button>
										</div>
									}
								</div>
							}
						}
					</div>
				</div>
			}
		</div>
		<footer class="flex shrink-0 flex-wrap items-center justify-between gap-2 px-4 py-2 text-xs text-muted-foreground sm:px-5" data-calendar-layout-footer>
			<div class="flex flex-wrap items-center gap-x-4 gap-y-1" role="group" aria-label="Calendar legend">
				<span class="inline-flex items-center gap-1.5"><span class="size-2 rounded-full bg-primary"></span>Today</span>
				@CalendarEventResponseLegend()
			</div>
			if month.Loading {
				<span class="inline-flex items-center gap-1.5" role="status"><span class="size-2 rounded-full bg-muted"></span>Loading calendar…</span>
			} else {
				<span class={ calendarSyncMessageClass(month) } role="status" aria-live="polite">
					<span data-calendar-sync-dot class={ calendarAgendaStatusDotClass(month) }></span>
					<span data-calendar-sync-status>{ calendarSyncMessage(month) }</span>
				</span>
			}
		</footer>
	</div>
}

templ CalendarAgendaPane(month CalendarMonthData) {
	<section id="mail-view" class="hidden flex-1 min-w-0 flex-col bg-background lg:flex" aria-labelledby="calendar-agenda-heading" data-calendar-agenda aria-busy={ strconv.FormatBool(month.Loading) }>
		<div class="flex min-h-0 flex-1 flex-col">
			<header class="border-b border-border px-5 py-4">
				<div class="flex items-center justify-between gap-3">
					<button type="button" data-calendar-agenda-back class="-ml-1.5 inline-flex h-8 items-center gap-1 rounded-md px-1.5 text-xs font-semibold text-muted-foreground transition-colors hover:text-foreground focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring lg:hidden">
						@icon.ChevronLeft(icon.Props{Class: "size-4"})
						<span>Calendar</span>
					</button>
					<p class="text-[11px] font-bold uppercase tracking-[0.18em] text-muted-foreground max-lg:hidden">Agenda</p>
					<button type="button" data-calendar-agenda-clear hidden class="items-center gap-1 text-xs font-semibold text-muted-foreground transition-colors hover:text-foreground focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring">
						@icon.ChevronLeft(icon.Props{Class: "inline size-3"})
						<span>All events</span>
					</button>
				</div>
				<div class="mt-1 flex items-center justify-between gap-3">
					<h2 id="calendar-agenda-heading" tabindex="-1" class="text-lg font-bold tracking-tight outline-none">All events</h2>
					<span data-calendar-agenda-context class="shrink-0 rounded-full border border-border bg-muted/50 px-2 py-1 text-[11px] font-semibold text-muted-foreground" aria-live="polite">{ month.MonthLabel }</span>
				</div>
			</header>
			{{ agendaEvents := calendarAgendaEvents(month) }}
			if month.Loading {
				<div id="calendar-agenda-list" class="min-h-0 flex-1 overflow-y-auto p-5" aria-hidden="true"></div>
			} else {
				<div data-calendar-agenda-empty hidden?={ len(agendaEvents) > 0 } class="min-h-0 flex-1 overflow-y-auto px-5 py-10 text-center">
					<div class="mx-auto flex size-10 items-center justify-center rounded-full bg-primary/10 text-primary">
						@icon.CalendarDays(icon.Props{Class: "size-5"})
					</div>
					<h3 data-calendar-agenda-empty-title class="mt-3 text-sm font-semibold text-foreground">
						if !month.HasSources {
							No calendars connected
						} else if month.AllSourcesHidden {
							All calendars are hidden
						} else {
							No events
						}
					</h3>
					<p data-calendar-agenda-empty-detail data-calendar-agenda-empty-default={ calendarAgendaEmptyDetail(month.View) } class="mx-auto mt-1 max-w-xs text-xs leading-relaxed text-muted-foreground">
						if !month.HasSources {
							Events appear here once a calendar is connected.
						} else if month.AllSourcesHidden {
							Show a calendar in the sidebar to see its events.
						} else {
							{ calendarAgendaEmptyDetail(month.View) }
						}
					</p>
				</div>
				{{ agenda := calendarAgendaGroups(month) }}
				<div id="calendar-agenda-list" hidden?={ len(agendaEvents) == 0 } class="min-h-0 flex-1 overflow-y-auto px-3 py-4">
					<div class="flex flex-col gap-5">
						for _, day := range agenda.Days {
							<section data-calendar-agenda-day aria-labelledby={ "calendar-agenda-day-" + day.Key }>
								<h3 id={ "calendar-agenda-day-" + day.Key } data-calendar-agenda-day-heading class="px-2 pb-1 text-[11px] font-semibold uppercase tracking-wider text-muted-foreground">{ day.Label }</h3>
								for _, row := range day.Rows {
									{{ event := row.Event }}
									<button type="button" hidden?={ event.SourceHidden } data-calendar-source-id={ event.SourceID } data-calendar-source-hidden={ strconv.FormatBool(event.SourceHidden) } data-calendar-response-state={ calendarEventResponseState(event) } data-calendar-agenda-event data-calendar-event-all-day={ strconv.FormatBool(event.AllDay) } data-calendar-event-start-date={ row.StartDate } data-calendar-event-end-date={ row.EndDate } data-calendar-event-start={ calendarEventTimestamp(event.StartAt) } data-calendar-event-end={ calendarEventTimestamp(event.EndAt) } class="group relative flex w-full items-baseline gap-3 rounded-md px-2 py-1.5 text-left transition-colors hover:bg-accent/50 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring" aria-label={ "Open event: " + calendarAgendaRowLabel(row) } aria-haspopup="dialog" aria-controls="calendar-event-details-content" hx-get={ calendarEventDetailsURL(event.ID) } hx-target="#app-pane-dialogs" hx-swap="innerHTML" hx-sync="#app-pane-dialogs:replace" hx-disabled-elt="this" data-calendar-event-trigger>
										<span data-calendar-agenda-time class="w-[5.5rem] shrink-0 text-xs tabular-nums text-muted-foreground">{ row.TimeLabel }</span>
										<span class="min-w-0 flex-1">
											<span class="flex items-center gap-2">
												<span class="size-2 shrink-0 rounded-full" style={ calendarEventColorStyle(event) }></span>
												<span class="truncate text-sm font-medium text-foreground" data-calendar-event-summary>{ calendarEventSummary(event) }</span>
												if row.SpanLabel != "" {
													<span class="shrink-0 text-xs text-muted-foreground">{ row.SpanLabel }</span>
												}
											</span>
											{{ meta := calendarAgendaMeta(event, agenda.MultiSource) }}
											if meta != "" || calendarAgendaResponseVisible(event) {
												<span class="mt-0.5 flex items-center gap-2 pl-4 text-xs text-muted-foreground">
													@CalendarEventResponseIndicator(event, false)
													if meta != "" {
														<span class="truncate">{ meta }</span>
													}
												</span>
											}
										</span>
									</button>
								}
							</section>
						}
					</div>
				</div>
			}
		</div>
	</section>
}

templ CalendarAppPartial(accounts []models.Account, month CalendarMonthData, uiSettings map[string]string) {
	@CalendarMainPane(month, uiSettings)
	@CalendarSidebarBody(accounts)
	<div id="sidebar-sync-controls">
		@SidebarSyncControls(accounts, "calendar")
	</div>
	@CalendarAgendaPane(month)
	<div id="app-pane-dialogs"></div>
}

templ CalendarMainPartial(month CalendarMonthData) {
	@CalendarMainContent(month)
}

// CalendarConnectEmpty takes the grid's place while no calendar is selected: an empty grid
// with "Nothing is scheduled" read as a working calendar with no events. The grid stays in
// the page, hidden, for the calendar scripts.
templ CalendarConnectEmpty() {
	<div class="flex min-h-0 flex-1 flex-col items-start justify-center px-6 py-12 sm:px-10" data-calendar-connect-empty>
		<div class="max-w-sm">
			@icon.CalendarDays(icon.Props{Class: "size-6 text-muted-foreground mb-4"})
			<h2 class="text-base font-semibold tracking-tight text-foreground mb-2">Connect a calendar</h2>
			<p class="text-sm leading-relaxed text-muted-foreground">Raven shows Google, Outlook and CalDAV calendars, including iCloud. Turn on Calendar for an account, then choose which calendars to show.</p>
			<a href="/settings/accounts" class="mt-6 inline-flex h-9 items-center gap-2 rounded-md bg-primary px-4 text-sm font-medium text-primary-foreground hover:bg-primary/90 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring focus-visible:ring-offset-2">Open account settings</a>
		</div>
	</div>
}
