package views

import (
	"fmt"
	"github.com/cristianadrielbraun/gofer/components/icon"
	"github.com/cristianadrielbraun/gofer/internal/models"
)

// AccountIdentitiesData is the "Sending addresses" section of a settings account card.
type AccountIdentitiesData struct {
	Account     models.Account
	Identities  []models.AccountIdentity
	Suggestions []models.IdentitySuggestion
	// Error is shown inline; htmx does not swap non-2xx responses.
	Error string
}

func accountIdentitiesID(accountID string) string {
	return "account-identities-" + accountID
}

func accountIdentitiesURL(accountID string, parts ...string) string {
	url := fmt.Sprintf("/api/accounts/%s/identities", accountID)
	for _, p := range parts {
		url += "/" + p
	}
	return url
}

func identitySourceBadge(source string) string {
	switch source {
	case models.IdentitySourcePrimary:
		return "Primary"
	case models.IdentitySourceProvider:
		return "From Gmail"
	}
	return "Added by you"
}

// SettingsAccountIdentitiesLoader is the placeholder in the account card; it
// fetches the section once the settings page is shown.
templ SettingsAccountIdentitiesLoader(account models.Account) {
	<div
		id={ accountIdentitiesID(account.ID) }
		data-account-identities-loader
		hx-get={ accountIdentitiesURL(account.ID) }
		hx-trigger="load"
		hx-swap="outerHTML"
		class="mt-4 border-t border-border/60 pt-3"
	>
		<p class="text-[11px] font-semibold uppercase tracking-wider text-muted-foreground">Sending addresses</p>
	</div>
}

templ SettingsAccountIdentities(data AccountIdentitiesData) {
	{{ account := data.Account }}
	<div
		id={ accountIdentitiesID(account.ID) }
		data-account-identities={ account.ID }
		hx-target="this"
		hx-swap="outerHTML"
		class="mt-4 border-t border-border/60 pt-3"
	>
		<div class="mb-2 flex flex-col gap-1 sm:flex-row sm:items-center sm:justify-between">
			<p class="text-[11px] font-semibold uppercase tracking-wider text-muted-foreground">Sending addresses</p>
			if account.Provider == "gmail" {
				<button
					type="button"
					class="inline-flex items-center gap-1 text-[11px] text-muted-foreground transition-colors hover:text-foreground"
					hx-post={ accountIdentitiesURL(account.ID, "refresh") }
					data-identities-refresh
				>
					@icon.RefreshCw(icon.Props{Class: "size-3"})
					Refresh from Gmail
				</button>
			}
		</div>
		if data.Error != "" {
			<p class="mb-2 text-xs text-destructive" role="alert" data-identities-error>{ data.Error }</p>
		}
		<ul class="space-y-1.5" data-identities-list>
			for _, identity := range data.Identities {
				<li class="flex items-center justify-between gap-2 rounded-md border border-border/60 px-2.5 py-1.5" data-identity-id={ fmt.Sprint(identity.ID) } data-identity-source={ identity.Source }>
					<div class="min-w-0">
						<p class="truncate text-xs font-medium text-foreground">
							{ identity.Email }
							if identity.Name != "" {
								<span class="font-normal text-muted-foreground">({ identity.Name })</span>
							}
						</p>
						<p class="mt-0.5 flex items-center gap-1.5 text-[10px] text-muted-foreground">
							<span class="rounded border border-border/70 bg-muted/35 px-1 font-semibold uppercase tracking-wide" data-identity-badge>{ identitySourceBadge(identity.Source) }</span>
							if identity.IsDefault {
								<span class="rounded bg-primary/10 px-1 font-semibold uppercase tracking-wide text-primary" data-identity-default>Default</span>
							}
						</p>
					</div>
					<div class="flex shrink-0 items-center gap-2 text-[11px]">
						if !identity.IsDefault {
							<button type="button" class="text-muted-foreground transition-colors hover:text-foreground" hx-post={ accountIdentitiesURL(account.ID, fmt.Sprint(identity.ID), "default") } data-identity-set-default>
								Set default
							</button>
						}
						if identity.Source != models.IdentitySourcePrimary {
							<button type="button" class="text-muted-foreground transition-colors hover:text-destructive" aria-label={ "Remove " + identity.Email } hx-post={ accountIdentitiesURL(account.ID, fmt.Sprint(identity.ID), "delete") } data-identity-remove>
								@icon.Trash2(icon.Props{Class: "size-3.5"})
							</button>
						}
					</div>
				</li>
			}
		</ul>
		if len(data.Suggestions) > 0 {
			<div class="mt-3" data-identity-suggestions>
				<p class="mb-1 text-[11px] text-muted-foreground">Raven keeps seeing mail sent to these addresses. Add any you can send from.</p>
				<ul class="space-y-1">
					for _, s := range data.Suggestions {
						<li class="flex items-center justify-between gap-2 text-xs" data-identity-suggestion={ s.Email }>
							<span class="min-w-0 truncate text-foreground">{ s.Email } <span class="text-muted-foreground">({ fmt.Sprint(s.Count) } messages)</span></span>
							<span class="flex shrink-0 items-center gap-2 text-[11px]">
								<form hx-post={ accountIdentitiesURL(account.ID) }>
									<input type="hidden" name="email" value={ s.Email }/>
									<button type="submit" class="text-primary hover:underline" data-identity-suggestion-add>Add</button>
								</form>
								<form hx-post={ accountIdentitiesURL(account.ID, "dismiss") }>
									<input type="hidden" name="email" value={ s.Email }/>
									<button type="submit" class="text-muted-foreground hover:text-foreground" data-identity-suggestion-dismiss>Dismiss</button>
								</form>
							</span>
						</li>
					}
				</ul>
			</div>
		}
		<form class="mt-3 flex flex-col gap-2 sm:flex-row" hx-post={ accountIdentitiesURL(account.ID) } data-identity-add-form>
			<input type="email" name="email" required maxlength="254" placeholder="alias@example.com" aria-label="Sending address" class="min-w-0 flex-1 rounded-md border border-input bg-background px-2 py-1 text-xs outline-none focus:ring-2 focus:ring-ring"/>
			<input type="text" name="name" maxlength="100" placeholder="Name (optional)" aria-label="Display name for this address" class="min-w-0 flex-1 rounded-md border border-input bg-background px-2 py-1 text-xs outline-none focus:ring-2 focus:ring-ring"/>
			<button type="submit" class="inline-flex items-center justify-center gap-1 rounded-md border border-border px-2.5 py-1 text-xs font-medium transition-colors hover:bg-accent">
				@icon.Plus(icon.Props{Class: "size-3"})
				Add
			</button>
		</form>
	</div>
}
