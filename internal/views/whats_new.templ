package views

import (
	"github.com/cristianadrielbraun/gofer/components/dialog"
	"github.com/cristianadrielbraun/gofer/internal/whatsnew"
)

const whatsNewReleaseNotesURL = "https://github.com/fahadjibransheikh/raven/releases/latest"

// WhatsNewDialog is fetched and injected by whats-new.js; version is the build version recorded on dismissal.
templ WhatsNewDialog(releases []whatsnew.Release, version string) {
	@dialog.Dialog(dialog.Props{ID: "whats-new-dialog", Attributes: templ.Attributes{"data-whats-new-version": version}}) {
		@dialog.Content(dialog.ContentProps{Class: "sm:max-w-md max-h-[calc(100vh-2rem)]", Attributes: templ.Attributes{"role": "dialog", "aria-labelledby": "whats-new-title", "aria-describedby": "whats-new-desc"}}) {
			<div class="flex max-h-[calc(100vh-5rem)] flex-col gap-4">
				@dialog.Header() {
					@dialog.Title(dialog.TitleProps{ID: "whats-new-title"}) { What's new in Raven }
					@dialog.Description(dialog.DescriptionProps{ID: "whats-new-desc"}) {
						if len(releases) > 0 && releases[0].Hero != "" {
							{ releases[0].Hero }
						} else {
							Recent changes to the app.
						}
					}
				}
				<div class="min-h-0 space-y-5 overflow-y-auto pr-1" tabindex="-1">
					for i, r := range releases {
						<section class={ templ.KV("border-t border-border pt-4", i > 0) } aria-label={ r.Title }>
							<h3 class="text-[15px] font-semibold leading-snug text-foreground">{ r.Title }</h3>
							<p class="mt-0.5 text-xs text-muted-foreground">Version { r.Version } · { r.Date }</p>
							for _, g := range r.Groups {
								<h4 class="mt-3 mb-1 text-xs font-semibold text-muted-foreground">{ g.Name }</h4>
								<ul class="list-disc space-y-1.5 pl-5 text-sm leading-relaxed text-foreground marker:text-muted-foreground">
									for _, item := range g.Items {
										<li>{ item }</li>
									}
								</ul>
							}
						</section>
					}
				</div>
				@dialog.Footer(dialog.FooterProps{Class: "items-center sm:justify-between"}) {
					<a href={ templ.SafeURL(whatsNewReleaseNotesURL) } target="_blank" rel="noopener noreferrer" class="text-sm text-muted-foreground underline-offset-4 hover:text-foreground hover:underline">See full release notes</a>
					<button type="button" autofocus data-tui-dialog-close class="inline-flex h-9 items-center justify-center rounded-md bg-primary px-4 text-sm font-medium text-primary-foreground transition-colors hover:bg-primary/90">Got it</button>
				}
			</div>
		}
	}
}
