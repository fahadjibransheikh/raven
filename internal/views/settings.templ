package views

import (
	"fmt"
	"github.com/fahadjibransheikh/raven/internal/models"
	"strconv"
	"strings"
	"time"

	"github.com/fahadjibransheikh/raven/components/button"
	"github.com/fahadjibransheikh/raven/components/checkbox"
	"github.com/fahadjibransheikh/raven/components/dialog"
	"github.com/fahadjibransheikh/raven/components/dropdown"
	"github.com/fahadjibransheikh/raven/components/icon"
	"github.com/fahadjibransheikh/raven/components/input"
	"github.com/fahadjibransheikh/raven/components/popover"
	"github.com/fahadjibransheikh/raven/components/radio"
	"github.com/fahadjibransheikh/raven/components/selectbox"
	switchcomp "github.com/fahadjibransheikh/raven/components/switch"
	"github.com/fahadjibransheikh/raven/components/tabs"
	"github.com/fahadjibransheikh/raven/components/tooltip"
)

templ SettingsPage(accounts []models.Account, syncSettings models.SyncSettings, activeTab string, uiSettings map[string]string, signatureData []models.AccountSignatureData) {
	<div class="flex-1 flex flex-col min-w-0 overflow-hidden" data-settings-page>
		<div class="flex-1 overflow-y-auto">
			<div id="settings-content" class="max-w-3xl px-8 py-10">
				if activeTab == "security" {
					// This page only renders when Raven runs without sign-in (see SettingsSecurityOpenTab).
					@SettingsSectionHeader("security-open")
				} else {
					@SettingsSectionHeader(activeTab)
				}
				if activeTab == "accounts" {
					@SettingsAccountsTab(accounts)
				} else if activeTab == "sync" {
					@SettingsSyncTab(syncSettings, uiSettings)
				} else if activeTab == "operations" {
					@SettingsOperationsTab()
				} else if activeTab == "contacts" {
					@SettingsContactsTab(accounts, uiSettings)
				} else if activeTab == "appearance" {
					@SettingsAppearanceTab(uiSettings)
				} else if activeTab == "regional" {
					@SettingsRegionalTab(uiSettings)
				} else if activeTab == "compose-display" {
					@SettingsComposeDisplayTab(uiSettings, signatureData)
				} else if activeTab == "security" {
					@SettingsSecurityOpenTab()
				} else if activeTab == "advanced" {
					@SettingsAdvancedTab(uiSettings)
				}
			</div>
		</div>
	</div>
}

// settingsSectionHeading names a settings page and says what it is for.
func settingsSectionHeading(section string) (string, string) {
	switch section {
	case "accounts":
		return "Accounts", "Connect and manage your email and calendar accounts."
	case "sync":
		return "Email sync and folders", "Choose how email syncs and which folders appear in unified views."
	case "operations":
		return "Mail operations", "Track outgoing messages and background mail operations."
	case "contacts":
		return "Contacts", "Manage local contacts and sync contacts from connected accounts."
	case "appearance":
		return "Appearance", "Choose the visual style and color mode for Raven."
	case "regional":
		return "Regional", "Choose the time zone used for message dates and scheduled sends."
	case "compose-display":
		return "Compose and display", "Customize compose windows, message lists, signatures, and translation."
	case "security":
		return "Security", "Manage sign-in methods, active sessions, and security activity."
	case "security-open":
		return "Security", "Choose which mail servers Raven may connect to. Sign-in settings appear only when Raven runs with sign-in."
	case "advanced":
		return "Advanced", "Configure prefetching, notifications, and email link handling."
	default:
		return "Settings", "Manage your accounts and preferences."
	}
}

templ SettingsSectionHeader(section string) {
	{{ title, description := settingsSectionHeading(section) }}
	<div class="mb-6">
		@PhoneNavToggle("-ml-2 mb-2")
		<h2 class="text-2xl font-semibold text-foreground mb-1">{ title }</h2>
		<p class="text-sm text-muted-foreground">{ description }</p>
	</div>
}

templ SettingsComposeDisplayTab(uiSettings map[string]string, signatureData []models.AccountSignatureData) {
	<div class="mt-6 space-y-6">
		<div class="settings-card bg-card rounded-lg border p-6 space-y-5">
			<div>
				<h3 class="text-sm font-semibold text-muted-foreground mb-1">Compose windows</h3>
				<p class="text-xs text-muted-foreground">Choose where compose opens for new messages, replies, and forwards.</p>
			</div>
			<div class="settings-row border-t border-border/60 pt-5 flex flex-col gap-4 sm:flex-row sm:items-center sm:justify-between">
				<div class="min-w-0">
					<h4 class="text-sm font-medium text-foreground">New messages</h4>
					<p class="text-xs text-muted-foreground mt-1">Pick whether new messages start in a dialog, the reading pane, or the full-width composer.</p>
				</div>
				<div class="w-full sm:w-44 shrink-0" data-compose-view-picker>
					@selectbox.SelectBox(selectbox.Props{Class: "settings-select"}) {
						@selectbox.Trigger(selectbox.TriggerProps{Name: "default_new_compose_view", Class: "bg-background", DisableClear: true}) {
							@selectbox.Value(selectbox.ValueProps{Placeholder: "Dialog"}) {
								{ defaultComposeViewSettingLabel(uiSettingGet(uiSettings, "default_new_compose_view", uiSettingGet(uiSettings, "default_compose_view", "dialog"))) }
							}
						}
						@selectbox.Content(selectbox.ContentProps{NoSearch: true}) {
							@selectbox.Item(selectbox.ItemProps{Value: "dialog", Selected: uiSettingGet(uiSettings, "default_new_compose_view", uiSettingGet(uiSettings, "default_compose_view", "dialog")) == "dialog"}) { Dialog }
							@selectbox.Item(selectbox.ItemProps{Value: "pane", Selected: uiSettingGet(uiSettings, "default_new_compose_view", uiSettingGet(uiSettings, "default_compose_view", "dialog")) == "pane"}) { Inline, one pane }
							@selectbox.Item(selectbox.ItemProps{Value: "full", Selected: uiSettingGet(uiSettings, "default_new_compose_view", uiSettingGet(uiSettings, "default_compose_view", "dialog")) == "full"}) { Inline, expanded }
						}
					}
				</div>
			</div>
			<div class="settings-row border-t border-border/60 pt-5 flex flex-col gap-4 sm:flex-row sm:items-center sm:justify-between">
				<div class="min-w-0">
					<h4 class="text-sm font-medium text-foreground">Replies and forwards</h4>
					<p class="text-xs text-muted-foreground mt-1">Choose where replies, reply-all messages, and forwards open.</p>
				</div>
				<div class="w-full sm:w-44 shrink-0" data-compose-view-picker>
					@selectbox.SelectBox(selectbox.Props{Class: "settings-select"}) {
						@selectbox.Trigger(selectbox.TriggerProps{Name: "default_reply_compose_view", Class: "bg-background", DisableClear: true}) {
							@selectbox.Value(selectbox.ValueProps{Placeholder: "Dialog"}) {
								{ defaultComposeViewSettingLabel(uiSettingGet(uiSettings, "default_reply_compose_view", uiSettingGet(uiSettings, "default_compose_view", "dialog"))) }
							}
						}
						@selectbox.Content(selectbox.ContentProps{NoSearch: true}) {
							@selectbox.Item(selectbox.ItemProps{Value: "thread", Selected: uiSettingGet(uiSettings, "default_reply_compose_view", uiSettingGet(uiSettings, "default_compose_view", "dialog")) == "thread"}) { Inline, below the message }
							@selectbox.Item(selectbox.ItemProps{Value: "dialog", Selected: uiSettingGet(uiSettings, "default_reply_compose_view", uiSettingGet(uiSettings, "default_compose_view", "dialog")) == "dialog"}) { Dialog }
							@selectbox.Item(selectbox.ItemProps{Value: "pane", Selected: uiSettingGet(uiSettings, "default_reply_compose_view", uiSettingGet(uiSettings, "default_compose_view", "dialog")) == "pane"}) { Inline, one pane }
							@selectbox.Item(selectbox.ItemProps{Value: "full", Selected: uiSettingGet(uiSettings, "default_reply_compose_view", uiSettingGet(uiSettings, "default_compose_view", "dialog")) == "full"}) { Inline, expanded }
						}
					}
				</div>
			</div>
			<div class="settings-row border-t border-border/60 pt-5 flex flex-col gap-4 sm:flex-row sm:items-center sm:justify-between">
				<div class="min-w-0">
					<h4 class="text-sm font-medium text-foreground">Undo send</h4>
					<p class="text-xs text-muted-foreground mt-1">Hold sent messages this long so you can take them back.</p>
				</div>
				<div class="w-full sm:w-44 shrink-0" data-undo-send-picker>
					@selectbox.SelectBox(selectbox.Props{Class: "settings-select"}) {
						@selectbox.Trigger(selectbox.TriggerProps{Name: "undo_send_seconds", Class: "bg-background", DisableClear: true}) {
							@selectbox.Value(selectbox.ValueProps{Placeholder: "10 seconds"}) {
								{ undoSendSettingLabel(uiSettingGet(uiSettings, "undo_send_seconds", "10")) }
							}
						}
						@selectbox.Content(selectbox.ContentProps{NoSearch: true}) {
							for _, v := range undoSendSettingValues {
								@selectbox.Item(selectbox.ItemProps{Value: v, Selected: uiSettingGet(uiSettings, "undo_send_seconds", "10") == v}) { { undoSendSettingLabel(v) } }
							}
						}
					}
				</div>
			</div>
			<div class="settings-row border-t border-border/60 pt-5 flex flex-col gap-4 sm:flex-row sm:items-start sm:justify-between">
				<div class="min-w-0">
					<span id="compose-autosave-enabled-label" class="text-sm font-medium text-foreground">Autosave drafts</span>
					<p class="text-xs text-muted-foreground mt-1">Save drafts after meaningful compose activity instead of creating drafts for tiny edits.</p>
				</div>
				<div class="w-full sm:w-44 shrink-0 space-y-3" data-compose-autosave-controls>
					<div class="flex items-center justify-between gap-3 rounded-md border border-border/60 bg-background/40 px-3 py-2">
						<span class="text-xs font-medium text-muted-foreground">Enable autosave</span>
						@switchcomp.Switch(switchcomp.Props{
							ID:      "compose-autosave-enabled",
							Name:    "compose_autosave_enabled",
							Checked: uiSettingGet(uiSettings, "compose_autosave_enabled", "true") != "false",
							Attributes: templ.Attributes{"aria-labelledby": "compose-autosave-enabled-label", "data-compose-autosave-setting": "enabled"},
						})
					</div>
					<div data-compose-autosave-dependent>
						<input type="hidden" name="compose_autosave_conditions" value={ uiSettingGet(uiSettings, "compose_autosave_conditions", "chars,attachment") } data-compose-autosave-conditions-value/>
						@dropdown.Dropdown() {
							@dropdown.Trigger() {
								@button.Button(button.Props{Variant: button.VariantOutline, Class: "settings-select select-trigger w-full h-9 justify-between bg-background", Disabled: uiSettingGet(uiSettings, "compose_autosave_enabled", "true") == "false", Attributes: templ.Attributes{"data-compose-autosave-conditions-button": ""}}) {
									<span data-compose-autosave-conditions-label>{ composeAutosaveConditionsLabel(uiSettings) }</span>
									@icon.ChevronDown(icon.Props{Class: "size-4 text-muted-foreground"})
								}
							}
							@dropdown.Content(dropdown.ContentProps{Placement: dropdown.PlacementBottomEnd, Class: "w-64 normal-case tracking-normal", Attributes: templ.Attributes{"data-compose-autosave-conditions-menu": ""}}) {
								@dropdown.Label(dropdown.LabelProps{Class: "text-xs text-muted-foreground"}) { Autosave when }
								<div class="flex items-center gap-2 rounded-sm px-2 py-0.5 text-sm transition-colors duration-150 hover:bg-accent hover:text-accent-foreground" data-compose-autosave-condition-item="chars">
									<span class={ "w-4 shrink-0 text-primary", templ.KV("opacity-0", !uiSettingCSVHas(uiSettings, "compose_autosave_conditions", "chars,attachment", "chars")) } data-compose-autosave-condition-check="chars">@icon.Check(icon.Props{Class: "size-4"})</span>
									<span class="flex-1 text-left">Min characters</span>
									<input type="text" inputmode="numeric" pattern="[0-9]*" value={ uiSettingGet(uiSettings, "compose_autosave_min_chars", "30") } class="h-7 w-14 rounded-md border border-border bg-background px-2 text-xs text-foreground outline-none transition-colors focus:border-ring focus:ring-2 focus:ring-ring/25 disabled:opacity-50" data-compose-autosave-min-chars disabled?={ uiSettingGet(uiSettings, "compose_autosave_enabled", "true") == "false" || !uiSettingCSVHas(uiSettings, "compose_autosave_conditions", "chars,attachment", "chars") }/>
								</div>
								@dropdown.Item(dropdown.ItemProps{PreventClose: true, Class: "gap-2 transition-colors duration-150", Attributes: templ.Attributes{"data-compose-autosave-condition-item": "attachment"}}) {
									<span class={ "w-4 shrink-0 text-primary", templ.KV("opacity-0", !uiSettingCSVHas(uiSettings, "compose_autosave_conditions", "chars,attachment", "attachment")) } data-compose-autosave-condition-check="attachment">@icon.Check(icon.Props{Class: "size-4"})</span>
									<span class="flex-1 text-left">Has attachment</span>
								}
								@dropdown.Item(dropdown.ItemProps{PreventClose: true, Class: "gap-2 transition-colors duration-150", Attributes: templ.Attributes{"data-compose-autosave-condition-item": "to"}}) {
									<span class={ "w-4 shrink-0 text-primary", templ.KV("opacity-0", !uiSettingCSVHas(uiSettings, "compose_autosave_conditions", "chars,attachment", "to")) } data-compose-autosave-condition-check="to">@icon.Check(icon.Props{Class: "size-4"})</span>
									<span class="flex-1 text-left">Has recipient</span>
								}
							}
						}
					</div>
					<div data-compose-autosave-dependent>
						@selectbox.SelectBox(selectbox.Props{Class: "settings-select"}) {
							@selectbox.Trigger(selectbox.TriggerProps{Name: "compose_autosave_debounce", Class: "bg-background", DisableClear: true, Disabled: uiSettingGet(uiSettings, "compose_autosave_enabled", "true") == "false"}) {
								@selectbox.Value(selectbox.ValueProps{Placeholder: "5 seconds"}) {
									{ composeAutosaveDebounceLabel(uiSettingGet(uiSettings, "compose_autosave_debounce", "5")) }
								}
							}
							@selectbox.Content(selectbox.ContentProps{NoSearch: true}) {
								@selectbox.Item(selectbox.ItemProps{Value: "1", Selected: uiSettingGet(uiSettings, "compose_autosave_debounce", "5") == "1"}) { 1 second }
								@selectbox.Item(selectbox.ItemProps{Value: "3", Selected: uiSettingGet(uiSettings, "compose_autosave_debounce", "5") == "3"}) { 3 seconds }
								@selectbox.Item(selectbox.ItemProps{Value: "5", Selected: uiSettingGet(uiSettings, "compose_autosave_debounce", "5") == "5"}) { 5 seconds }
								@selectbox.Item(selectbox.ItemProps{Value: "10", Selected: uiSettingGet(uiSettings, "compose_autosave_debounce", "5") == "10"}) { 10 seconds }
								@selectbox.Item(selectbox.ItemProps{Value: "15", Selected: uiSettingGet(uiSettings, "compose_autosave_debounce", "5") == "15"}) { 15 seconds }
							}
						}
					</div>
				</div>
			</div>
		</div>
		@AccountSignaturesSettings(signatureData)
		<div class="settings-card bg-card rounded-lg border p-6 space-y-5">
			<div>
				<h3 class="text-sm font-semibold text-muted-foreground mb-1">List view</h3>
				<p class="text-xs text-muted-foreground">Control how messages are summarized in the email list.</p>
			</div>
			<div class="settings-row border-t border-border/60 pt-5 flex flex-col gap-4 sm:flex-row sm:items-center sm:justify-between">
				<div class="min-w-0">
					<h4 class="text-sm font-medium text-foreground">Email pane layout</h4>
					<p class="text-xs text-muted-foreground mt-1">Choose whether the message list and reading pane sit beside each other or stack vertically.</p>
				</div>
				<div class="w-full sm:w-44 shrink-0" data-mail-pane-layout-picker>
					@selectbox.SelectBox(selectbox.Props{Class: "settings-select"}) {
						@selectbox.Trigger(selectbox.TriggerProps{Name: "mail_pane_layout", Class: "bg-background", DisableClear: true}) {
							@selectbox.Value(selectbox.ValueProps{Placeholder: "Side by side"}) {
								{ mailPaneLayoutSettingLabel(uiSettingGet(uiSettings, "mail_pane_layout", "side")) }
							}
						}
						@selectbox.Content(selectbox.ContentProps{NoSearch: true}) {
							@selectbox.Item(selectbox.ItemProps{Value: "side", Selected: mailPaneLayout(uiSettingGet(uiSettings, "mail_pane_layout", "side")) == "side"}) { Side by side }
							@selectbox.Item(selectbox.ItemProps{Value: "stacked", Selected: mailPaneLayout(uiSettingGet(uiSettings, "mail_pane_layout", "side")) == "stacked"}) { Stacked }
						}
					}
				</div>
			</div>
			<div class="settings-row border-t border-border/60 pt-5 flex flex-col gap-4 sm:flex-row sm:items-center sm:justify-between">
				<div class="min-w-0">
					<h4 class="text-sm font-medium text-foreground">List navigation</h4>
					<p class="text-xs text-muted-foreground mt-1">Choose infinite scroll with edge loading, or page through messages with previous and next controls.</p>
				</div>
				<div class="w-full sm:w-44 shrink-0" data-mail-list-navigation-picker>
					@selectbox.SelectBox(selectbox.Props{Class: "settings-select"}) {
						@selectbox.Trigger(selectbox.TriggerProps{Name: "mail_list_navigation", Class: "bg-background", DisableClear: true}) {
							@selectbox.Value(selectbox.ValueProps{Placeholder: "Infinite scroll"}) {
								{ mailListNavigationSettingLabel(uiSettingGet(uiSettings, "mail_list_navigation", "infinite")) }
							}
						}
						@selectbox.Content(selectbox.ContentProps{NoSearch: true}) {
							@selectbox.Item(selectbox.ItemProps{Value: "infinite", Selected: uiSettingGet(uiSettings, "mail_list_navigation", "infinite") != "pagination"}) { Infinite scroll }
							@selectbox.Item(selectbox.ItemProps{Value: "pagination", Selected: uiSettingGet(uiSettings, "mail_list_navigation", "infinite") == "pagination"}) { Pagination }
						}
					}
				</div>
			</div>
			<div class="settings-row border-t border-border/60 pt-5 flex flex-col gap-4 sm:flex-row sm:items-center sm:justify-between">
				<div class="min-w-0">
					<h4 class="text-sm font-medium text-foreground">Sender display</h4>
					<p class="text-xs text-muted-foreground mt-1">Choose what appears in the From row. Messages without a sender name will still fall back to the email address.</p>
				</div>
				<div class="w-full sm:w-44 shrink-0" data-sender-display-picker>
					@selectbox.SelectBox(selectbox.Props{Class: "settings-select"}) {
						@selectbox.Trigger(selectbox.TriggerProps{Name: "sender_display", Class: "bg-background", DisableClear: true}) {
							@selectbox.Value(selectbox.ValueProps{Placeholder: "Only name"}) {
								{ senderDisplaySettingLabel(uiSettingGet(uiSettings, "sender_display", "name")) }
							}
						}
						@selectbox.Content(selectbox.ContentProps{NoSearch: true}) {
							@selectbox.Item(selectbox.ItemProps{Value: "name", Selected: uiSettingGet(uiSettings, "sender_display", "name") == "name"}) { Only name }
							@selectbox.Item(selectbox.ItemProps{Value: "email", Selected: uiSettingGet(uiSettings, "sender_display", "name") == "email"}) { Only email }
							@selectbox.Item(selectbox.ItemProps{Value: "both", Selected: uiSettingGet(uiSettings, "sender_display", "name") == "both"}) { Name and email }
						}
					}
				</div>
			</div>
			<div class="flex flex-col gap-4 sm:flex-row sm:items-center sm:justify-between">
				<div class="min-w-0">
					<h4 class="text-sm font-medium text-foreground">Conversation order</h4>
					<p class="text-xs text-muted-foreground mt-1">Choose which end of a conversation is shown first. Newest first opens at the latest message; oldest first scrolls to the latest message, or the oldest unread one.</p>
				</div>
				<div class="w-full sm:w-44 shrink-0" data-thread-order-picker>
					@selectbox.SelectBox(selectbox.Props{Class: "settings-select"}) {
						@selectbox.Trigger(selectbox.TriggerProps{Name: "thread_order", Class: "bg-background", DisableClear: true}) {
							@selectbox.Value(selectbox.ValueProps{Placeholder: "Newest first"}) {
								{ threadOrderSettingLabel(uiSettingGet(uiSettings, "thread_order", "newest_first")) }
							}
						}
						@selectbox.Content(selectbox.ContentProps{NoSearch: true}) {
							@selectbox.Item(selectbox.ItemProps{Value: "newest_first", Selected: ThreadNewestFirst(uiSettings)}) { Newest first }
							@selectbox.Item(selectbox.ItemProps{Value: "oldest_first", Selected: !ThreadNewestFirst(uiSettings)}) { Oldest first }
						}
					}
				</div>
			</div>
			<div class="settings-row border-t border-border/60 pt-5 flex flex-col gap-4 sm:flex-row sm:items-center sm:justify-between">
				<div class="min-w-0">
					<h4 class="text-sm font-medium text-foreground">Automatically mark email read after</h4>
					<p class="text-xs text-muted-foreground mt-1">Choose how long a message must stay open before it is marked as read.</p>
				</div>
				<div class="w-full sm:w-44 shrink-0" data-auto-mark-read-picker>
					@selectbox.SelectBox(selectbox.Props{Class: "settings-select"}) {
						@selectbox.Trigger(selectbox.TriggerProps{Name: "auto_mark_read_after", Class: "bg-background", DisableClear: true}) {
							@selectbox.Value(selectbox.ValueProps{Placeholder: "Immediately"}) {
								{ autoMarkReadSettingLabel(uiSettingGet(uiSettings, "auto_mark_read_after", "0")) }
							}
						}
						@selectbox.Content(selectbox.ContentProps{NoSearch: true}) {
							@selectbox.Item(selectbox.ItemProps{Value: "0", Selected: uiSettingGet(uiSettings, "auto_mark_read_after", "0") == "0"}) { Immediately }
							@selectbox.Item(selectbox.ItemProps{Value: "2", Selected: uiSettingGet(uiSettings, "auto_mark_read_after", "0") == "2"}) { After 2 seconds }
							@selectbox.Item(selectbox.ItemProps{Value: "5", Selected: uiSettingGet(uiSettings, "auto_mark_read_after", "0") == "5"}) { After 5 seconds }
							@selectbox.Item(selectbox.ItemProps{Value: "10", Selected: uiSettingGet(uiSettings, "auto_mark_read_after", "0") == "10"}) { After 10 seconds }
							@selectbox.Item(selectbox.ItemProps{Value: "never", Selected: uiSettingGet(uiSettings, "auto_mark_read_after", "0") == "never"}) { Never }
						}
					}
				</div>
			</div>
			<div class="settings-row border-t border-border/60 pt-5 flex flex-col gap-4 sm:flex-row sm:items-start sm:justify-between">
				<div class="min-w-0">
					<span id="open-next-after-remove-label" class="text-sm font-medium text-foreground">Open next email after archive, delete, or spam</span>
					<p class="text-xs text-muted-foreground mt-1">Show the next email in the list when you archive, delete, or mark as spam the one you are reading. Turn off to leave the reading pane empty.</p>
				</div>
				<div class="w-full sm:w-44 shrink-0">
					<div class="flex items-center justify-between gap-3 rounded-md border border-border/60 bg-background/40 px-3 py-2">
						<span class="text-xs font-medium text-muted-foreground">Enabled</span>
						@switchcomp.Switch(switchcomp.Props{
							ID:      "open-next-after-remove",
							Name:    "open_next_after_remove",
							Checked: uiSettingGet(uiSettings, "open_next_after_remove", "true") != "false",
							Attributes: templ.Attributes{"aria-labelledby": "open-next-after-remove-label", "data-open-next-after-remove-setting": ""},
						})
					</div>
				</div>
			</div>
			<div class="flex flex-col gap-4 sm:flex-row sm:items-start sm:justify-between">
				<div class="min-w-0">
					<span id="load-remote-images-label" class="text-sm font-medium text-foreground">Load remote images automatically</span>
					<p class="text-xs text-muted-foreground mt-1">Show images that emails load from the internet. Loading them tells senders when you open an email and shares your IP address. Turn off to choose per email or per sender.</p>
				</div>
				<div class="w-full sm:w-44 shrink-0">
					<div class="flex items-center justify-between gap-3 rounded-md border border-border/60 bg-background/40 px-3 py-2">
						<span class="text-xs font-medium text-muted-foreground">Enabled</span>
						@switchcomp.Switch(switchcomp.Props{
							ID:      "load-remote-images",
							Name:    "load_remote_images",
							Checked: uiSettingGet(uiSettings, "load_remote_images", "false") == "true",
							Attributes: templ.Attributes{"aria-labelledby": "load-remote-images-label", "data-load-remote-images-setting": ""},
						})
					</div>
				</div>
			</div>
		</div>
		<div class="settings-card bg-card rounded-lg border p-6 space-y-5">
			<div>
				<h3 class="text-sm font-semibold text-muted-foreground mb-1">Translation</h3>
				<p class="text-xs text-muted-foreground">Choose the read-pane translation service and default target language.</p>
			</div>
			<div class="flex flex-col gap-4 sm:flex-row sm:items-start sm:justify-between">
				<div class="min-w-0">
					<span id="translation-button-enabled-label" class="text-sm font-medium text-foreground">Read-pane translate button</span>
					<p class="text-xs text-muted-foreground mt-1">Show a translate action beside message bodies.</p>
				</div>
				<div class="w-full sm:w-44 shrink-0">
					<div class="flex items-center justify-between gap-3 rounded-md border border-border/60 bg-background/40 px-3 py-2">
						<span class="text-xs font-medium text-muted-foreground">Enabled</span>
						@switchcomp.Switch(switchcomp.Props{
							ID:      "translation-button-enabled",
							Name:    "translation_button_enabled",
							Checked: uiSettingGet(uiSettings, "translation_button_enabled", "true") != "false",
							Attributes: templ.Attributes{"aria-labelledby": "translation-button-enabled-label", "data-translation-setting": "enabled"},
						})
					</div>
				</div>
			</div>
			<div class="settings-row border-t border-border/60 pt-5 flex flex-col gap-4 sm:flex-row sm:items-center sm:justify-between">
				<div class="min-w-0">
					<h4 class="text-sm font-medium text-foreground">Translation service</h4>
					<p class="text-xs text-muted-foreground mt-1">Choose which service translates messages when you click Translate.</p>
				</div>
				<div class="w-full sm:w-64 shrink-0" data-translation-provider-picker>
					@selectbox.SelectBox(selectbox.Props{Class: "settings-select"}) {
						@selectbox.Trigger(selectbox.TriggerProps{Name: "translation_provider", Class: "bg-background", DisableClear: true}) {
							@selectbox.Value(selectbox.ValueProps{Placeholder: "Google Web Translate (Basic)"}) {
								{ translationProviderSettingLabel(uiSettingGet(uiSettings, "translation_provider", "google_web_basic")) }
							}
						}
						@selectbox.Content(selectbox.ContentProps{NoSearch: true}) {
							@selectbox.Item(selectbox.ItemProps{Value: "google_web_basic", Selected: translationProviderSettingValue(uiSettingGet(uiSettings, "translation_provider", "google_web_basic")) == "google_web_basic", Class: "items-start py-2 pr-8"}) {
								<span class="flex min-w-0 flex-col whitespace-normal">
									<span class="font-medium leading-tight">Google Web Translate (Basic)</span>
									<span class="mt-0.5 text-xs leading-snug text-muted-foreground group-hover:text-accent-foreground/75">Best-effort translation using Google's web translation endpoint.</span>
								</span>
							}
						}
					}
				</div>
			</div>
			<div class="settings-row border-t border-border/60 pt-5 flex flex-col gap-4 sm:flex-row sm:items-center sm:justify-between">
				<div class="min-w-0">
					<h4 class="text-sm font-medium text-foreground">Translate to</h4>
					<p class="text-xs text-muted-foreground mt-1">The default target language for the read-pane button.</p>
				</div>
				<div class="w-full sm:w-44 shrink-0" data-translation-language-picker>
					@selectbox.SelectBox(selectbox.Props{Class: "settings-select"}) {
						@selectbox.Trigger(selectbox.TriggerProps{Name: "translation_target_language", Class: "bg-background", DisableClear: true}) {
							@selectbox.Value(selectbox.ValueProps{Placeholder: "English"}) {
								{ translationLanguageSettingLabel(uiSettingGet(uiSettings, "translation_target_language", "en")) }
							}
						}
						@selectbox.Content(selectbox.ContentProps{SearchPlaceholder: "Search languages..."}) {
							for _, language := range translationLanguageOptions() {
								@selectbox.Item(selectbox.ItemProps{Value: language.Value, Selected: uiSettingGet(uiSettings, "translation_target_language", "en") == language.Value}) { { language.Label } }
							}
						}
					}
				</div>
			</div>
		</div>
	</div>
}

templ SettingsAppearanceTab(uiSettings map[string]string) {
		<div class="mt-6 space-y-6">
			<div class="settings-card bg-card rounded-lg border p-6 space-y-6">
				<div class="flex flex-col gap-4 sm:flex-row sm:items-start sm:justify-between">
					<div>
						<h3 class="text-sm font-semibold text-foreground mb-1">Accent</h3>
						<p class="text-xs text-muted-foreground">Choose the accent used for buttons, the unread dot and links. The layout is the same for every choice.</p>
					</div>
					<div class="space-y-1 sm:text-right" data-mode-picker>
						<h4 class="text-sm font-semibold text-foreground">Color mode</h4>
						<div class="inline-flex rounded-lg border border-border bg-background p-0.5 gap-0.5">
							<button
								type="button"
								data-mode="light"
								class={
									"inline-flex items-center gap-1.5 px-3 py-1.5 rounded-md text-xs font-medium transition-all duration-200",
									templ.KV("bg-background text-foreground shadow-sm", uiSettingGet(uiSettings, "theme", "dark") == "light"),
									templ.KV("text-muted-foreground hover:text-foreground", uiSettingGet(uiSettings, "theme", "dark") != "light"),
								}
							>
								<svg class="size-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="4"/><path d="M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M6.34 17.66l-1.41 1.41M19.07 4.93l-1.41 1.41"/></svg>
								Light
							</button>
							<button
								type="button"
								data-mode="dark"
								class={
									"inline-flex items-center gap-1.5 px-3 py-1.5 rounded-md text-xs font-medium transition-all duration-200",
									templ.KV("bg-background text-foreground shadow-sm", uiSettingGet(uiSettings, "theme", "dark") == "dark"),
									templ.KV("text-muted-foreground hover:text-foreground", uiSettingGet(uiSettings, "theme", "dark") != "dark"),
								}
							>
								<svg class="size-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path d="M20.985 12.486a9 9 0 1 1-9.473-9.472c.405-.022.617.46.402.803a6 6 0 0 0 8.268 8.268c.344-.215.825-.004.803.401"/></svg>
								Dark
							</button>
						</div>
					</div>
				</div>
				<div class="grid grid-cols-1 sm:grid-cols-3 gap-3 max-w-2xl" data-theme-picker>
					<label class="relative flex items-center gap-3 rounded-lg border p-3 cursor-pointer transition-colors hover:bg-row-hover border-border has-[:checked]:border-primary has-[:checked]:ring-2 has-[:checked]:ring-primary/20">
						@radio.Radio(radio.Props{Name: "theme_style", Value: "raven", Checked: uiSettingGet(uiSettings, "theme_style", "raven") == "raven", Class: "absolute right-3 top-3 z-10"})
						<span data-theme="raven" data-theme-preview class={ "size-8 shrink-0 rounded-full border", templ.KV("dark", uiSettingGet(uiSettings, "theme", "dark") == "dark") } style="background:var(--primary)"></span>
						<span class="flex flex-col">
							<span class="text-sm font-medium text-foreground leading-tight">Raven pink</span>
							<span class="text-xs text-muted-foreground">The default accent</span>
						</span>
					</label>
					<label class="relative flex items-center gap-3 rounded-lg border p-3 cursor-pointer transition-colors hover:bg-row-hover border-border has-[:checked]:border-primary has-[:checked]:ring-2 has-[:checked]:ring-primary/20">
						@radio.Radio(radio.Props{Name: "theme_style", Value: "classic", Checked: uiSettingGet(uiSettings, "theme_style", "raven") == "classic", Class: "absolute right-3 top-3 z-10"})
						<span data-theme="classic" data-theme-preview class={ "size-8 shrink-0 rounded-full border", templ.KV("dark", uiSettingGet(uiSettings, "theme", "dark") == "dark") } style="background:var(--primary)"></span>
						<span class="flex flex-col">
							<span class="text-sm font-medium text-foreground leading-tight">Copper</span>
							<span class="text-xs text-muted-foreground">Warm and earthy</span>
						</span>
					</label>
					<label class="relative flex items-center gap-3 rounded-lg border p-3 cursor-pointer transition-colors hover:bg-row-hover border-border has-[:checked]:border-primary has-[:checked]:ring-2 has-[:checked]:ring-primary/20">
						@radio.Radio(radio.Props{Name: "theme_style", Value: "minimal", Checked: uiSettingGet(uiSettings, "theme_style", "raven") == "minimal", Class: "absolute right-3 top-3 z-10"})
						<span data-theme="minimal" data-theme-preview class={ "size-8 shrink-0 rounded-full border", templ.KV("dark", uiSettingGet(uiSettings, "theme", "dark") == "dark") } style="background:var(--primary)"></span>
						<span class="flex flex-col">
							<span class="text-sm font-medium text-foreground leading-tight">Mono</span>
							<span class="text-xs text-muted-foreground">Black and white</span>
						</span>
					</label>
				</div>
			</div>
			<div class="settings-card bg-card rounded-lg border p-6 space-y-6">
				<div>
					<h3 class="text-sm font-semibold text-foreground mb-1">App icon</h3>
					<p class="text-xs text-muted-foreground">Each style has a light and a dark version; Raven shows the one that matches the color mode.</p>
				</div>
				<div class="grid grid-cols-1 sm:grid-cols-3 gap-3 max-w-2xl" data-app-icon-picker>
					<label class="relative flex items-center gap-3 rounded-lg border p-3 cursor-pointer transition-colors hover:bg-row-hover border-border has-[:checked]:border-primary has-[:checked]:ring-2 has-[:checked]:ring-primary/20">
						@radio.Radio(radio.Props{Name: "app_icon", Value: "raven", Checked: appIconStyle(uiSettings) == "raven", Class: "absolute right-3 top-3 z-10"})
						<img src={ appIconSrc("raven", true) } alt="" class="hidden size-12 shrink-0 rounded-xl dark:block"/>
						<img src={ appIconSrc("raven", false) } alt="" class="size-12 shrink-0 rounded-xl dark:hidden"/>
						<span class="flex flex-col pr-6">
							<span class="text-sm font-medium text-foreground leading-tight">Raven</span>
						</span>
					</label>
					<label class="relative flex items-center gap-3 rounded-lg border p-3 cursor-pointer transition-colors hover:bg-row-hover border-border has-[:checked]:border-primary has-[:checked]:ring-2 has-[:checked]:ring-primary/20">
						@radio.Radio(radio.Props{Name: "app_icon", Value: "classic", Checked: appIconStyle(uiSettings) == "classic", Class: "absolute right-3 top-3 z-10"})
						<img src={ appIconSrc("classic", true) } alt="" class="hidden size-12 shrink-0 rounded-xl dark:block"/>
						<img src={ appIconSrc("classic", false) } alt="" class="size-12 shrink-0 rounded-xl dark:hidden"/>
						<span class="flex flex-col pr-6">
							<span class="text-sm font-medium text-foreground leading-tight">Classic</span>
						</span>
					</label>
					<label class="relative flex items-center gap-3 rounded-lg border p-3 cursor-pointer transition-colors hover:bg-row-hover border-border has-[:checked]:border-primary has-[:checked]:ring-2 has-[:checked]:ring-primary/20">
						@radio.Radio(radio.Props{Name: "app_icon", Value: "minimal", Checked: appIconStyle(uiSettings) == "minimal", Class: "absolute right-3 top-3 z-10"})
						<img src={ appIconSrc("minimal", true) } alt="" class="hidden size-12 shrink-0 rounded-xl dark:block"/>
						<img src={ appIconSrc("minimal", false) } alt="" class="size-12 shrink-0 rounded-xl dark:hidden"/>
						<span class="flex flex-col pr-6">
							<span class="text-sm font-medium text-foreground leading-tight">Minimal</span>
						</span>
					</label>
				</div>
				<p class="text-xs text-muted-foreground">The browser tab and the Dock icon change while Raven is running. A phone home-screen icon uses the style chosen when it was added. Finder keeps the default.</p>
			</div>
			<div class="settings-card bg-card rounded-lg border p-6 space-y-6">
				<div>
					<h3 class="text-sm font-semibold text-foreground mb-1">List density</h3>
					<p class="text-xs text-muted-foreground">How much of each message the list shows. Applies to the card view; the table view is unchanged.</p>
				</div>
				<div class="grid grid-cols-1 sm:grid-cols-2 gap-3 max-w-2xl" data-density-picker>
					<label class="relative flex items-center gap-3 rounded-lg border p-3 cursor-pointer transition-colors hover:bg-row-hover border-border has-[:checked]:border-primary has-[:checked]:ring-2 has-[:checked]:ring-primary/20">
						@radio.Radio(radio.Props{Name: "mail_list_density", Value: "calm", Checked: mailListDensity(uiSettings) == "calm", Class: "absolute right-3 top-3 z-10"})
						<span class="flex flex-col pr-6">
							<span class="text-sm font-medium text-foreground leading-tight">Calm</span>
							<span class="text-xs text-muted-foreground">Two lines, more on screen</span>
						</span>
					</label>
					<label class="relative flex items-center gap-3 rounded-lg border p-3 cursor-pointer transition-colors hover:bg-row-hover border-border has-[:checked]:border-primary has-[:checked]:ring-2 has-[:checked]:ring-primary/20">
						@radio.Radio(radio.Props{Name: "mail_list_density", Value: "airy", Checked: mailListDensity(uiSettings) == "airy", Class: "absolute right-3 top-3 z-10"})
						<span class="flex flex-col pr-6">
							<span class="text-sm font-medium text-foreground leading-tight">Airy</span>
							<span class="text-xs text-muted-foreground">Roomier rows</span>
						</span>
					</label>
				</div>
			</div>
		</div>
}

templ SettingsRegionalTab(uiSettings map[string]string) {
	<div class="mt-6 space-y-6">
		<div class="settings-card bg-card rounded-lg border p-6 space-y-5">
			<div>
				<h3 class="text-sm font-semibold text-muted-foreground mb-1">Regional</h3>
				<p class="text-xs text-muted-foreground">Set locale preferences for dates, times, and future language options.</p>
			</div>
			<div class="settings-row border-t border-border/60 pt-5 flex flex-col gap-4 sm:flex-row sm:items-center sm:justify-between">
				<div class="min-w-0">
					<h4 class="text-sm font-medium text-foreground">Timezone</h4>
					<p class="text-xs text-muted-foreground mt-1">Used for email timestamps, scheduled sends, and date labels across Raven.</p>
				</div>
				<div class="w-full shrink-0 sm:w-64" data-timezone-picker data-current-timezone={ uiSettingGet(uiSettings, "timezone", "local") }>
					@selectbox.SelectBox(selectbox.Props{Class: "settings-select"}) {
						@selectbox.Trigger(selectbox.TriggerProps{Name: "timezone", Class: "bg-background", DisableClear: true, Attributes: templ.Attributes{"data-timezone-input": ""}}) {
							@selectbox.Value() {
								{ uiSettingGet(uiSettings, "timezone", "Detecting...") }
							}
						}
						@selectbox.Content(selectbox.ContentProps{SearchPlaceholder: "Search timezones...", Class: "w-72", Attributes: templ.Attributes{"data-timezone-options": ""}}) {
							@selectbox.Group() {
								@selectbox.Item(selectbox.ItemProps{Value: uiSettingGet(uiSettings, "timezone", "local"), Disabled: true}) { Loading timezones... }
							}
						}
					}
				</div>
			</div>
		</div>
	</div>
}

// SettingsSecurityOpenTab is the Security tab when Raven runs without a login
// (local/desktop mode): there is no account to protect with a password.
templ SettingsSecurityOpenTab() {
	<div class="mt-6 space-y-6" data-settings-security-open>
		<div class="bg-card rounded-lg border p-6 space-y-2">
			<h3 class="text-sm font-semibold text-muted-foreground">Security</h3>
			<h4 class="text-sm font-medium text-foreground">Login is off</h4>
			<p class="text-xs text-muted-foreground">Raven is running without a login, so there is no password, authenticator or passkey to manage. Anyone who can reach this Raven can read its mail, so keep it on a device only you use.</p>
			<p class="text-xs text-muted-foreground">To require a login, run Raven as a server with authentication enabled. Sign-in settings appear only when Raven runs with sign-in.</p>
		</div>
	</div>
}

templ SettingsAdvancedTab(uiSettings map[string]string) {
	<div class="mt-6 space-y-6">
		<div class="settings-card bg-card rounded-lg border p-6 space-y-5">
			<div>
				<h3 class="text-sm font-semibold text-muted-foreground mb-1">Advanced</h3>
				<p class="text-xs text-muted-foreground">Tune behavior that affects performance and network usage.</p>
			</div>
			<div class="settings-row border-t border-border/60 pt-5 flex items-start justify-between gap-6">
				<div class="min-w-0">
					<span id="prefetch-on-hover-label" class="text-sm font-medium text-foreground">Pre-fetch on hover</span>
					<p class="text-xs text-muted-foreground mt-1 leading-relaxed">Start loading an email body when you hover or focus a message in the list, so opening it often feels faster. This can significantly increase network usage. Disable it to fetch bodies only when you click an email.</p>
				</div>
				@switchcomp.Switch(switchcomp.Props{
					ID:      "prefetch-on-hover",
					Name:    "prefetch_on_hover",
					Checked: uiSettingGet(uiSettings, "prefetch_on_hover", "true") != "false",
					Attributes: templ.Attributes{"aria-labelledby": "prefetch-on-hover-label", "data-ui-setting-switch": "prefetch_on_hover"},
				})
			</div>
			<div class="settings-row border-t border-border/60 pt-5 flex items-start justify-between gap-6">
				<div class="min-w-0">
					<span id="desktop-notifications-label" class="text-sm font-medium text-foreground">Desktop notifications</span>
					<p class="text-xs text-muted-foreground mt-1 leading-relaxed">Show notifications for new unread mail. Auto uses Web Push when possible, then browser-tab notifications while Raven is open.</p>
					<p class="text-xs text-muted-foreground mt-2" data-desktop-notifications-status>Browser permission will be requested when enabled.</p>
					<p class="text-xs font-medium text-muted-foreground mt-1" data-notification-active-method>Active method: Off</p>
					@button.Button(button.Props{
						Variant:    button.VariantOutline,
						Size:       button.SizeSm,
						Class:      "hidden mt-2 h-8 w-fit px-3 text-xs",
						Attributes: templ.Attributes{"data-enable-device-notifications": ""},
					}) {
						Enable on this device
					}
				</div>
				<div class="w-full sm:w-44 shrink-0 space-y-3">
					<div class="flex items-center justify-between gap-3 rounded-md border border-border/60 bg-background/40 px-3 py-2">
						<span class="text-xs font-medium text-muted-foreground">Enable</span>
						@switchcomp.Switch(switchcomp.Props{
							ID:      "desktop-notifications",
							Name:    "desktop_notifications",
							Checked: uiSettingGet(uiSettings, "desktop_notifications", "false") == "true",
							Attributes: templ.Attributes{"aria-labelledby": "desktop-notifications-label", "data-ui-setting-switch": "desktop_notifications", "data-desktop-notifications-switch": ""},
						})
					</div>
					@selectbox.SelectBox(selectbox.Props{Class: "settings-select"}) {
						@selectbox.Trigger(selectbox.TriggerProps{Name: "notification_mode", Class: "bg-background", DisableClear: true}) {
							@selectbox.Value(selectbox.ValueProps{Placeholder: "Auto"}) {
								{ notificationModeSettingLabel(uiSettingGet(uiSettings, "notification_mode", "auto")) }
							}
						}
						@selectbox.Content(selectbox.ContentProps{NoSearch: true}) {
							@selectbox.Item(selectbox.ItemProps{Value: "auto", Selected: uiSettingGet(uiSettings, "notification_mode", "auto") == "auto"}) { Auto }
							@selectbox.Item(selectbox.ItemProps{Value: "web_push", Selected: uiSettingGet(uiSettings, "notification_mode", "auto") == "web_push"}) { Web Push }
							@selectbox.Item(selectbox.ItemProps{Value: "browser_tab", Selected: uiSettingGet(uiSettings, "notification_mode", "auto") == "browser_tab"}) { Browser tab }
							@selectbox.Item(selectbox.ItemProps{Value: "off", Selected: uiSettingGet(uiSettings, "notification_mode", "auto") == "off"}) { Off }
						}
					}
					<button type="button" class="inline-flex h-8 w-full shrink-0 items-center justify-center gap-2 whitespace-nowrap rounded-md border border-input bg-background px-3 text-xs font-medium transition-colors hover:bg-accent hover:text-accent-foreground focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring focus-visible:ring-offset-2 disabled:pointer-events-none disabled:opacity-50" data-desktop-notifications-test disabled title="Send a test notification using the active method">
						@icon.BellRing(icon.Props{Class: "size-3.5"})
						Send test
					</button>
				</div>
			</div>
			<div class="settings-row border-t border-border/60 pt-5 flex flex-col gap-4 sm:flex-row sm:items-center sm:justify-between">
				<div class="min-w-0">
					<h4 class="text-sm font-medium text-foreground">Meeting reminders</h4>
					<p class="text-xs text-muted-foreground mt-1 leading-relaxed">Notify this long before a timed calendar event starts. Uses the notification settings above; events you declined and all-day events are skipped.</p>
				</div>
				<div class="w-full sm:w-44 shrink-0" data-calendar-reminder-picker>
					@selectbox.SelectBox(selectbox.Props{Class: "settings-select"}) {
						@selectbox.Trigger(selectbox.TriggerProps{Name: "calendar_reminder_minutes", Class: "bg-background", DisableClear: true}) {
							@selectbox.Value(selectbox.ValueProps{Placeholder: "10 minutes"}) {
								{ calendarReminderSettingLabel(uiSettingGet(uiSettings, "calendar_reminder_minutes", "10")) }
							}
						}
						@selectbox.Content(selectbox.ContentProps{NoSearch: true}) {
							for _, v := range calendarReminderSettingValues {
								@selectbox.Item(selectbox.ItemProps{Value: v, Selected: uiSettingGet(uiSettings, "calendar_reminder_minutes", "10") == v}) { { calendarReminderSettingLabel(v) } }
							}
						}
					}
				</div>
			</div>
			<div class="flex flex-col gap-4 rounded-lg border border-border/60 bg-background/40 p-4 sm:flex-row sm:items-center sm:justify-between sm:gap-6">
				<div class="min-w-0">
					<h4 class="text-sm font-medium text-foreground">Email links</h4>
					<p class="text-xs text-muted-foreground mt-1 leading-relaxed">Open <span class="font-mono">mailto:</span> links from websites in a new Raven message.</p>
					<p id="mailto-handler-status" class="text-xs text-muted-foreground mt-2" data-mailto-handler-status>Your browser will ask you to confirm.</p>
				</div>
				<div class="flex w-full shrink-0 flex-col gap-2 sm:w-auto">
					<button type="button" class="inline-flex h-8 w-full shrink-0 items-center justify-center gap-2 whitespace-nowrap rounded-md border border-input bg-background px-3 text-xs font-medium transition-colors hover:bg-accent hover:text-accent-foreground focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring focus-visible:ring-offset-2 disabled:pointer-events-none disabled:opacity-50 sm:w-auto" data-mailto-handler-button aria-describedby="mailto-handler-status">
						<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="size-3.5" aria-hidden="true">
							<circle cx="12" cy="12" r="4"></circle>
							<path d="M16 8v5a3 3 0 0 0 6 0v-1a10 10 0 1 0-4 8"></path>
						</svg>
						Use Raven
					</button>
					<button type="button" class="inline-flex h-8 w-full shrink-0 items-center justify-center gap-2 whitespace-nowrap rounded-md border border-input bg-background px-3 text-xs font-medium transition-colors hover:bg-accent hover:text-accent-foreground focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring focus-visible:ring-offset-2 disabled:pointer-events-none disabled:opacity-50 sm:w-auto" data-mailto-handler-test-button aria-describedby="mailto-handler-status">
						<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="size-3.5" aria-hidden="true">
							<path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"></path>
							<path d="m9 11 3 3L22 4"></path>
						</svg>
						Test email link
					</button>
				</div>
			</div>
		</div>
	</div>
}

templ SettingsContactsTab(accounts []models.Account, uiSettings map[string]string) {
	<div class="mt-6 space-y-6">
		<div class="settings-card bg-card rounded-lg border p-6 space-y-5">
			<div>
				<h3 class="text-sm font-semibold text-muted-foreground mb-1">Local contacts</h3>
				<p class="text-xs text-muted-foreground">Control how Raven builds and maintains your local address book from mail you already have.</p>
			</div>
			<div class="settings-row border-t border-border/60 pt-5 space-y-5">
				<div class="flex items-start justify-between gap-6">
					<div class="min-w-0">
						<span id="contacts-auto-create-observed-label" class="text-sm font-medium text-foreground">Auto-create observed contacts</span>
						<p class="text-xs text-muted-foreground mt-1 leading-relaxed">Create local contacts from selected discovery sources. Disable this if you only want manually saved contacts.</p>
					</div>
					@switchcomp.Switch(switchcomp.Props{
						ID:      "contacts-auto-create-observed",
						Name:    "contacts_auto_create_observed",
						Checked: uiSettingGet(uiSettings, "contacts_auto_create_observed", "true") != "false",
						Attributes: templ.Attributes{"aria-labelledby": "contacts-auto-create-observed-label", "data-ui-setting-switch": "contacts_auto_create_observed", "data-contact-autocreate-switch": ""},
					})
				</div>
				<fieldset
					data-contact-autocreate-dependent
					disabled?={ uiSettingGet(uiSettings, "contacts_auto_create_observed", "true") == "false" }
					class={
						"space-y-5 border-t border-border/60 pt-5 transition-opacity",
						templ.KV("opacity-45 pointer-events-none saturate-50", uiSettingGet(uiSettings, "contacts_auto_create_observed", "true") == "false"),
					}
				>
					<div class="space-y-4">
						<div class="min-w-0">
							<h4 class="text-sm font-medium text-foreground">Discovery sources</h4>
							<p class="text-xs text-muted-foreground mt-1 leading-relaxed">Choose which mail participants should be eligible for automatic contact creation.</p>
						</div>
						<div class="space-y-3">
							<div class="flex items-start justify-between gap-6">
								<div class="min-w-0">
									<span id="contacts-observed-senders-label" class="text-sm font-medium text-foreground">Senders</span>
									<p class="text-xs text-muted-foreground mt-1">Create contacts from message From addresses.</p>
								</div>
								@switchcomp.Switch(switchcomp.Props{
									ID:      "contacts-observed-senders",
									Name:    "contacts_observed_senders",
									Checked: uiSettingCSVHas(uiSettings, "contacts_observed_sources", "senders,recipients", "senders"),
									Attributes: templ.Attributes{"aria-labelledby": "contacts-observed-senders-label", "data-contact-source-switch": "senders"},
								})
							</div>
							<div class="flex items-start justify-between gap-6">
								<div class="min-w-0">
									<span id="contacts-observed-recipients-label" class="text-sm font-medium text-foreground">Recipients</span>
									<p class="text-xs text-muted-foreground mt-1">Create contacts from To, Cc, and Bcc addresses.</p>
								</div>
								@switchcomp.Switch(switchcomp.Props{
									ID:      "contacts-observed-recipients",
									Name:    "contacts_observed_recipients",
									Checked: uiSettingCSVHas(uiSettings, "contacts_observed_sources", "senders,recipients", "recipients"),
									Attributes: templ.Attributes{"aria-labelledby": "contacts-observed-recipients-label", "data-contact-source-switch": "recipients"},
								})
							</div>
						</div>
					</div>
					<div class="flex items-start justify-between gap-6 border-t border-border/60 pt-5">
						<div class="min-w-0">
							<span id="contacts-prevent-recreate-deleted-label" class="text-sm font-medium text-foreground">Do not recreate deleted contacts</span>
							<p class="text-xs text-muted-foreground mt-1 leading-relaxed">When an observed contact is deleted, keep it suppressed so future mail from the same address does not add it back automatically.</p>
						</div>
						@switchcomp.Switch(switchcomp.Props{
							ID:      "contacts-prevent-recreate-deleted",
							Name:    "contacts_prevent_recreate_deleted",
							Checked: uiSettingGet(uiSettings, "contacts_prevent_recreate_deleted", "true") != "false",
							Attributes: templ.Attributes{"aria-labelledby": "contacts-prevent-recreate-deleted-label", "data-ui-setting-switch": "contacts_prevent_recreate_deleted"},
						})
					</div>
					<div class="flex items-start justify-between gap-6 border-t border-border/60 pt-5">
						<div class="min-w-0">
							<h4 class="text-sm font-medium text-foreground">Delete discovered contacts</h4>
							<p class="text-xs text-muted-foreground mt-1 leading-relaxed">Remove contacts that were created by discovery. Manually saved contacts are kept.</p>
						</div>
						@dialog.Trigger(dialog.TriggerProps{For: "delete-discovered-contacts-dialog"}) {
							<button type="button" class="inline-flex shrink-0 items-center gap-1.5 rounded-md border border-destructive/30 px-3 py-2 text-xs font-semibold text-destructive hover:bg-destructive/10">
								@icon.Trash2(icon.Props{Class: "size-3.5"})
								Delete discovered
							</button>
						}
					</div>
				</fieldset>
				@dialog.Dialog(dialog.Props{ID: "delete-discovered-contacts-dialog"}) {
					@dialog.Content(dialog.ContentProps{Class: "sm:max-w-md"}) {
						@dialog.Header() {
							@dialog.Title() { Delete discovered contacts }
							@dialog.Description() { Remove contacts Raven created through discovery. Manually saved contacts will be kept. }
						}
						<div class="rounded-lg border border-destructive/15 bg-destructive/5 p-3 text-sm text-muted-foreground">
							This action deletes all discovered contacts. Deleted addresses may be suppressed from automatic recreation depending on your contact settings.
						</div>
						@dialog.Footer() {
							@dialog.Close() {
								<button type="button" class="inline-flex items-center justify-center gap-1.5 text-sm font-medium px-4 py-2 rounded-lg border border-border hover:bg-accent transition-colors">
									Cancel
								</button>
							}
							<form action="/api/settings/contacts/delete-observed" method="post">
								<button type="submit" class="inline-flex items-center justify-center gap-1.5 text-sm font-medium px-4 py-2 rounded-lg bg-destructive text-white hover:bg-destructive/90 transition-colors">
									@icon.Trash2(icon.Props{Class: "size-4"})
									Delete discovered
								</button>
							</form>
						}
					}
				}
				<div id="contacts-suppressed-settings" hx-get="/api/settings/contacts/suppressed" hx-trigger="load" hx-swap="outerHTML" class="settings-row border-t border-border/60 pt-5">
					<div class="flex items-center justify-between gap-4">
						<div class="min-w-0">
							<div class="h-4 w-40 rounded bg-muted animate-pulse"></div>
							<div class="mt-2 h-3 w-64 rounded bg-muted animate-pulse"></div>
						</div>
						<div class="h-8 w-20 rounded bg-muted animate-pulse"></div>
					</div>
				</div>
			</div>
		</div>
		<div class="settings-card bg-card rounded-lg border p-6 space-y-5">
			<div>
				<h3 class="text-sm font-semibold text-muted-foreground mb-1">Provider sync</h3>
				<p class="text-xs text-muted-foreground">Sync contacts with connected accounts. Gmail and Outlook use their existing account authorization; generic accounts appear here when contact sync is configured.</p>
			</div>
			<div class="settings-row border-t border-border/60 pt-5 space-y-3">
				<div class="flex flex-col gap-3 sm:flex-row sm:items-center sm:justify-between">
					<div class="min-w-0">
						<div class="flex flex-wrap items-center gap-2">
							<h4 class="text-sm font-medium text-foreground">Account contacts</h4>
							<span class="rounded-full bg-muted px-2 py-0.5 text-xs font-medium text-muted-foreground">{ fmt.Sprintf("%d accounts", len(contactSyncAccounts(accounts))) }</span>
						</div>
						<p class="text-xs text-muted-foreground mt-1 leading-relaxed">Pull provider changes and keep contacts linked to selected accounts up to date.</p>
					</div>
					if len(contactSyncAccounts(accounts)) > 0 {
						<form hx-post="/api/settings/contacts/accounts/sync" hx-target="#account-contact-sync-status" hx-swap="innerHTML">
							<button type="submit" class="inline-flex shrink-0 whitespace-nowrap items-center gap-1.5 rounded-md border border-border px-3 py-2 text-xs font-semibold text-foreground hover:bg-accent">
								@icon.RefreshCw(icon.Props{Class: "size-3.5"})
								Sync all accounts
							</button>
						</form>
					} else {
						<a href="/settings/accounts" hx-get="/settings/accounts" hx-select="#settings-content" hx-target="#settings-content" hx-swap="outerHTML" class="inline-flex shrink-0 items-center gap-1.5 rounded-md border border-border px-3 py-2 text-xs font-semibold text-foreground hover:bg-accent">
							@icon.Mail(icon.Props{Class: "size-3.5"})
							Connect account
						</a>
					}
				</div>
				if len(contactSyncAccounts(accounts)) > 0 {
					<div class="space-y-2 border-t border-border/60 pt-3">
						<p class="text-xs font-semibold text-muted-foreground">Account sync</p>
						for _, account := range contactSyncAccounts(accounts) {
							<div class="settings-item flex items-center justify-between gap-3 rounded-lg border border-border/60 bg-background/40 px-3 py-2">
								<div class="min-w-0">
									<p class="truncate text-xs font-medium text-foreground">{ account.DisplayLabel() }</p>
									<p class="truncate text-xs text-muted-foreground">{ contactProviderLabel(account) } - { account.Email }</p>
								</div>
								<form hx-post="/api/settings/contacts/accounts/sync" hx-target="#account-contact-sync-status" hx-swap="innerHTML">
									<input type="hidden" name="account_id" value={ account.ID }/>
									<button type="submit" class="inline-flex shrink-0 items-center gap-1.5 rounded-md border border-border px-2.5 py-1.5 text-xs font-semibold text-foreground hover:bg-accent">
										@icon.RefreshCw(icon.Props{Class: "size-3.5"})
										Sync
									</button>
								</form>
							</div>
						}
					</div>
				}
				<div id="account-contact-sync-status" class="mt-3"></div>
			</div>
		</div>
	</div>
}

templ GmailReauthForm(account models.Account) {
	<form method="POST" action="/api/accounts/oauth2/authorize" class="contents">
		<input type="hidden" name="flow_action" value="reconnect"/>
		<input type="hidden" name="provider" value="gmail"/>
		<input type="hidden" name="email_address" value={ account.Email }/>
		<input type="hidden" name="display_name" value={ account.Name }/>
		<input type="hidden" name="imap_host" value="imap.gmail.com"/>
		<input type="hidden" name="imap_port" value="993"/>
		<input type="hidden" name="imap_tls_mode" value="tls"/>
		<input type="hidden" name="smtp_host" value="smtp.gmail.com"/>
		<input type="hidden" name="smtp_port" value="465"/>
		<input type="hidden" name="smtp_tls_mode" value="tls"/>
		<input type="hidden" name="auth_method" value="oauth2"/>
		<input type="hidden" name="username" value={ account.Email }/>
		@dropdown.Item(dropdown.ItemProps{Class: "justify-start gap-2", Attributes: templ.Attributes{"type": "submit", "data-account-secondary-action": "reconnect"}}) {
			@icon.RefreshCw(icon.Props{Class: "size-3.5"})
			Reconnect
		}
	</form>
}

templ OutlookReauthForm(account models.Account) {
	<form method="POST" action="/api/accounts/oauth2/authorize" class="contents">
		<input type="hidden" name="flow_action" value="reconnect"/>
		<input type="hidden" name="provider" value="outlook"/>
		<input type="hidden" name="email_address" value={ account.Email }/>
		<input type="hidden" name="display_name" value={ account.Name }/>
		@dropdown.Item(dropdown.ItemProps{Class: "justify-start gap-2", Attributes: templ.Attributes{"type": "submit", "data-account-secondary-action": "reconnect"}}) {
			@icon.RefreshCw(icon.Props{Class: "size-3.5"})
			Reconnect
		}
	</form>
}

func gmailAccounts(accounts []models.Account) []models.Account {
	out := make([]models.Account, 0, len(accounts))
	for _, account := range accounts {
		if account.Provider == "gmail" {
			out = append(out, account)
		}
	}
	return out
}

func contactSyncAccounts(accounts []models.Account) []models.Account {
	out := make([]models.Account, 0, len(accounts))
	for _, account := range accounts {
		if account.ContactSyncEnabled {
			out = append(out, account)
		}
	}
	return out
}

func contactProviderLabel(account models.Account) string {
switch account.ContactSyncProvider {
	case "gmail":
		return "Gmail"
	case "outlook":
		return "Outlook"
	case "carddav":
		return "CardDAV"
	default:
		return "Contacts"
	}
}

templ SettingsSuppressedContacts(contacts []models.Contact, totalCount int) {
	<div id="contacts-suppressed-settings" class="settings-row border-t border-border/60 pt-5">
		<div class="flex items-start justify-between gap-6">
			<div class="min-w-0">
				<div class="flex items-center gap-2">
					<h4 class="text-sm font-medium text-foreground">Suppressed contacts</h4>
					<span class="rounded-full bg-muted px-2 py-0.5 text-xs font-medium text-muted-foreground">{ fmt.Sprintf("%d", totalCount) }</span>
				</div>
				<p class="text-xs text-muted-foreground mt-1 leading-relaxed">Deleted discovered contacts that should not be recreated automatically.</p>
			</div>
			@dialog.Trigger(dialog.TriggerProps{For: "suppressed-contacts-dialog"}) {
				<button type="button" class="inline-flex shrink-0 items-center gap-1.5 rounded-md border border-border px-3 py-2 text-xs font-semibold text-muted-foreground hover:bg-accent hover:text-foreground">
					@icon.List(icon.Props{Class: "size-3.5"})
					Manage
				</button>
			}
		</div>
		@dialog.Dialog(dialog.Props{ID: "suppressed-contacts-dialog"}) {
			@dialog.Content(dialog.ContentProps{Class: "sm:max-w-2xl"}) {
				@dialog.Header() {
					@dialog.Title() { Suppressed contacts }
					@dialog.Description() { These addresses are allowed to stay deleted and will not be recreated by discovery. }
				}
				<div class="space-y-4">
					<div class="flex items-center justify-between gap-4 rounded-lg border border-border/60 bg-background/40 p-3">
						<div class="min-w-0">
							<div class="text-sm font-medium text-foreground">{ fmt.Sprintf("%d", totalCount) } suppressed contacts</div>
							<p class="text-xs text-muted-foreground mt-0.5">Remove one address or clear the full suppression list.</p>
						</div>
						if totalCount > 0 {
							<form hx-post="/api/settings/contacts/suppressed/clear" hx-target="#contacts-suppressed-settings" hx-swap="outerHTML" data-confirm="Clear all suppressed contacts? These addresses may be rediscovered later.">
								<button type="submit" class="inline-flex shrink-0 items-center gap-1.5 rounded-md border border-destructive/30 px-3 py-2 text-xs font-semibold text-destructive hover:bg-destructive/10">
									@icon.Trash2(icon.Props{Class: "size-3.5"})
									Clear all
								</button>
							</form>
						}
					</div>
					if totalCount == 0 {
						<div class="rounded-lg border border-dashed border-border bg-background/40 p-6 text-center text-sm text-muted-foreground">No suppressed contacts.</div>
					} else {
						<div class="max-h-80 overflow-y-auto rounded-lg border border-border/60 bg-background/35">
							for _, contact := range contacts {
								<div class="flex items-center gap-3 border-b border-border/50 px-3 py-2.5 last:border-b-0">
									@ContactAvatar(contact, "size-8 rounded-full text-xs font-bold shrink-0", "bg-muted text-muted-foreground")
									<div class="min-w-0 flex-1">
										<div class="truncate text-sm font-medium text-foreground">{ contact.Name }</div>
										<div class="truncate text-xs text-muted-foreground">{ contact.Email }</div>
									</div>
									<form hx-post={ templ.URL(fmt.Sprintf("/api/settings/contacts/suppressed/%s/clear", contact.ID)) } hx-target="#contacts-suppressed-settings" hx-swap="outerHTML">
										<button type="submit" class="inline-flex shrink-0 items-center gap-1.5 rounded-md border border-border px-2.5 py-1.5 text-xs font-semibold text-muted-foreground hover:bg-accent hover:text-foreground">Allow again</button>
									</form>
								</div>
							}
							if totalCount > len(contacts) {
								<div class="px-3 py-2 text-xs text-muted-foreground">Showing { fmt.Sprintf("%d", len(contacts)) } of { fmt.Sprintf("%d", totalCount) } suppressed contacts.</div>
							}
						</div>
					}
				</div>
			}
		}
	</div>
}

templ SettingsAccountsTab(accounts []models.Account) {
	<div class="mt-6 bg-card rounded-lg border p-6 space-y-5">
		<div class="flex flex-col gap-3 sm:flex-row sm:items-start sm:justify-between">
			<div class="min-w-0">
				<h3 class="text-sm font-semibold text-muted-foreground mb-1">Accounts</h3>
				<p class="text-xs text-muted-foreground leading-relaxed">See which connected services each account provides. Email is available for existing mail accounts; contacts appear when provider sync is enabled.</p>
			</div>
			@dialog.Trigger(dialog.TriggerProps{For: "choose-account-type-dialog"}) {
				@button.Button(button.Props{
					Size:    button.SizeSm,
					Class:   "bg-primary text-primary-foreground hover:bg-primary/90 disabled:cursor-not-allowed disabled:opacity-60 transition-colors shrink-0",
				}) {
					@icon.Plus(icon.Props{Class: "size-4"})
					Add Account
				}
			}
		</div>
		if len(accounts) == 0 {
			@SettingsNoAccounts()
		} else {
			<div class="space-y-3">
				for _, a := range accounts {
					@SettingsAccountCard(a)
				}
			</div>
		}
	</div>
}

templ SettingsSyncTab(settings models.SyncSettings, uiSettings map[string]string) {
	@tabs.Tabs(tabs.Props{ID: "email-sync-folder-tabs", Class: "mt-6 gap-5", Attributes: templ.Attributes{"data-tui-tabs-local": "", "data-tui-tabs-animate-content": "", "aria-label": "Email sync and folder settings"}}) {
		@tabs.List(tabs.ListProps{Class: "bg-card"}) {
			@tabs.Trigger(tabs.TriggerProps{Value: "sync", IsActive: true, Class: "px-3 text-xs"}) {
				@icon.RefreshCw(icon.Props{Class: "size-3.5"})
				Sync settings
			}
			@tabs.Trigger(tabs.TriggerProps{Value: "unified", Class: "px-3 text-xs"}) {
				@icon.Folders(icon.Props{Class: "size-3.5"})
				Unified folders
			}
		}
		@tabs.Content(tabs.ContentProps{Value: "sync", IsActive: true}) {
			<form id="sync-settings-form" action="/api/settings/sync" method="POST" class="space-y-4">
				<div class="settings-card bg-card rounded-lg border p-6">
					<div class="flex flex-col gap-4 sm:flex-row sm:items-center sm:justify-between">
						<div class="min-w-0">
							<h3 class="text-sm font-semibold text-muted-foreground mb-1">Sync Frequency</h3>
							<p class="text-xs text-muted-foreground leading-relaxed">Controls how often polled folders are checked for changes.</p>
						</div>
						<div class="w-full sm:w-40 shrink-0">
							@selectbox.SelectBox(selectbox.Props{Class: "settings-select"}) {
								@selectbox.Trigger(selectbox.TriggerProps{Name: "sync_interval_minutes", Class: "bg-background", DisableClear: true}) {
									@selectbox.Value(selectbox.ValueProps{Placeholder: "5 minutes"}) {
										{ strconv.Itoa(settings.SyncIntervalMinutes) } min
									}
								}
								@selectbox.Content(selectbox.ContentProps{NoSearch: true}) {
									@selectbox.Item(selectbox.ItemProps{Value: "1", Selected: settings.SyncIntervalMinutes == 1}) { 1 minute }
									@selectbox.Item(selectbox.ItemProps{Value: "5", Selected: settings.SyncIntervalMinutes == 5}) { 5 minutes }
									@selectbox.Item(selectbox.ItemProps{Value: "10", Selected: settings.SyncIntervalMinutes == 10}) { 10 minutes }
									@selectbox.Item(selectbox.ItemProps{Value: "15", Selected: settings.SyncIntervalMinutes == 15}) { 15 minutes }
									@selectbox.Item(selectbox.ItemProps{Value: "30", Selected: settings.SyncIntervalMinutes == 30}) { 30 minutes }
								}
								}
								<span id="sync-save-status" class="sr-only" aria-live="polite"></span>
							</div>
						</div>
					</div>

				if len(settings.Accounts) > 0 {
					<div class="settings-card bg-card rounded-lg border p-6 space-y-5">
						<div class="flex flex-col gap-3 sm:flex-row sm:items-start sm:justify-between">
							<div>
								<h3 class="text-sm font-semibold text-muted-foreground mb-1">Account Sync Mode</h3>
								if syncSettingsHasConfigurableFolderModes(settings) {
									<p class="text-xs text-muted-foreground leading-relaxed">IMAP folders can use real-time push notifications or periodic polling. Gmail uses Gmail API history checks, and Outlook uses Microsoft Graph delta sync.</p>
								} else {
									<p class="text-xs text-muted-foreground leading-relaxed">Provider-native sync uses Gmail API history checks or Microsoft Graph delta sync, so per-folder IMAP IDLE is not configurable.</p>
								}
							</div>
							if syncSettingsHasConfigurableFolderModes(settings) {
								@popover.Root(popover.RootProps{ID: "sync-real-time-note", Class: "shrink-0"}) {
									@popover.Trigger() {
										<button
											type="button"
											class="flex shrink-0 items-center gap-1.5 text-xs text-muted-foreground hover:text-foreground transition-colors focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring focus-visible:ring-offset-2 focus-visible:ring-offset-background rounded-md"
											aria-label="Show real-time sync note"
										>
											@icon.TriangleAlert(icon.Props{Class: "size-3"})
											Real-time note
										</button>
									}
									@popover.Content(popover.ContentProps{Placement: popover.PlacementBottomEnd, ShowArrow: true, Class: "w-80"}) {
										<div class="flex items-start gap-2.5 p-3">
											@icon.TriangleAlert(icon.Props{Class: "size-3.5 text-muted-foreground mt-0.5 shrink-0"})
											<p class="text-xs text-muted-foreground leading-relaxed">
												Each real-time folder holds open a persistent IMAP connection. Most servers limit concurrent connections (typically 5-15). Enabling real-time on too many folders may cause connection errors or prevent new folders from syncing.
											</p>
										</div>
									}
								}
							}
						</div>
						<div id="idle-folders-inputs"></div>
						<div class="space-y-3" data-sync-folders={ strconv.Itoa(settings.SyncIntervalMinutes) }>
							for _, account := range settings.Accounts {
								<div class="settings-item rounded-lg border border-border/60 bg-background/40 p-4" data-sync-account-card>
									<div class="flex items-center gap-2.5 mb-4">
										<div class="account-color-marker size-4 shrink-0" style={ accountColorStyle(account.Color) } data-account-marker={ account.AccountID }></div>
										<div class="min-w-0">
											<p class="text-sm font-medium leading-tight truncate">{ account.AccountName }</p>
											<p class="text-xs text-muted-foreground truncate">{ account.AccountEmail }</p>
										</div>
									</div>
									if syncSettingsAccountUsesProviderAPI(account.Provider) {
										<div class="rounded-md border border-border/70 bg-card/60 p-3">
											<div class="flex items-start gap-2.5">
												<div class="mt-0.5 flex size-7 shrink-0 items-center justify-center rounded-md border border-border/70 bg-background text-muted-foreground">
													@icon.MailCheck(icon.Props{Class: "size-3.5"})
												</div>
												<div class="min-w-0">
													<div class="text-xs font-semibold text-muted-foreground">{ syncSettingsProviderAPITitle(account.Provider) }</div>
													<p class="mt-1 text-xs leading-relaxed text-muted-foreground">
														{ syncSettingsProviderAPIDescription(account.Provider) }
													</p>
												</div>
											</div>
										</div>
									} else {
										<div class="grid gap-3 md:grid-cols-2">
											<div class="rounded-md border border-border/70 bg-card/60 p-3">
												<div class="flex items-center gap-1.5 mb-2">
													@icon.Zap(icon.Props{Class: "size-3 text-amber-700/70 dark:text-amber-300/70"})
											<span class="text-xs font-semibold text-muted-foreground">Real-time</span>
										</div>
										<div class="flex flex-wrap gap-1.5 min-h-[28px]" data-idle-zone={ account.AccountID }>
											for _, f := range account.Folders {
												if syncFolderUsesEffectiveIDLE(f) {
													@syncFolderPill(f, settings.SyncIntervalMinutes, account.AccountID)
												}
											}
												</div>
											</div>
											<div class="rounded-md border border-border/70 bg-card/60 p-3">
												<div class="flex items-center gap-1.5 mb-2">
													@icon.Clock(icon.Props{Class: "size-3 text-muted-foreground"})
											<span class="text-xs font-semibold text-muted-foreground" data-sync-polling-title>Polling ({ strconv.Itoa(settings.SyncIntervalMinutes) } min)</span>
										</div>
										<div class="flex flex-wrap gap-1.5 min-h-[28px]" data-poll-zone={ account.AccountID }>
											for _, f := range account.Folders {
												if !syncFolderUsesEffectiveIDLE(f) {
													@syncFolderPill(f, settings.SyncIntervalMinutes, account.AccountID)
												}
											}
												</div>
											</div>
										</div>
									}
								</div>
							}
						</div>
					</div>
				}
				</form>
		}
		@tabs.Content(tabs.ContentProps{Value: "unified"}) {
			<div class="settings-card bg-card rounded-lg border p-6 space-y-5">
				<div>
					<h3 class="text-sm font-semibold text-muted-foreground mb-1">Unified folders</h3>
					<p class="text-xs text-muted-foreground leading-relaxed">Control how Raven groups matching folders across connected mail accounts.</p>
				</div>
				<div class="settings-row border-t border-border/60 pt-5">
					<div class="flex flex-col gap-4 sm:flex-row sm:items-start sm:justify-between">
						<div class="min-w-0">
								<span id="unified-folders-enabled-label" class="text-sm font-medium text-foreground">Enable unified folders</span>
							<p class="text-xs text-muted-foreground mt-1 leading-relaxed">Place combined Inbox, Starred, Sent, Drafts, Archive, Spam, and Trash folders above the individual account list.</p>
						</div>
						<div class="w-full sm:w-44 shrink-0">
							<div class="flex items-center justify-between gap-3 rounded-md border border-border/60 bg-background/40 px-3 py-2">
								<span class="text-xs font-medium text-muted-foreground">Enable</span>
								@switchcomp.Switch(switchcomp.Props{
									ID:      "unified-folders-enabled",
									Name:    "unified_folders_enabled",
									Checked: uiSettingGet(uiSettings, "unified_folders_enabled", "true") != "false",
									Attributes: templ.Attributes{"aria-labelledby": "unified-folders-enabled-label", "data-unified-folders-setting": "enabled"},
								})
							</div>
						</div>
					</div>
				</div>
				<div class="settings-item overflow-hidden rounded-lg border border-border/60 bg-background/40" data-unified-folder-list>
					for _, folder := range unifiedFolderOptions() {
						@UnifiedFolderSettingRow(folder, settings.Accounts, uiSettings)
					}
				</div>
			</div>
		}
	}
	<style>
		@keyframes sync-pill-in {
			0% { opacity: 0; transform: scale(0.9); }
			100% { opacity: 1; transform: scale(1); }
		}
		@keyframes sync-pill-out {
			0% { opacity: 1; transform: scale(1); }
			100% { opacity: 0; transform: scale(0.9); }
		}
		.sync-pill-enter { animation: sync-pill-in 220ms ease-out; }
		.sync-pill-exit { animation: sync-pill-out 160ms ease-in forwards; }
	</style>
}

templ UnifiedFolderSettingRow(folder unifiedFolderOption, accounts []models.AccountSyncStatus, uiSettings map[string]string) {
	{{ key := unifiedFolderSettingKey(folder.ID) }}
	{{ enabled := uiSettingGet(uiSettings, key, "true") != "false" }}
	{{ masterEnabled := uiSettingGet(uiSettings, "unified_folders_enabled", "true") != "false" }}
	<div
		class={
			"flex min-h-12 items-center justify-between gap-3 border-b border-border/60 px-3 py-2.5 transition-colors last:border-b-0 hover:bg-muted/30",
			templ.KV("opacity-50", !masterEnabled),
		}
		data-unified-folder-dependent
	>
		<div class="flex min-w-0 items-center gap-3">
			<span class="flex size-8 shrink-0 items-center justify-center rounded-md text-muted-foreground">
				@SidebarFolderIcon(folder.Icon)
			</span>
			<div class="min-w-0">
				<span id={ "unified-folder-" + folder.ID + "-label" } class="text-sm font-medium text-foreground">{ folder.Name }</span>
			</div>
		</div>
		<div class="flex shrink-0 items-center gap-2">
			@UnifiedFolderAccountPopover(folder, accounts, uiSettings, masterEnabled)
			@switchcomp.Switch(switchcomp.Props{
				ID:       "unified-folder-" + folder.ID,
				Name:     key,
				Checked:  enabled,
				Disabled: !masterEnabled,
				Attributes: templ.Attributes{
					"data-unified-folder-switch": folder.ID,
					"aria-labelledby":            "unified-folder-" + folder.ID + "-label",
				},
			})
		</div>
	</div>
}

templ UnifiedFolderAccountPopover(folder unifiedFolderOption, accounts []models.AccountSyncStatus, uiSettings map[string]string, masterEnabled bool) {
	if len(accounts) > 0 {
		@popover.Root(popover.RootProps{ID: fmt.Sprintf("unified-folder-%s-accounts", folder.ID), Class: "shrink-0"}) {
			@popover.Trigger() {
				<button
					type="button"
					class="inline-flex size-8 items-center justify-center rounded-md text-muted-foreground transition-colors hover:bg-muted/60 hover:text-foreground focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring disabled:pointer-events-none disabled:opacity-40"
					aria-label={ "Choose accounts for " + folder.Name }
					disabled?={ !masterEnabled }
					data-unified-folder-account-button={ folder.ID }
				>
					@icon.Settings(icon.Props{Class: "size-3.5"})
				</button>
			}
			@popover.Content(popover.ContentProps{Placement: popover.PlacementBottomEnd, Offset: 8, ShowArrow: true, Class: "w-72 p-2"}) {
				<div class="border-b border-border/60 px-2 pb-2 text-xs font-semibold text-muted-foreground">Accounts</div>
				<div class="max-h-72 overflow-y-auto pt-1">
					for _, account := range accounts {
						@UnifiedFolderAccountRow(folder, account, uiSettings, masterEnabled)
					}
				</div>
			}
		}
	}
}

templ UnifiedFolderAccountRow(folder unifiedFolderOption, account models.AccountSyncStatus, uiSettings map[string]string, masterEnabled bool) {
	{{ key := unifiedFolderAccountSettingKey(folder.ID, account.AccountID) }}
	{{ enabled := uiSettingGet(uiSettings, key, "true") != "false" }}
	<div class="flex min-h-11 items-center justify-between gap-3 rounded-md px-2 py-2 hover:bg-muted/40" data-unified-folder-account-dependent={ folder.ID }>
		<div class="flex min-w-0 items-center gap-2.5">
			<span class="account-color-marker size-3 shrink-0" style={ accountColorStyle(account.Color) } data-account-marker={ account.AccountID }></span>
			<div class="min-w-0">
				<span id={ "unified-folder-" + folder.ID + "-account-" + account.AccountID + "-label" } class="block truncate text-sm font-medium text-foreground">{ syncAccountDisplayName(account) }</span>
				if account.AccountEmail != "" && account.AccountEmail != syncAccountDisplayName(account) {
					<p class="truncate text-xs text-muted-foreground">{ account.AccountEmail }</p>
				}
			</div>
		</div>
		@switchcomp.Switch(switchcomp.Props{
			ID:       "unified-folder-" + folder.ID + "-account-" + account.AccountID,
			Name:     key,
			Checked:  enabled,
			Disabled: !masterEnabled,
			Attributes: templ.Attributes{
				"data-unified-folder-account-switch": folder.ID,
				"data-unified-folder-account-id":     account.AccountID,
				"aria-labelledby":                    "unified-folder-" + folder.ID + "-account-" + account.AccountID + "-label",
			},
		})
	</div>
}

templ syncFolderPill(f models.FolderSyncStatus, interval int, accountID string) {
		<div
			data-sync-pill
			data-folder-id={ f.ID }
			data-role={ f.Role }
			data-account-id={ accountID }
			data-interval={ strconv.Itoa(interval) }
			data-folder-name={ syncFolderDisplayName(f) }
			data-configured-idle={ strconv.FormatBool(f.IsIDLE) }
			data-effective-idle={ strconv.FormatBool(syncFolderUsesEffectiveIDLE(f)) }
			data-idle-fallback-reason={ f.IDLEFallbackReason }
			data-idle-retry-at={ f.IDLERetryAt }
			class={
				"inline-flex items-center gap-1.5 px-2.5 rounded-md border text-xs font-medium cursor-pointer transition-transform hover:scale-[1.02] will-change-transform backface-hidden",
				templ.KV("bg-amber-800/10 border-amber-700/20 text-amber-800 dark:bg-amber-300/10 dark:border-amber-300/20 dark:text-amber-200", syncFolderUsesEffectiveIDLE(f)),
				templ.KV("bg-muted/50 border-border text-muted-foreground", !syncFolderUsesEffectiveIDLE(f)),
			}
			style="height:26px"
		>
			<button type="button" data-sync-pill-toggle class="inline-flex min-w-0 items-center gap-1.5" title={ f.RemoteID }>
				{{ folderIcon := icon.Icon(f.Icon) }}
				@folderIcon(icon.Props{Class: "size-3 shrink-0"})
				<span class="truncate">{ syncFolderDisplayName(f) }</span>
				if syncFolderUsesEffectiveIDLE(f) {
					<span class="sync-label text-xs opacity-70">
						real-time
					</span>
				}
			</button>
			<span
				data-idle-fallback-warning
				class={
					templ.KV("inline-flex", hasIDLEFallback(f)),
					templ.KV("hidden", !hasIDLEFallback(f)),
				}
			>
				@tooltip.Tooltip() {
					@tooltip.Trigger(tooltip.TriggerProps{Class: "inline-flex"}) {
						<span class="inline-flex text-amber-700 dark:text-amber-300" aria-label="Show IDLE fallback reason">
							@icon.TriangleAlert(icon.Props{Class: "size-3"})
						</span>
					}
					@tooltip.Content(tooltip.ContentProps{Position: tooltip.PositionTop, ShowArrow: true, Class: "max-w-72 px-3 py-1.5 text-center text-xs leading-relaxed"}) {
						<span data-idle-fallback-tooltip-text>{ idleFallbackTooltip(f) }</span>
					}
				}
			</span>
		</div>
}

func syncFolderUsesEffectiveIDLE(f models.FolderSyncStatus) bool {
	return f.IsIDLE && (f.EffectiveIDLE || strings.TrimSpace(f.IDLEFallbackReason) == "")
}

func hasIDLEFallback(f models.FolderSyncStatus) bool {
	return strings.TrimSpace(f.IDLEFallbackReason) != ""
}

func idleFallbackTooltip(f models.FolderSyncStatus) string {
	if strings.TrimSpace(f.IDLEFallbackReason) == "" {
		return ""
	}
	message := fmt.Sprintf("%s was moved to polling because %s.", syncFolderDisplayName(f), strings.TrimSuffix(strings.TrimSpace(f.IDLEFallbackReason), "."))
	if retryAt, err := time.Parse(time.RFC3339, f.IDLERetryAt); err == nil && retryAt.After(time.Now()) {
		remaining := time.Until(retryAt)
		minutes := max(1, int((remaining+time.Minute-1)/time.Minute))
		if minutes == 1 {
			return message + " Raven will try again in 1 minute."
		}
		return fmt.Sprintf("%s Raven will try again in %d minutes.", message, minutes)
	}
	return message
}

templ SettingsNoAccounts() {
	<div class="flex flex-col items-center justify-center py-10 text-center">
		<div class="size-14 rounded-full bg-muted/50 flex items-center justify-center mb-4">
			@icon.Mail(icon.Props{Class: "size-6 text-muted-foreground"})
		</div>
		<p class="text-sm font-medium text-foreground mb-1">No accounts yet</p>
		<p class="text-xs text-muted-foreground">Add your email account to get started.</p>
	</div>
}

templ SettingsAccountCard(account models.Account) {
	{{ syncError := strings.TrimSpace(account.EmailSyncError) }}
	{{ syncErrorAt := strings.TrimSpace(account.EmailSyncErrorAt) }}
	<div
		id={ fmt.Sprintf("account-card-%s", account.ID) }
		data-settings-account-card
		data-account-id={ account.ID }
		data-account-email={ account.Email }
		data-account-deleting={ fmt.Sprintf("%t", account.IsDeleting) }
		class="transition-[opacity,transform] duration-200 ease-out"
	>
		<div class="settings-account-card settings-item rounded-lg border border-border/60 bg-background/40 p-4">
			<div class="flex flex-col gap-3 sm:flex-row sm:items-start sm:justify-between">
				<div class="flex min-w-0 items-start gap-3">
					@AccountColorPopover(account)
					<div class="min-w-0">
						<div class="flex min-w-0 items-center gap-1.5">
							<p class="min-w-0 truncate text-sm font-semibold text-foreground" data-account-label={ account.ID } data-account-label-value={ account.Label }>{ account.DisplayLabel() }</p>
							@SettingsAccountSyncErrorPopover(account, syncError, syncErrorAt)
						</div>
						<p class="mt-0.5 truncate text-xs text-muted-foreground">{ account.Email }</p>
					</div>
				</div>
				<div class="flex shrink-0 items-center gap-2 self-end sm:self-auto sm:justify-end" data-account-actions>
					if account.IsDeleting {
						<button type="button" data-account-deleting-status role="status" aria-live="polite" class="inline-flex items-center gap-1.5 text-xs text-amber-700 dark:text-amber-400 px-2.5 py-1.5 rounded-md border border-amber-300/40 dark:border-amber-500/30 bg-amber-100/50 dark:bg-amber-500/10 cursor-default" disabled>
							@icon.RefreshCw(icon.Props{Class: "size-3.5 animate-spin"})
							Deleting
						</button>
					} else {
						<button
							type="button"
							data-account-primary-action="edit"
							class="account-action-btn inline-flex h-[30px] items-center gap-1.5 text-xs text-muted-foreground hover:text-foreground transition-colors px-2.5 rounded-md border border-border"
							hx-get={ fmt.Sprintf("/api/accounts/%s/edit", account.ID) }
							hx-target="#edit-account-container"
							hx-swap="innerHTML"
						>
							@icon.Pencil(icon.Props{Class: "size-3.5"})
							Edit
						</button>
						@SettingsAccountActionsMenu(account)
					}
				</div>
			</div>
			<div class="mt-4 border-t border-border/60 pt-3">
				<div class="mb-2 flex flex-col gap-1 sm:flex-row sm:items-center sm:justify-between">
					<p class="text-xs font-semibold text-muted-foreground">Enabled services</p>
					<p class="text-xs text-muted-foreground">Use Edit to enable/disable services.</p>
				</div>
				<div class="flex items-end justify-between gap-3">
					<div class="flex flex-wrap gap-2">
						@AccountServiceIndicator(account, "email", "Email", "Fetches mail and keeps folders up to date.", account.EmailSyncEnabled)
						@AccountServiceIndicator(account, "contacts", "Contacts", accountContactSyncStatusDescription(account), account.ContactSyncEnabled)
						@AccountServiceIndicator(account, "calendar", "Calendar", accountCalendarSyncStatusDescription(account), account.CalendarSyncEnabled)
					</div>
					<span class="inline-flex shrink-0 items-center gap-1 rounded-md border border-border/70 bg-muted/35 px-2 py-0.5 text-xs font-semibold text-muted-foreground">
						@AccountProviderIcon(account.Provider, "size-3.5 shrink-0")
						{ accountProviderName(account.Provider) }
					</span>
				</div>
			</div>
			if !account.IsDeleting {
				@SettingsAccountIdentitiesLoader(account)
			}
		</div>
		if !account.IsDeleting {
			@SettingsAccountConnectionTestDialog(account)
		}
		if account.Provider == "gmail" && account.EmailSyncEnabled && !account.IsDeleting {
			@dialog.Dialog(dialog.Props{ID: fmt.Sprintf("repair-account-%s", account.ID)}) {
				@dialog.Content(dialog.ContentProps{Class: "sm:max-w-md"}) {
					@dialog.Header() {
						@dialog.Title() {
							Repair and Full Resync
						}
						@dialog.Description() {
							This will re-list Gmail folders and re-check Gmail metadata for <strong>{ account.Email }</strong>. It can take a while on large mailboxes.
						}
					}
					<div class="flex items-center gap-3 rounded-lg border border-border bg-background/60 p-3">
						<div class="account-color-marker size-5 shrink-0" style={ accountColorStyle(account.Color) } data-account-marker={ account.ID }></div>
						<div class="min-w-0 flex-1">
							<p class="truncate text-sm font-medium">{ account.DisplayLabel() }</p>
							<p class="truncate text-xs text-muted-foreground">{ account.Email }</p>
						</div>
					</div>
					@dialog.Footer() {
						@dialog.Close() {
							<button
								type="button"
								class="inline-flex items-center justify-center gap-1.5 rounded-lg border border-border px-4 py-2 text-sm font-medium transition-colors hover:bg-accent"
							>
								Cancel
							</button>
						}
						<button
							type="button"
							class="inline-flex items-center justify-center gap-1.5 rounded-lg bg-primary px-4 py-2 text-sm font-medium text-primary-foreground transition-colors hover:bg-primary/90"
							hx-post={ fmt.Sprintf("/api/mail/sync/accounts/%s/repair", account.ID) }
							hx-swap="none"
							data-on-htmx-before-request='["handleMailSidebarSyncStart","$event","repair"]'
							data-on-htmx-after-request='["handleMailSidebarSyncResult","$event"]'
							data-mail-account-sync-button={ account.ID }
							data-repair-account-action="true"
							data-account-id={ account.ID }
						>
							@icon.RefreshCw(icon.Props{Class: "size-4"})
							Start Repair
						</button>
					}
				}
			}
		}
		@dialog.Dialog(dialog.Props{ID: fmt.Sprintf("delete-account-%s", account.ID)}) {
			@dialog.Content(dialog.ContentProps{Class: "sm:max-w-md"}) {
				@dialog.Header() {
					@dialog.Title() {
						Delete Account
					}
					@dialog.Description() {
						This removes <strong>{ account.Email }</strong> and its locally stored mail, contacts, scheduled sends, and account settings from Raven. It does not delete anything from your mail provider.
					}
				}
				<div class="flex items-center gap-3 p-3 rounded-lg bg-destructive/5 border border-destructive/15">
					<div class="account-color-marker size-5 shrink-0" style={ accountColorStyle(account.Color) } data-account-marker={ account.ID }></div>
					<div class="flex-1 min-w-0">
						<p class="text-sm font-medium truncate">{ account.DisplayLabel() }</p>
						<p class="text-xs text-muted-foreground truncate">{ account.Email }</p>
					</div>
				</div>
				@dialog.Footer() {
					@dialog.Close() {
						<button
							type="button"
							class="inline-flex items-center justify-center gap-1.5 text-sm font-medium px-4 py-2 rounded-lg border border-border hover:bg-accent transition-colors"
						>
							Cancel
						</button>
					}
					<button
						type="button"
						data-account-delete-submit
						class="inline-flex items-center justify-center gap-1.5 text-sm font-medium px-4 py-2 rounded-lg bg-destructive text-white hover:bg-destructive/90 transition-colors"
						hx-delete={ fmt.Sprintf("/api/accounts/%s", account.ID) }
						hx-swap="none"
						data-delete-account-action="true"
						data-account-id={ account.ID }
					>
						@icon.Trash2(icon.Props{Class: "size-4"})
						Delete Account
					</button>
				}
			}
		}
	</div>
}

templ SettingsAccountSyncErrorPopover(account models.Account, syncError string, syncErrorAt string) {
	<span
		data-settings-account-sync-error={ account.ID }
		hidden?={ !account.EmailSyncEnabled || syncError == "" }
		class="inline-flex shrink-0"
		aria-live="polite"
	>
		@popover.Root(popover.RootProps{ID: fmt.Sprintf("account-sync-error-%s", account.ID), Class: "shrink-0"}) {
			@popover.Trigger() {
				<button
					type="button"
					class="inline-flex size-6 items-center justify-center rounded-md text-destructive transition-colors hover:bg-destructive/10 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-destructive/40"
					aria-label={ fmt.Sprintf("Show mail sync error for %s", account.DisplayLabel()) }
				>
					@icon.CircleAlert(icon.Props{Class: "size-4"})
				</button>
			}
			@popover.Content(popover.ContentProps{Placement: popover.PlacementBottomStart, ShowArrow: true, Class: "w-80 p-3"}) {
				<div class="flex items-start gap-2.5">
					@icon.CircleAlert(icon.Props{Class: "mt-0.5 size-4 shrink-0 text-destructive"})
					<div class="min-w-0 flex-1">
						<p class="text-sm font-semibold text-popover-foreground">Mail sync failed</p>
						<p
							data-settings-account-sync-error-at-wrapper
							hidden?={ syncErrorAt == "" }
							class="mt-0.5 text-xs text-muted-foreground"
						>
							Last failure:
							<span data-account-sync-error-at={ syncErrorAt }>{ formatAccountSyncErrorAt(syncErrorAt, nil) }</span>
						</p>
						<p class="mt-2 break-words text-xs leading-relaxed text-muted-foreground" data-settings-account-sync-error-message>{ syncError }</p>
					</div>
				</div>
			}
		}
	</span>
}

type accountConnectionTestService struct {
	ID          string
	Label       string
	Description string
}

func accountConnectionTestServices(account models.Account) []accountConnectionTestService {
	switch strings.ToLower(strings.TrimSpace(account.Provider)) {
	case "gmail":
		return []accountConnectionTestService{{
			ID:          "gmail",
			Label:       "Gmail API",
			Description: "Checking Gmail API mail access...",
		}}
	case "outlook":
		return []accountConnectionTestService{{
			ID:          "graph",
			Label:       "Microsoft Graph",
			Description: "Checking Microsoft Graph mail access...",
		}}
	}
	return []accountConnectionTestService{
		{ID: "imap", Label: "IMAP", Description: "Checking incoming mail access..."},
		{ID: "smtp", Label: "SMTP", Description: "Checking outgoing mail delivery..."},
	}
}

templ AccountConnectionTestStateIcon() {
	<span class="relative block size-5 shrink-0" aria-hidden="true">
		<span class="account-test-state-icon text-muted-foreground" data-account-test-icon="testing">
			@icon.LoaderCircle(icon.Props{Class: "size-5 animate-spin"})
		</span>
		<span class="account-test-state-icon text-emerald-600 dark:text-emerald-400" data-account-test-icon="success">
			@icon.CircleCheck(icon.Props{Class: "size-5"})
		</span>
		<span class="account-test-state-icon text-destructive" data-account-test-icon="error">
			@icon.CircleX(icon.Props{Class: "size-5"})
		</span>
	</span>
}

templ SettingsAccountConnectionTestDialog(account models.Account) {
	{{ dialogID := fmt.Sprintf("test-account-%s", account.ID) }}
	@dialog.Dialog(dialog.Props{ID: dialogID}) {
		@dialog.Content(dialog.ContentProps{Class: "sm:max-w-lg"}) {
			@dialog.Header() {
				@dialog.Title() {
					Test Account Connection
				}
			}
			<div class="flex items-center gap-3 rounded-lg border border-border bg-background/60 p-3" data-account-test-identity>
				<div class="account-color-marker size-5 shrink-0" style={ accountColorStyle(account.Color) } data-account-marker={ account.ID }></div>
				<div class="min-w-0 flex-1">
					<p class="truncate text-sm font-medium">{ account.DisplayLabel() }</p>
					<p class="truncate text-xs text-muted-foreground">{ account.Email }</p>
				</div>
			</div>
			<div class="space-y-3" data-account-test-status aria-live="polite">
				<div class="grid grid-cols-1 gap-3">
					for _, service := range accountConnectionTestServices(account) {
						<div
							class="account-test-service-card flex min-h-[72px] items-center gap-3 rounded-lg border p-3"
							data-account-test-service={ service.ID }
							data-account-test-loading-label={ service.Description }
							data-state="testing"
						>
							@AccountConnectionTestStateIcon()
							<div class="min-w-0 flex-1">
								<p class="text-xs font-semibold text-muted-foreground">{ service.Label }</p>
								<p class="mt-0.5 text-xs font-medium text-foreground" data-account-test-service-status>{ service.Description }</p>
								<p class="mt-0.5 hidden break-words text-xs text-muted-foreground" data-account-test-service-detail></p>
							</div>
						</div>
					}
				</div>
			</div>
			@dialog.Footer() {
				@dialog.Close() {
					<button type="button" class="inline-flex items-center justify-center rounded-lg border border-border px-4 py-2 text-sm font-medium transition-colors hover:bg-accent">
						Close
					</button>
				}
				<button
					type="button"
					class="inline-flex items-center justify-center gap-1.5 rounded-lg border border-border px-4 py-2 text-sm font-medium transition-colors hover:bg-accent disabled:pointer-events-none disabled:opacity-50"
					hx-post={ fmt.Sprintf("/api/accounts/%s/test", account.ID) }
					hx-swap="none"
					data-on-htmx-before-request='["handleAccountTestStart","$event"]'
					data-on-htmx-after-request='["handleAccountTestResult","$event"]'
					data-account-test-dialog={ dialogID }
					data-account-test-retry
					disabled
				>
					@icon.RefreshCw(icon.Props{Class: "size-4"})
					Test Again
				</button>
			}
		}
	}
}

templ SettingsAccountActionsMenu(account models.Account) {
	@dropdown.Dropdown(dropdown.Props{ID: fmt.Sprintf("account-actions-menu-%s", account.ID)}) {
		@dropdown.Trigger() {
			@button.Button(button.Props{
				Variant: button.VariantOutline,
				Size:    button.SizeIcon,
				Class:   "account-action-btn size-[30px] text-muted-foreground hover:text-foreground shadow-none",
				Attributes: templ.Attributes{
					"aria-label": fmt.Sprintf("More actions for %s", account.DisplayLabel()),
				},
			}) {
				@icon.EllipsisVertical(icon.Props{Class: "size-4"})
			}
		}
		@dropdown.Content(dropdown.ContentProps{Placement: dropdown.PlacementBottomEnd, Class: "w-48 normal-case tracking-normal", Attributes: templ.Attributes{"data-account-actions-menu": account.ID}}) {
			@dropdown.Label(dropdown.LabelProps{Class: "text-xs text-muted-foreground"}) {
				Account actions
			}
			@dialog.Trigger(dialog.TriggerProps{For: fmt.Sprintf("test-account-%s", account.ID)}) {
				{{ testDialogID := fmt.Sprintf("test-account-%s", account.ID) }}
				@dropdown.Item(dropdown.ItemProps{
					ID:    fmt.Sprintf("test-btn-%s", account.ID),
					Class: "justify-start gap-2",
					Attributes: templ.Attributes{
						"type":                         "button",
						"data-account-id":              account.ID,
						"data-account-primary-action":  "test",
						"data-account-test-dialog-open": "",
						"data-account-test-dialog":      testDialogID,
						"hx-post":                      fmt.Sprintf("/api/accounts/%s/test", account.ID),
						"hx-swap":                      "none",
						"data-on-htmx-before-request": onAction("handleAccountTestStart", actionEvent),
						"data-on-htmx-after-request": onAction("handleAccountTestResult", actionEvent),
					},
				}) {
					@icon.Wifi(icon.Props{Class: "size-3.5"})
					Test
				}
			}
			if account.Provider == "gmail" {
				@GmailReauthForm(account)
				if account.EmailSyncEnabled {
					@dialog.Trigger(dialog.TriggerProps{For: fmt.Sprintf("repair-account-%s", account.ID)}) {
						@dropdown.Item(dropdown.ItemProps{
							Class: "justify-start gap-2",
							Attributes: templ.Attributes{
								"type":                          "button",
								"data-account-secondary-action": "repair",
								"data-mail-account-sync-button": account.ID,
							},
						}) {
							@icon.Wrench(icon.Props{Class: "size-3.5"})
							Repair
						}
					}
				}
			} else if account.Provider == "outlook" {
				@OutlookReauthForm(account)
			}
			@dropdown.Item(dropdown.ItemProps{
				Class: "justify-start gap-2",
				Attributes: templ.Attributes{
					"type":                "button",
					"data-account-rename": account.ID,
				},
			}) {
				@icon.Pencil(icon.Props{Class: "size-3.5"})
				Rename
			}
			@dropdown.Separator()
			@dialog.Trigger(dialog.TriggerProps{For: fmt.Sprintf("delete-account-%s", account.ID)}) {
				@dropdown.Item(dropdown.ItemProps{
					Class: "justify-start gap-2 text-destructive hover:bg-destructive/10 hover:text-destructive focus:bg-destructive/10 focus:text-destructive",
					Attributes: templ.Attributes{
						"type":                          "button",
						"data-account-secondary-action": "delete",
					},
				}) {
					@icon.Trash2(icon.Props{Class: "size-3.5"})
					Delete
				}
			}
		}
	}
}
	templ AccountServiceIndicator(account models.Account, service string, label string, description string, enabled bool) {
		<div
			title={ description }
			aria-label={ fmt.Sprintf("%s %s. %s", label, serviceStateLabel(enabled), description) }
			class={
				"inline-flex items-center gap-1.5 rounded-md border px-2.5 py-1 text-xs font-medium",
				templ.KV("border-emerald-500/25 bg-emerald-500/10 text-emerald-700 dark:text-emerald-300", enabled),
				templ.KV("border-border bg-muted/35 text-muted-foreground", !enabled),
			}
		>
			if service == "email" {
				@icon.Mail(icon.Props{Class: "size-3"})
			} else if service == "contacts" {
				@icon.Users(icon.Props{Class: "size-3"})
			} else {
				@icon.CalendarDays(icon.Props{Class: "size-3"})
			}
		<span>{ label }</span>
		<span class="text-xs font-semibold opacity-75">{ serviceStateLabel(enabled) }</span>
		</div>
	}

func serviceStateLabel(enabled bool) string {
	if enabled {
		return "On"
	}
	return "Off"
}

func accountContactSyncConfigurable(account models.Account) bool {
	provider := strings.TrimSpace(account.Provider)
	return provider == "gmail" || provider == "outlook" || strings.TrimSpace(account.ContactSyncProvider) != ""
}

func accountContactSyncStatusDescription(account models.Account) string {
	if account.ContactSyncEnabled {
		return "Syncs provider contacts into Raven."
	}
	if accountContactSyncConfigurable(account) {
		return "Not used for contacts."
	}
	return "Contacts not configured."
}

func accountCalendarSyncStatusDescription(account models.Account) string {
	if account.CalendarSyncEnabled {
		return "Shows events from the selected provider calendars."
	}
	return "Calendar not configured."
}

func accountProviderName(provider string) string {
	switch strings.TrimSpace(provider) {
	case "gmail":
		return "Gmail"
	case "outlook":
		return "Outlook"
	default:
		return "IMAP"
	}
}

templ AccountProviderIcon(provider string, class string) {
	if strings.TrimSpace(provider) == "gmail" {
		<svg class={ class } role="img" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg" fill="currentColor">
			<title>Gmail</title>
			<path d="M24 5.457v13.909c0 .904-.732 1.636-1.636 1.636h-3.819V11.73L12 16.64l-6.545-4.91v9.273H1.636A1.636 1.636 0 0 1 0 19.366V5.457c0-2.023 2.309-3.178 3.927-1.964L5.455 4.64 12 9.548l6.545-4.91 1.528-1.145C21.69 2.28 24 3.434 24 5.457Z"/>
		</svg>
	} else if strings.TrimSpace(provider) == "outlook" {
		<svg class={ class } viewBox="0 0 14 14" fill="currentColor" aria-hidden="true">
			<path d="m13 4.69375 0 5.239c0 .115-.04.212-.119.288-.079.077-.176.115-.29.115h-4.2735v-3.4795l.8.6145c.051.0425.1145.063.1895.063.074 0 .1385-.0205.1945-.0635L13 4.69375Zm-4.6825-1.0105h4.2735c.1055 0 .1965.0315.2715.096.075.064.117.15.124.255l-3.6845 2.938-.9845-.7745v-2.5145Zm-.6155-2.251v11.1355L1 11.40975v-8.7875l6.703-1.19-.001 0Zm-2.0245 5.59c-.01-.5665-.1565-1.036-.4395-1.407-.2775-.37-.6375-.5655-1.0655-.582-.412.0165-.7645.2115-1.05.582-.285.371-.4275.841-.435 1.407.0075.5585.1575 1.0235.4425 1.3955.2855.37.637.5665 1.0505.588.4275-.0175.787-.212 1.0725-.585.285-.374.435-.84.4425-1.3985h-.018Zm-1.56-1.241c.2155.01.397.128.5415.3585.1425.2305.2175.5225.2175.876 0 .3605-.0745.6535-.2175.8855-.1505.232-.33.352-.548.352-.218 0-.3975-.113-.5475-.345-.15-.232-.2175-.525-.2175-.877 0-.3525.0675-.6455.2175-.87.142-.225.323-.345.5405-.3605l.0135-.0195Z"/>
		</svg>
	} else {
		@icon.Mail(icon.Props{Class: class})
	}
}

templ AccountColorPopover(account models.Account) {
	@popover.Root(popover.RootProps{ID: fmt.Sprintf("account-color-%s", account.ID), Class: "shrink-0"}) {
		@popover.Trigger() {
			<button
				type="button"
				class="account-color-marker size-5 shrink-0 cursor-pointer ring-2 ring-transparent ring-offset-2 ring-offset-background transition-[box-shadow,filter] hover:brightness-110 hover:ring-border focus-visible:outline-none focus-visible:ring-ring"
				style={ accountColorStyle(account.Color) }
				data-account-marker={ account.ID }
				aria-label={ fmt.Sprintf("Change marker color for %s", account.DisplayLabel()) }
			></button>
		}
		@popover.Content(popover.ContentProps{Placement: popover.PlacementBottomStart, ShowArrow: true, Class: "w-64"}) {
			<div class="p-3" data-account-color-picker data-account-id={ account.ID }>
				<div class="mb-3 flex items-start justify-between gap-3">
					<div class="min-w-0">
						<p class="text-xs font-semibold text-muted-foreground">Marker color</p>
						<p class="mt-0.5 truncate text-sm font-medium text-popover-foreground">{ account.DisplayLabel() }</p>
					</div>
					<div class="account-color-marker size-6 shrink-0" style={ accountColorStyle(account.Color) } data-account-marker={ account.ID }></div>
				</div>
				<div class="grid grid-cols-6 gap-2">
					for _, color := range accountColorOptions() {
						<button
							type="button"
							class="account-color-swatch size-7 rounded-full transition-transform hover:scale-110 focus-visible:outline-none"
							style={ accountColorStyle(color) }
							data-account-color-option={ color }
							data-account-color-active={ fmt.Sprintf("%t", accountColorSelected(account.Color, color)) }
							aria-label={ fmt.Sprintf("Use %s", color) }
							aria-pressed={ fmt.Sprintf("%t", accountColorSelected(account.Color, color)) }
						></button>
					}
				</div>
				<div class="mt-3 flex items-center gap-2 rounded-md border border-border/70 bg-background/50 px-2.5 py-2">
					<label for={ fmt.Sprintf("account-color-custom-%s", account.ID) } class="text-xs font-medium text-muted-foreground">Custom</label>
					<input
						id={ fmt.Sprintf("account-color-custom-%s", account.ID) }
						type="color"
						value={ accountColorValue(account.Color) }
						class="h-7 w-9 cursor-pointer rounded border border-border bg-transparent p-0.5"
						data-account-color-custom
					/>
					<span class="ml-auto text-xs text-muted-foreground" data-account-color-status></span>
					</div>
				</div>
			}
		}
}

templ AccountSignaturesSettings(accounts []models.AccountSignatureData) {
	<div class="settings-card bg-card rounded-lg border p-6">
		<div class="flex flex-col gap-4 sm:flex-row sm:items-center sm:justify-between">
			<div class="min-w-0">
				<h3 class="text-sm font-semibold text-muted-foreground mb-1">Signatures</h3>
				<p class="text-xs text-muted-foreground">Create reusable signatures and choose which accounts use them for new messages, replies, and forwards.</p>
				<div class="mt-3 flex flex-wrap gap-2 text-xs text-muted-foreground">
					<span class="inline-flex items-center gap-1.5 rounded-md border border-border bg-background px-2 py-1">
						@icon.Signature(icon.Props{Class: "size-3"})
						{ strconv.Itoa(signatureTotal(accounts)) } total
					</span>
				</div>
			</div>
			@dialog.Trigger(dialog.TriggerProps{For: "compose-signatures-dialog"}) {
				<button type="button" class="bg-primary text-primary-foreground hover:bg-primary/90 disabled:cursor-not-allowed disabled:opacity-60 transition-colors inline-flex shrink-0 items-center justify-center gap-1.5 rounded-lg px-4 py-2 text-sm font-semibold">
					@icon.Signature(icon.Props{Class: "size-4"})
					Manage Signatures
				</button>
			}
		</div>
	</div>
	<div id="compose-signatures-dialog-container">
		@ComposeSignaturesDialog(accounts)
	</div>
}

templ ComposeSignaturesDialog(accounts []models.AccountSignatureData) {
	@dialog.Dialog(dialog.Props{ID: "compose-signatures-dialog"}) {
		@dialog.Content(dialog.ContentProps{Class: "sm:max-w-5xl max-h-[calc(100vh-2rem)] overflow-y-auto overflow-x-hidden"}) {
			@dialog.Header() {
				@dialog.Title() {
					Signatures
				}
				@dialog.Description() {
					Manage your reusable signatures and account assignments.
				}
			}
			@ComposeSignaturesManager(accounts)
		}
	}
}

templ ComposeSignaturesManager(accounts []models.AccountSignatureData) {
	<div id="compose-signatures-manager" class="min-w-0" data-account-signatures-manager data-refresh-url="/api/settings/signatures/manage" data-refresh-target="#compose-signatures-manager" data-refresh-swap="outerHTML">
		@SignatureManagerGrid(accounts)
	</div>
}

templ SignatureManagerGrid(accounts []models.AccountSignatureData) {
	if len(accounts) == 0 {
		<div class="rounded-lg border border-dashed border-border p-6 text-center text-sm text-muted-foreground">Add an account before configuring signatures.</div>
	} else {
		{{ first := accounts[0] }}
		<div class="grid min-w-0 gap-5 lg:grid-cols-[minmax(0,1.1fr)_minmax(0,0.9fr)]">
			<div class="min-w-0 space-y-4">
				@SignatureLibrary(first)
			</div>
			<div class="min-w-0 rounded-lg border border-border bg-background/60 p-4 space-y-4">
				<div class="space-y-2">
					<label class="text-xs font-semibold text-muted-foreground">Account</label>
					@selectbox.SelectBox(selectbox.Props{Class: "settings-select"}) {
						@selectbox.Trigger(selectbox.TriggerProps{Name: "signature_account_id", Class: "bg-background", DisableClear: true, Attributes: templ.Attributes{"data-signature-account-select": ""}}) {
							<span class="flex min-w-0 flex-1 items-center gap-2">
								<span class="account-color-marker size-3.5 shrink-0" style={ accountColorStyle(first.Account.Color) } data-signature-account-marker data-account-marker={ first.Account.ID }></span>
								@selectbox.Value(selectbox.ValueProps{Placeholder: "Choose account", Class: "min-w-0 text-left"}) {
									{ first.Account.DisplayLabel() } &lt;{ first.Account.Email }&gt;
								}
							</span>
						}
						@selectbox.Content(selectbox.ContentProps{NoSearch: true}) {
							for _, data := range accounts {
								@selectbox.Item(selectbox.ItemProps{Value: data.Account.ID, Selected: data.Account.ID == first.Account.ID}) {
									<span class="inline-flex min-w-0 items-center gap-2">
										<span class="account-color-marker size-3.5 shrink-0" style={ accountColorStyle(data.Account.Color) } data-signature-account-marker-source data-account-marker={ data.Account.ID }></span>
										<span class="truncate">{ data.Account.DisplayLabel() } &lt;{ data.Account.Email }&gt;</span>
									</span>
								}
							}
						}
					}
				</div>
				<div class="grid" data-signature-account-panels>
					for _, data := range accounts {
						<form class={ "col-start-1 row-start-1 space-y-4", templ.KV("invisible pointer-events-none", data.Account.ID != first.Account.ID) } data-account-signature-settings data-account-id={ data.Account.ID } aria-hidden={ strconv.FormatBool(data.Account.ID != first.Account.ID) }>
							@AccountSignatureAssignmentRow("new", "New messages", data.Settings.NewEnabled, data.Settings.NewSignatureID, "", data.Signatures)
							@AccountSignatureAssignmentRow("reply", "Replies", data.Settings.ReplyEnabled, data.Settings.ReplySignatureID, data.Settings.ReplyPlacement, data.Signatures)
							@AccountSignatureAssignmentRow("forward", "Forwards", data.Settings.ForwardEnabled, data.Settings.ForwardSignatureID, data.Settings.ForwardPlacement, data.Signatures)
							<div class="flex items-center justify-between gap-3 pt-1">
								<span class="text-xs text-muted-foreground" data-signature-settings-status></span>
								<button type="submit" class="bg-primary text-primary-foreground hover:bg-primary/90 disabled:cursor-not-allowed disabled:opacity-60 transition-colors inline-flex items-center gap-1.5 rounded-lg px-3 py-1.5 text-sm font-semibold">
									@icon.Check(icon.Props{Class: "size-3.5"})
									Save
								</button>
							</div>
						</form>
					}
				</div>
			</div>
		</div>
	}
}

templ SignatureLibrary(data models.AccountSignatureData) {
	<div class="min-w-0 rounded-lg border border-border bg-background/60 p-4 space-y-3">
		<div class="flex items-center justify-between gap-3">
			<div>
				<h4 class="text-xs font-semibold text-muted-foreground">Signature library</h4>
				<p class="text-xs text-muted-foreground mt-1">These signatures can be assigned to any account.</p>
			</div>
		</div>
		<div class="flex items-end gap-2">
			<div class="min-w-0 flex-1 space-y-1.5">
				<label class="text-xs font-medium text-muted-foreground">Saved signatures</label>
				@selectbox.SelectBox(selectbox.Props{Class: "settings-select"}) {
					@selectbox.Trigger(selectbox.TriggerProps{Name: "signature_picker_id", Class: "bg-background", DisableClear: true, Attributes: templ.Attributes{"data-signature-select": ""}}) {
						@selectbox.Value(selectbox.ValueProps{Placeholder: "Select signature"})
					}
					@selectbox.Content(selectbox.ContentProps{NoSearch: true}) {
						if len(data.Signatures) == 0 {
							@selectbox.Item(selectbox.ItemProps{Value: "", Selected: true, Disabled: true}) { No signatures yet }
						} else {
							@selectbox.Item(selectbox.ItemProps{Value: "", Selected: true}) { Select signature }
							for _, sig := range data.Signatures {
								@selectbox.Item(selectbox.ItemProps{Value: sig.ID, Attributes: templ.Attributes{"data-signature-option": "", "data-signature-name": sig.Name, "data-signature-html": sig.HTMLBody}}) { { sig.Name } }
							}
						}
					}
				}
			</div>
			<button type="button" class="inline-flex h-9 shrink-0 items-center gap-1.5 rounded-md border border-border px-2.5 text-xs text-muted-foreground hover:bg-accent hover:text-foreground" data-signature-new>
				@icon.Plus(icon.Props{Class: "size-3.5"})
				New
			</button>
		</div>
		<form data-signature-form class="space-y-3">
			<input type="hidden" name="id" value="" data-signature-id/>
			<div>
				<label class="text-xs font-medium text-muted-foreground mb-1.5 block">Name</label>
				@input.Input(input.Props{Name: "name", Type: input.TypeText, Placeholder: "Work, Personal, Support...", Attributes: templ.Attributes{"data-signature-name": ""}})
			</div>
			<div>
				<div class="mb-1.5 flex items-center justify-between gap-3">
					<label class="text-xs font-medium text-muted-foreground">Signature</label>
					<div class="inline-flex shrink-0 rounded-[var(--radius)] border border-border bg-background p-0.5 text-xs" data-signature-editor-mode>
						<button type="button" class="rounded-[calc(var(--radius)-2px)] px-2 py-0.5 font-medium text-foreground bg-card shadow-sm" data-signature-mode-button="visual">Rendered</button>
						<button type="button" class="rounded-[calc(var(--radius)-2px)] px-2 py-0.5 font-medium text-muted-foreground hover:text-foreground" data-signature-mode-button="source">HTML</button>
					</div>
				</div>
				<textarea name="html_body" class="hidden" data-signature-html></textarea>
				<div class="min-h-28 max-w-full overflow-x-auto rounded-md border border-border bg-card px-3 py-2 text-sm leading-6 outline-none focus:ring-2 focus:ring-ring" contenteditable="true" role="textbox" data-signature-editor data-placeholder="Write your signature..." data-on-input='["syncSignatureEditor","$this"]'></div>
				<textarea class="hidden min-h-28 w-full resize-y rounded-md border border-border bg-card px-3 py-2 font-mono text-xs leading-5 text-foreground outline-none focus:ring-2 focus:ring-ring" spellcheck="false" placeholder="Paste full HTML here, then switch back to Rendered to preview it." data-signature-source></textarea>
				<p class="text-xs text-muted-foreground mt-1">Use Rendered for normal editing or HTML to paste source. Unsafe tags are stripped when rendered and saved.</p>
			</div>
			<div class="flex items-center justify-between gap-3">
				<span class="text-xs text-muted-foreground" data-signature-save-status></span>
				<div class="flex items-center gap-2">
					<button type="button" class="inline-flex items-center gap-1.5 rounded-md border border-border px-2.5 py-1.5 text-xs text-muted-foreground hover:border-destructive/30 hover:text-destructive" data-signature-delete-current>Delete</button>
					<button type="submit" class="bg-primary text-primary-foreground hover:bg-primary/90 disabled:cursor-not-allowed disabled:opacity-60 transition-colors inline-flex items-center gap-1.5 rounded-lg px-3 py-1.5 text-sm font-semibold">
						@icon.Save(icon.Props{Class: "size-3.5"})
						Save Signature
					</button>
				</div>
			</div>
		</form>
	</div>
}

templ AccountSignaturesDialog(data models.AccountSignatureData) {
	@dialog.Dialog(dialog.Props{ID: "account-signatures-dialog"}) {
		@dialog.Content(dialog.ContentProps{Class: "sm:max-w-3xl"}) {
			@dialog.Header() {
				@dialog.Title() {
					Account Signatures
				}
				@dialog.Description() {
					Manage shared signatures and choose when { data.Account.Email } uses them.
				}
			}
			<div class="grid min-w-0 gap-5 lg:grid-cols-[minmax(0,1.1fr)_minmax(0,0.9fr)]" data-account-signatures-manager data-account-id={ data.Account.ID }>
				<div class="min-w-0 space-y-4">
					<div class="min-w-0 rounded-lg border border-border bg-background/60 p-4 space-y-3">
						<div class="flex items-center justify-between gap-3">
							<div>
								<h3 class="text-xs font-semibold text-muted-foreground">Signature library</h3>
								<p class="text-xs text-muted-foreground mt-1">Create reusable signatures that any account can use.</p>
							</div>
						</div>
						<div class="flex items-end gap-2">
							<div class="min-w-0 flex-1 space-y-1.5">
								<label class="text-xs font-medium text-muted-foreground">Saved signatures</label>
								@selectbox.SelectBox(selectbox.Props{Class: "settings-select"}) {
									@selectbox.Trigger(selectbox.TriggerProps{Name: "signature_picker_id", Class: "bg-background", DisableClear: true, Attributes: templ.Attributes{"data-signature-select": ""}}) {
										@selectbox.Value(selectbox.ValueProps{Placeholder: "Select signature"})
									}
									@selectbox.Content(selectbox.ContentProps{NoSearch: true}) {
										if len(data.Signatures) == 0 {
											@selectbox.Item(selectbox.ItemProps{Value: "", Selected: true, Disabled: true}) { No signatures yet }
										} else {
											@selectbox.Item(selectbox.ItemProps{Value: "", Selected: true}) { Select signature }
											for _, sig := range data.Signatures {
												@selectbox.Item(selectbox.ItemProps{Value: sig.ID, Attributes: templ.Attributes{"data-signature-option": "", "data-signature-name": sig.Name, "data-signature-html": sig.HTMLBody}}) { { sig.Name } }
											}
										}
									}
								}
							</div>
							<button type="button" class="inline-flex h-9 shrink-0 items-center gap-1.5 rounded-md border border-border px-2.5 text-xs text-muted-foreground hover:bg-accent hover:text-foreground" data-signature-new>
								@icon.Plus(icon.Props{Class: "size-3.5"})
								New
							</button>
						</div>
						<form data-signature-form class="space-y-3">
							<input type="hidden" name="id" value="" data-signature-id/>
							<div>
								<label class="text-xs font-medium text-muted-foreground mb-1.5 block">Name</label>
								@input.Input(input.Props{Name: "name", Type: input.TypeText, Placeholder: "Work, Personal, Support...", Attributes: templ.Attributes{"data-signature-name": ""}})
							</div>
							<div>
								<div class="mb-1.5 flex items-center justify-between gap-3">
									<label class="text-xs font-medium text-muted-foreground">Signature</label>
									<div class="inline-flex shrink-0 rounded-[var(--radius)] border border-border bg-background p-0.5 text-xs" data-signature-editor-mode>
										<button type="button" class="rounded-[calc(var(--radius)-2px)] px-2 py-0.5 font-medium text-foreground bg-card shadow-sm" data-signature-mode-button="visual">Rendered</button>
										<button type="button" class="rounded-[calc(var(--radius)-2px)] px-2 py-0.5 font-medium text-muted-foreground hover:text-foreground" data-signature-mode-button="source">HTML</button>
									</div>
								</div>
								<textarea name="html_body" class="hidden" data-signature-html></textarea>
								<div class="min-h-28 max-w-full overflow-x-auto rounded-md border border-border bg-card px-3 py-2 text-sm leading-6 outline-none focus:ring-2 focus:ring-ring" contenteditable="true" role="textbox" data-signature-editor data-placeholder="Write your signature..." data-on-input='["syncSignatureEditor","$this"]'></div>
								<textarea class="hidden min-h-28 w-full resize-y rounded-md border border-border bg-card px-3 py-2 font-mono text-xs leading-5 text-foreground outline-none focus:ring-2 focus:ring-ring" spellcheck="false" placeholder="Paste full HTML here, then switch back to Rendered to preview it." data-signature-source></textarea>
								<p class="text-xs text-muted-foreground mt-1">Use Rendered for normal editing or HTML to paste source. Unsafe tags are stripped when rendered and saved.</p>
							</div>
							<div class="flex items-center justify-between gap-3">
								<span class="text-xs text-muted-foreground" data-signature-save-status></span>
								<div class="flex items-center gap-2">
									<button type="button" class="inline-flex items-center gap-1.5 rounded-md border border-border px-2.5 py-1.5 text-xs text-muted-foreground hover:border-destructive/30 hover:text-destructive" data-signature-delete-current>Delete</button>
									<button type="submit" class="bg-primary text-primary-foreground hover:bg-primary/90 disabled:cursor-not-allowed disabled:opacity-60 transition-colors inline-flex items-center gap-1.5 rounded-lg px-3 py-1.5 text-sm font-semibold">
										@icon.Save(icon.Props{Class: "size-3.5"})
										Save Signature
									</button>
								</div>
							</div>
						</form>
					</div>
				</div>

				<form class="rounded-lg border border-border bg-background/60 p-4 space-y-4" data-account-signature-settings>
					<div>
						<h3 class="text-xs font-semibold text-muted-foreground">Use on this account</h3>
						<p class="text-xs text-muted-foreground mt-1">Choose when signatures are automatically inserted.</p>
					</div>
					@AccountSignatureAssignmentRow("new", "New messages", data.Settings.NewEnabled, data.Settings.NewSignatureID, "", data.Signatures)
					@AccountSignatureAssignmentRow("reply", "Replies", data.Settings.ReplyEnabled, data.Settings.ReplySignatureID, data.Settings.ReplyPlacement, data.Signatures)
					@AccountSignatureAssignmentRow("forward", "Forwards", data.Settings.ForwardEnabled, data.Settings.ForwardSignatureID, data.Settings.ForwardPlacement, data.Signatures)
					<div class="flex items-center justify-between gap-3 pt-2">
						<span class="text-xs text-muted-foreground" data-signature-settings-status></span>
						<button type="submit" class="bg-primary text-primary-foreground hover:bg-primary/90 disabled:cursor-not-allowed disabled:opacity-60 transition-colors inline-flex items-center gap-1.5 rounded-lg px-3 py-1.5 text-sm font-semibold">
							@icon.Check(icon.Props{Class: "size-3.5"})
							Save Assignments
						</button>
					</div>
				</form>
			</div>
		}
	}
}

templ AccountSignatureAssignmentRow(kind string, label string, enabled bool, selectedID string, placement string, signatures []models.Signature) {
	<div class="rounded-md border border-border/70 bg-card/60 p-3 space-y-2">
		<label class="flex items-center gap-2 text-sm font-medium text-foreground">
			@checkbox.Checkbox(checkbox.Props{Name: kind + "_enabled", Value: "true", Checked: enabled})
			{ label }
		</label>
		@selectbox.SelectBox(selectbox.Props{Class: "settings-select"}) {
			@selectbox.Trigger(selectbox.TriggerProps{Name: kind + "_signature_id", Class: "bg-background"}) {
				@selectbox.Value(selectbox.ValueProps{Placeholder: "No signature"}) {
					{ signatureName(signatures, selectedID) }
				}
			}
			@selectbox.Content(selectbox.ContentProps{NoSearch: true}) {
				@selectbox.Item(selectbox.ItemProps{Value: "", Selected: selectedID == ""}) { No signature }
				for _, sig := range signatures {
					@selectbox.Item(selectbox.ItemProps{Value: sig.ID, Selected: selectedID == sig.ID}) { { sig.Name } }
				}
			}
		}
		if kind != "new" {
			<div class="grid gap-1.5">
				<label class="text-xs font-medium text-muted-foreground">Place signature</label>
				@selectbox.SelectBox(selectbox.Props{Class: "settings-select"}) {
					@selectbox.Trigger(selectbox.TriggerProps{Name: kind + "_placement", Class: "bg-background", DisableClear: true}) {
						@selectbox.Value(selectbox.ValueProps{Placeholder: "Before quoted content"}) {
							if placement == "after" {
								After quoted content
							} else {
								Before quoted content
							}
						}
					}
					@selectbox.Content(selectbox.ContentProps{NoSearch: true}) {
						@selectbox.Item(selectbox.ItemProps{Value: "before", Selected: placement != "after"}) { Before quoted content }
						@selectbox.Item(selectbox.ItemProps{Value: "after", Selected: placement == "after"}) { After quoted content }
					}
				}
			</div>
		}
	</div>
}

templ ChooseAccountTypeDialog() {
	{{ oauth := mailboxOAuthFrom(ctx) }}
	@dialog.Dialog(dialog.Props{ID: "choose-account-type-dialog"}) {
		@dialog.Content(dialog.ContentProps{Class: "sm:max-w-md"}) {
			@dialog.Header() {
				@dialog.Title() {
					Add Account
				}
				@dialog.Description() {
					Choose your email provider
				}
			}
		<div class="space-y-3 px-1 pt-2 pb-4">
				<button type="button" data-on-click='["ravenSwitchDialog","choose-account-type-dialog","openAddAccountDialog"]' class="w-full group flex items-center gap-4 p-4 rounded-lg border border-border hover:border-primary/50 hover:bg-accent/50 transition-all duration-200 text-left">
					<div class="flex items-center justify-center w-10 h-10 rounded-lg bg-accent text-muted-foreground group-hover:text-foreground transition-colors">
						@AccountProviderIcon("imap", "size-5")
					</div>
					<div class="flex-1 min-w-0">
						<div class="text-sm font-medium text-foreground">IMAP / SMTP</div>
						<div class="text-xs text-muted-foreground mt-0.5">Any provider with manual server settings</div>
					</div>
					<svg class="size-4 text-muted-foreground group-hover:text-foreground transition-colors" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m9 18 6-6-6-6"/></svg>
				</button>
				<button type="button" data-account-type="icloud" data-on-click='["ravenSwitchDialog","choose-account-type-dialog","openICloudAccountDialog"]' class="w-full group flex items-center gap-4 p-4 rounded-lg border border-border hover:border-primary/50 hover:bg-accent/50 transition-all duration-200 text-left">
					<div class="flex items-center justify-center w-10 h-10 rounded-lg bg-accent text-muted-foreground group-hover:text-foreground transition-colors">
						@AccountProviderIcon("imap", "size-5")
					</div>
					<div class="flex-1 min-w-0">
						<div class="text-sm font-medium text-foreground">iCloud</div>
						<div class="text-xs text-muted-foreground mt-0.5">iCloud Mail with an app-specific password</div>
					</div>
					<svg class="size-4 text-muted-foreground group-hover:text-foreground transition-colors" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m9 18 6-6-6-6"/></svg>
				</button>
				if oauth.google {
					<button type="button" data-on-click='["ravenSwitchDialog","choose-account-type-dialog","gmail-account-dialog"]' class="w-full group flex items-center gap-4 p-4 rounded-lg border border-border hover:border-primary/50 hover:bg-accent/50 transition-all duration-200 text-left">
						<div class="flex items-center justify-center w-10 h-10 rounded-lg bg-accent text-muted-foreground group-hover:text-foreground transition-colors">
							@AccountProviderIcon("gmail", "size-5")
						</div>
						<div class="flex-1 min-w-0">
							<div class="text-sm font-medium text-foreground">Gmail</div>
							<div class="text-xs text-muted-foreground mt-0.5">Sign in with Google for instant setup</div>
						</div>
						<svg class="size-4 text-muted-foreground group-hover:text-foreground transition-colors" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m9 18 6-6-6-6"/></svg>
					</button>
				} else {
					<p class="text-xs text-muted-foreground px-1">Google sign-in isn't set up on this Raven.</p>
				}
				if oauth.microsoft {
					<button type="button" data-on-click='["ravenSwitchDialog","choose-account-type-dialog","outlook-account-dialog"]' class="w-full group flex items-center gap-4 p-4 rounded-lg border border-border hover:border-primary/50 hover:bg-accent/50 transition-all duration-200 text-left">
						<div class="flex items-center justify-center w-10 h-10 rounded-lg bg-accent text-muted-foreground group-hover:text-foreground transition-colors">
							@AccountProviderIcon("outlook", "size-5")
						</div>
						<div class="flex-1 min-w-0">
							<div class="text-sm font-medium text-foreground">Outlook</div>
							<div class="text-xs text-muted-foreground mt-0.5">Sign in with Microsoft for instant setup</div>
						</div>
						<svg class="size-4 text-muted-foreground group-hover:text-foreground transition-colors" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m9 18 6-6-6-6"/></svg>
					</button>
				} else {
					<p class="text-xs text-muted-foreground px-1">Microsoft sign-in isn't set up on this Raven.</p>
				}
			</div>
		}
	}
}

templ GmailAccountDialog() {
	@dialog.Dialog(dialog.Props{ID: "gmail-account-dialog"}) {
		@dialog.Content(dialog.ContentProps{Class: "sm:max-w-sm"}) {
			@dialog.Header() {
				@dialog.Title() {
					Connect Gmail
				}
				@dialog.Description() {
					Authorize Raven to access your Gmail account
				}
			}
			<form id="gmail-form" method="POST" action="/api/accounts/oauth2/authorize" class="px-1 pt-2 pb-4 space-y-4">
				<input type="hidden" name="flow_action" value="add"/>
				<div>
					<label class="text-xs font-medium text-muted-foreground mb-1.5 block">Email Address</label>
					@input.Input(input.Props{
						Name:        "email_address",
						Type:        input.TypeEmail,
						Placeholder: "you@gmail.com",
						Required:    true,
					})
				</div>
				<div>
					<label class="text-xs font-medium text-muted-foreground mb-1.5 block">Display Name</label>
					@input.Input(input.Props{
						Name:        "display_name",
						Type:        input.TypeText,
						Placeholder: "Your Name",
					})
				</div>
				<input type="hidden" name="imap_host" value="imap.gmail.com"/>
				<input type="hidden" name="imap_port" value="993"/>
				<input type="hidden" name="imap_tls_mode" value="tls"/>
				<input type="hidden" name="smtp_host" value="smtp.gmail.com"/>
				<input type="hidden" name="smtp_port" value="465"/>
				<input type="hidden" name="smtp_tls_mode" value="tls"/>
				<input type="hidden" name="auth_method" value="oauth2"/>
				<input type="hidden" name="provider" value="gmail"/>
				<input type="hidden" name="username" value=""/>
				<input type="hidden" name="password" value="_oauth2_"/>
				<hr class="border-border"/>
				<div class="rounded-lg bg-accent/50 border border-border p-3">
					<div class="flex items-start gap-2.5">
						<svg class="size-4 text-muted-foreground mt-0.5 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><path d="M12 16v-4"/><path d="M12 8h.01"/></svg>
						<p class="text-xs text-muted-foreground leading-relaxed">You will be redirected to Google to grant Raven access to read and send email, contacts, and read-only calendar data on your behalf.</p>
					</div>
				</div>
				<button type="submit" class="w-full inline-flex items-center justify-center gap-2.5 text-sm font-medium px-4 py-2.5 rounded-lg bg-primary text-primary-foreground hover:bg-primary/90 transition-colors">
					@AccountProviderIcon("gmail", "size-4 shrink-0")
					Continue with Google
				</button>
			</form>
		}
	}
}

templ OutlookAccountDialog() {
	@dialog.Dialog(dialog.Props{ID: "outlook-account-dialog"}) {
		@dialog.Content(dialog.ContentProps{Class: "sm:max-w-sm"}) {
			@dialog.Header() {
				@dialog.Title() {
					Connect Outlook
				}
				@dialog.Description() {
					Authorize Raven to access your Microsoft mailbox
				}
			}
			<form id="outlook-form" method="POST" action="/api/accounts/oauth2/authorize" class="px-1 pt-2 pb-4 space-y-4">
				<input type="hidden" name="flow_action" value="add"/>
				<div>
					<label class="text-xs font-medium text-muted-foreground mb-1.5 block">Email Address</label>
					@input.Input(input.Props{
						Name:        "email_address",
						Type:        input.TypeEmail,
						Placeholder: "you@outlook.com",
						Required:    true,
					})
				</div>
				<div>
					<label class="text-xs font-medium text-muted-foreground mb-1.5 block">Display Name</label>
					@input.Input(input.Props{
						Name:        "display_name",
						Type:        input.TypeText,
						Placeholder: "Your Name",
					})
				</div>
				<input type="hidden" name="provider" value="outlook"/>
				<hr class="border-border"/>
				<div class="rounded-lg bg-accent/50 border border-border p-3">
					<div class="flex items-start gap-2.5">
						<svg class="size-4 text-muted-foreground mt-0.5 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><path d="M12 16v-4"/><path d="M12 8h.01"/></svg>
						<p class="text-xs text-muted-foreground leading-relaxed">You will be redirected to Microsoft to grant Raven Microsoft Graph access for reading, organizing, and sending email.</p>
					</div>
				</div>
				<button type="submit" class="w-full inline-flex items-center justify-center gap-2.5 text-sm font-medium px-4 py-2.5 rounded-lg bg-primary text-primary-foreground hover:bg-primary/90 transition-colors">
					@AccountProviderIcon("outlook", "size-4 shrink-0")
					Continue with Microsoft
				</button>
			</form>
		}
	}
}

// AddAccountDialog is the page-resident slot for the add-account wizard. The
// wizard itself (~55 KB of markup) is fetched from /ui/add-account-dialog the
// first time it is opened, by openAddAccountDialog in account-wizard.js.
templ AddAccountDialog() {
	<div id="add-account-dialog-slot"></div>
}

templ AddAccountDialogContent() {
	@dialog.Dialog(dialog.Props{ID: "add-account-dialog"}) {
		@dialog.Trigger() {
			<span></span>
		}
		@dialog.Content(dialog.ContentProps{Class: "account-wizard-dialog sm:max-w-4xl"}) {
			@dialog.Header() {
				@dialog.Title() {
					Add Account
				}
				@dialog.Description() {
					Connect mail first, then optionally configure contacts and calendar.
				}
			}
			@selectbox.Script()
			<div class="account-wizard-shell grid gap-4 pt-2 md:grid-cols-[14.5rem_minmax(0,1fr)]">
		@AccountWizardAddSidebar()
				<div id="wizard-viewport" class="account-wizard-viewport">
					<div id="wizard-track" class="flex items-start transition-transform duration-300 ease-in-out" style="width: 600%">
						<form id="account-form" hx-post="/api/accounts" hx-target="#add-contacts-content" hx-swap="innerHTML" class="contents">
						<div class="w-1/6 shrink-0 px-1" data-wizard-step="0">
							<div class="account-wizard-panel">
							<div class="account-wizard-scroll" data-wizard-service-content="email">
							<h4 class="account-wizard-sticky-header text-sm font-semibold text-foreground flex items-center gap-2">
								@icon.User(icon.Props{Class: "size-4 text-muted-foreground"})
								Account details
							</h4>
							<div class="space-y-4">
								<div>
									<label class="text-xs font-medium text-muted-foreground mb-1.5 block">Email Address</label>
									@input.Input(input.Props{
										Name:        "email_address",
										Type:        input.TypeEmail,
										Placeholder: "you@example.com",
										Required:    true,
									})
								</div>
								<div>
									<label class="text-xs font-medium text-muted-foreground mb-1.5 block">Display Name</label>
									@input.Input(input.Props{
										Name:        "display_name",
										Type:        input.TypeText,
										Placeholder: "Your Name",
									})
								</div>
								<div class="rounded-lg border border-border bg-background/45 p-3">
									<div class="flex flex-col gap-3 sm:flex-row sm:items-center sm:justify-between">
										<div class="min-w-0">
											<div class="text-xs font-semibold text-foreground">Automatic settings</div>
											<p class="mt-0.5 text-xs leading-relaxed text-muted-foreground">Fill IMAP and SMTP fields from provider records when available.</p>
										</div>
										<button type="button" data-on-click='["discoverMailSettings","$this"]' class="inline-flex shrink-0 items-center justify-center gap-1.5 rounded-md border border-border px-3 py-2 text-xs font-semibold text-foreground transition-colors hover:bg-accent disabled:pointer-events-none disabled:opacity-60">
											@icon.Radar(icon.Props{Class: "size-3.5"})
											<span data-mail-discovery-label>Discover settings</span>
										</button>
									</div>
									<div id="mail-discovery-status" class="mt-3"></div>
								</div>
							</div>
							</div>
							<div class="account-wizard-controls flex justify-end">
								<button type="button" data-on-click='["wizardGo",1]' class="inline-flex items-center gap-1.5 text-sm font-medium px-4 py-2 rounded-lg bg-primary text-primary-foreground hover:bg-primary/90 transition-colors">
									Next
									@icon.ChevronRight(icon.Props{Class: "size-4"})
								</button>
							</div>
							</div>
						</div>

						<div class="w-1/6 shrink-0 px-1" data-wizard-step="1">
							<div class="account-wizard-panel">
							<div class="account-wizard-scroll" data-wizard-service-content="email">
							<h4 class="account-wizard-sticky-header text-sm font-semibold text-foreground flex items-center gap-2">
								@icon.Inbox(icon.Props{Class: "size-4 text-muted-foreground"})
								Incoming Mail
								<span class="text-xs font-normal text-muted-foreground">(IMAP)</span>
							</h4>
							<div class="grid grid-cols-2 gap-3">
								<div class="col-span-2">
									<label class="text-xs font-medium text-muted-foreground mb-1.5 block">IMAP Host</label>
									@input.Input(input.Props{
										Name:        "imap_host",
										Type:        input.TypeText,
										Placeholder: "imap.example.com",
										Required:    true,
									})
									<div data-server-check="imap" class="mt-1.5 hidden space-y-1" aria-live="polite"></div>
								</div>
								<div>
									<label class="text-xs font-medium text-muted-foreground mb-1.5 block">Port</label>
									@input.Input(input.Props{
										Name:        "imap_port",
										Type:        input.TypeNumber,
										Placeholder: "993",
										Value:       "993",
									})
								</div>
					<div>
						<label class="text-xs font-medium text-muted-foreground mb-1.5 flex items-center gap-1.5">
							<span>Encryption</span>
							@UnencryptedTransportWarning("add-imap-unencrypted-warning", false)
						</label>
						@selectbox.SelectBox() {
							@selectbox.Trigger(selectbox.TriggerProps{Name: "imap_tls_mode", DisableClear: true, Attributes: templ.Attributes{"data-on-change": onAction("toggleUnencryptedTransportWarning", actionElement)}}) {
								@selectbox.Value(selectbox.ValueProps{Placeholder: "TLS"}) { TLS }
							}
									@selectbox.Content(selectbox.ContentProps{NoSearch: true}) {
										@selectbox.Item(selectbox.ItemProps{Value: "tls", Selected: true}) { TLS }
										@selectbox.Item(selectbox.ItemProps{Value: "starttls"}) { STARTTLS }
										@selectbox.Item(selectbox.ItemProps{Value: "plaintext"}) { Unencrypted (admin exception) }
							}
						}
					</div>
							</div>
							<hr class="my-4 border-border"/>
							<h4 class="text-sm font-semibold text-foreground flex items-center gap-2 mb-4">
								@icon.Key(icon.Props{Class: "size-4 text-muted-foreground"})
								Login
							</h4>
							<div class="grid grid-cols-2 gap-3">
								<div class="col-span-2">
									<label class="text-xs font-medium text-muted-foreground mb-1.5 block">Username</label>
									@input.Input(input.Props{
										Name:        "username",
										Type:        input.TypeText,
										Placeholder: "you@example.com",
										Required:    true,
									})
								</div>
								<div class="col-span-2">
									<label class="text-xs font-medium text-muted-foreground mb-1.5 block">Password</label>
									@input.Input(input.Props{
										Name:        "password",
										Type:        input.TypePassword,
										Placeholder: "••••••••",
										Required:    true,
									})
									<p id="icloud-password-hint" class="hidden mt-1.5 text-xs leading-relaxed text-muted-foreground">Use an Apple app-specific password, not your Apple Account password. <a href="https://support.apple.com/en-us/102654" target="_blank" rel="noopener noreferrer" class="underline hover:text-foreground">How to create one</a></p>
								</div>
								<div class="col-span-2">
									<label class="text-xs font-medium text-muted-foreground mb-1.5 block">Method</label>
									@selectbox.SelectBox() {
										@selectbox.Trigger(selectbox.TriggerProps{Name: "auth_method"}) {
											@selectbox.Value(selectbox.ValueProps{Placeholder: "PLAIN"}) { PLAIN }
										}
										@selectbox.Content(selectbox.ContentProps{NoSearch: true}) {
											@selectbox.Item(selectbox.ItemProps{Value: "plain", Selected: true}) { PLAIN }
											@selectbox.Item(selectbox.ItemProps{Value: "oauth2"}) { OAuth2 }
										}
									}
								</div>
							</div>
							</div>
							<div class="account-wizard-controls flex justify-between">
								<button type="button" data-on-click='["wizardGo",0]' class="inline-flex items-center gap-1.5 text-sm text-muted-foreground hover:text-foreground transition-colors px-3 py-2 rounded-md border border-border hover:bg-accent">
									@icon.ArrowLeft(icon.Props{Class: "size-4"})
									Back
								</button>
								<button type="button" data-on-click='["wizardGo",2]' class="inline-flex items-center gap-1.5 text-sm font-medium px-4 py-2 rounded-lg bg-primary text-primary-foreground hover:bg-primary/90 transition-colors">
									Next
									@icon.ChevronRight(icon.Props{Class: "size-4"})
								</button>
							</div>
							</div>
						</div>

						<div class="w-1/6 shrink-0 px-1" data-wizard-step="2">
							<div class="account-wizard-panel">
							<div class="account-wizard-scroll" data-wizard-service-content="email">
							<h4 class="account-wizard-sticky-header text-sm font-semibold text-foreground flex items-center gap-2">
								@icon.Send(icon.Props{Class: "size-4 text-muted-foreground"})
								Sending Mail
								<span class="text-xs font-normal text-muted-foreground">(SMTP)</span>
							</h4>
							<div class="grid grid-cols-2 gap-3">
								<div class="col-span-2">
									<label class="text-xs font-medium text-muted-foreground mb-1.5 block">SMTP Host</label>
									@input.Input(input.Props{
										Name:        "smtp_host",
										Type:        input.TypeText,
										Placeholder: "smtp.example.com",
										Required:    true,
									})
									<div data-server-check="smtp" class="mt-1.5 hidden space-y-1" aria-live="polite"></div>
								</div>
								<div>
									<label class="text-xs font-medium text-muted-foreground mb-1.5 block">Port</label>
									@input.Input(input.Props{
										Name:        "smtp_port",
										Type:        input.TypeNumber,
										Placeholder: "465",
										Value:       "465",
									})
								</div>
					<div>
						<label class="text-xs font-medium text-muted-foreground mb-1.5 flex items-center gap-1.5">
							<span>Encryption</span>
							@UnencryptedTransportWarning("add-smtp-unencrypted-warning", false)
						</label>
						@selectbox.SelectBox() {
							@selectbox.Trigger(selectbox.TriggerProps{Name: "smtp_tls_mode", DisableClear: true, Attributes: templ.Attributes{"data-on-change": onAction("toggleUnencryptedTransportWarning", actionElement)}}) {
								@selectbox.Value(selectbox.ValueProps{Placeholder: "TLS"}) { TLS }
							}
									@selectbox.Content(selectbox.ContentProps{NoSearch: true}) {
										@selectbox.Item(selectbox.ItemProps{Value: "tls", Selected: true}) { TLS }
										@selectbox.Item(selectbox.ItemProps{Value: "starttls"}) { STARTTLS }
										@selectbox.Item(selectbox.ItemProps{Value: "plaintext"}) { Unencrypted (admin exception) }
							}
						}
					</div>
							</div>
							<hr class="my-4 border-border"/>
							<label class="flex items-center gap-2 cursor-pointer mb-4">
								@checkbox.Checkbox(checkbox.Props{
									ID:         "smtp-same-auth",
									Checked:    true,
									Attributes: templ.Attributes{"data-on-change": onAction("toggleSmtpAuth", actionChecked)},
								})
								<span class="text-sm">Use same login as incoming mail</span>
							</label>
							<div id="smtp-auth-fields" class="opacity-50">
								<div class="grid grid-cols-2 gap-3">
									<div class="col-span-2">
										<label class="text-xs font-medium text-muted-foreground mb-1.5 block">SMTP Username</label>
										@input.Input(input.Props{
											Name:        "smtp_username",
											Type:        input.TypeText,
											Placeholder: "you@example.com",
											Disabled:    true,
										})
									</div>
									<div class="col-span-2">
										<label class="text-xs font-medium text-muted-foreground mb-1.5 block">SMTP Password</label>
										@input.Input(input.Props{
											Name:        "smtp_password",
											Type:        input.TypePassword,
											Placeholder: "••••••••",
											Disabled:    true,
										})
									</div>
								</div>
							</div>
							</div>
							<div class="account-wizard-controls flex justify-between">
								<button type="button" data-on-click='["wizardGo",1]' class="inline-flex items-center gap-1.5 text-sm text-muted-foreground hover:text-foreground transition-colors px-3 py-2 rounded-md border border-border hover:bg-accent">
									@icon.ArrowLeft(icon.Props{Class: "size-4"})
									Back
								</button>
								<button type="button" data-on-click='["wizardGo",3]' data-add-account-submit-button disabled class="inline-flex items-center gap-1.5 text-sm font-medium px-4 py-2 rounded-lg bg-primary text-primary-foreground hover:bg-primary/90 transition-colors disabled:pointer-events-none disabled:opacity-50">
									Next
									@icon.ChevronRight(icon.Props{Class: "size-4"})
								</button>
							</div>
							</div>
						</div>
						</form>

						<div class="w-1/6 shrink-0 px-1" data-wizard-step="3">
							<div class="account-wizard-panel">
								<div class="account-wizard-scroll">
									<h4 class="account-wizard-sticky-header text-sm font-semibold text-foreground flex items-center gap-2">
										@icon.PlugZap(icon.Props{Class: "size-4 text-muted-foreground"})
										Test and create
									</h4>
									<p class="text-xs leading-relaxed text-muted-foreground">Raven signs in to both servers with the settings you entered. Nothing is saved until you create the account.</p>
									<div id="add-account-test-results" data-add-account-test-results aria-live="polite" class="mt-4 min-w-0 space-y-3 [overflow-wrap:anywhere]"></div>
								</div>
							</div>
						</div>
						<div class="w-1/6 shrink-0 px-1" data-wizard-step="4">
							<div class="account-wizard-panel">
								<div id="add-contacts-content" data-on-htmx-after-swap='["syncAddContactStepAfterSwap"]'></div>
							</div>
						</div>
						<div class="w-1/6 shrink-0 px-1" data-wizard-step="5">
							<div class="account-wizard-panel">
								<div class="account-wizard-scroll">
									<div id="add-calendar-content">
										@CalendarSetupNotice()
									</div>
								</div>
							</div>
						</div>
					</div>
					</div>
				</div>
				@AddAccountWizardFooter()
			}
		}
}

templ AccountWizardAddSidebar() {
	<aside class="rounded-lg border border-border bg-muted/25 p-2 md:min-h-[28rem]">
		<div class="mb-2 px-2">
			<div class="text-xs font-semibold text-muted-foreground">Setup sections</div>
			<p class="mt-0.5 text-xs leading-snug text-muted-foreground/80">Enable/disable the services you need</p>
		</div>
		@AccountWizardEmailSection("wizardGo", "", true, true, false, "Test and create")
		@AccountWizardTopStep("wizardGo", 4, "2", "Contacts", "Optional sync", true, true, "", "contacts", true, false, templ.Attributes{"data-add-contact-sync-switch": ""})
		@AccountWizardTopStep("wizardGo", 5, "3", "Calendar", "Provider access", true, true, "", "calendar", false, false, nil)
	</aside>
}

templ AccountWizardEditSidebar(data models.EditAccountData) {
	<aside class="rounded-lg border border-border bg-muted/25 p-2 md:min-h-[28rem]">
		<div class="mb-2 px-2">
			<div class="text-xs font-semibold text-muted-foreground">Settings sections</div>
			<p class="mt-0.5 text-xs leading-snug text-muted-foreground/80">Enable/disable the services you need</p>
		</div>
		if accountEditUsesProviderAPI(data.Provider) {
			@AccountWizardProviderAPIEmailSection("editWizardGo", data.AccountID, data.Provider, data.EmailSyncEnabled, true)
		} else {
			@AccountWizardEmailSection("editWizardGo", data.AccountID, data.EmailSyncEnabled, false, true, "Test and save")
		}
		@AccountWizardTopStep("editWizardGo", 4, "2", "Contacts", "Optional sync", false, true, data.AccountID, "contacts", data.ContactSync.Enabled, false, nil)
		@AccountWizardTopStep("editWizardGo", 5, "3", "Calendar", "Provider access", false, true, data.AccountID, "calendar", data.CalendarSync.Enabled, false, nil)
	</aside>
}

// AccountWizardEmailSection lists the mail steps, which end with a step that
// tests the settings and then creates or saves the account.
templ AccountWizardEmailSection(goFn string, accountID string, enabled bool, disabled bool, persist bool, finalStep string) {
	<div class="account-wizard-section" data-wizard-section-steps="0,1,2,3" data-active="true">
		<div class="account-wizard-section-heading">
			<button type="button" data-account-wizard-action={ goFn } data-account-wizard-target-step="0" class="account-wizard-section-title">
				<span class="account-wizard-index">1</span>
				<span class="min-w-0"><span class="block text-sm font-semibold">Email</span><span class="block text-xs text-muted-foreground">Mail account setup</span></span>
			</button>
			@AccountWizardSectionSwitch(goFn, accountID, "email", enabled, disabled, persist, false, nil)
		</div>
		<div class="account-wizard-substeps">
			@AccountWizardSubStep(goFn, 0, "1.a", "Account details", "Name and email", false, true)
			@AccountWizardSubStep(goFn, 1, "1.b", "Incoming", "IMAP settings", false, false)
			@AccountWizardSubStep(goFn, 2, "1.c", "Outgoing", "SMTP settings", false, false)
			@AccountWizardSubStep(goFn, 3, "1.d", finalStep, "Check the connection", false, false)
		</div>
	</div>
}

templ AccountWizardProviderAPIEmailSection(goFn string, accountID string, provider string, enabled bool, persist bool) {
	<div class="account-wizard-section" data-wizard-section-steps="0,1,2,3" data-active="true">
		<div class="account-wizard-section-heading">
			<button type="button" data-account-wizard-action={ goFn } data-account-wizard-target-step="0" class="account-wizard-section-title">
				<span class="account-wizard-index">1</span>
				<span class="min-w-0"><span class="block text-sm font-semibold">Email</span><span class="block text-xs text-muted-foreground">{ providerAPIMailTransportLabel(provider) }</span></span>
			</button>
			@AccountWizardSectionSwitch(goFn, accountID, "email", enabled, false, persist, false, nil)
		</div>
		<div class="account-wizard-substeps">
			@AccountWizardSubStep(goFn, 0, "1.a", "Account details", "Name and email", false, true)
			@AccountWizardSubStep(goFn, 1, "1.b", "Mail sync", providerAPIMailTransportLabel(provider), false, false)
			@AccountWizardSubStep(goFn, 2, "1.c", "Sending", providerAPIMailTransportLabel(provider), false, false)
			@AccountWizardSubStep(goFn, 3, "1.d", "Test and save", "Check the connection", false, false)
		</div>
	</div>
}

templ AccountWizardSubStep(goFn string, step int, index string, title string, description string, disabled bool, active bool) {
	<button type="button" data-on-click={ onAction(goFn, step) } data-account-wizard-action={ goFn } data-account-wizard-target-step={ strconv.Itoa(step) } class="account-wizard-step" data-account-wizard-step={ strconv.Itoa(step) } data-active={ strconv.FormatBool(active) } disabled?={ disabled }>
		<span class="account-wizard-index">{ index }</span>
		<span class="min-w-0"><span class="block text-xs font-semibold">{ title }</span><span class="block text-xs text-muted-foreground">{ description }</span></span>
	</button>
}

templ AccountWizardTopStep(goFn string, step int, index string, title string, description string, disabled bool, section bool, accountID string, service string, enabled bool, switchDisabled bool, attrs templ.Attributes) {
	{{ navigationDisabled := disabled }}
	<div id={ fmt.Sprintf("%s-service-section-%s", goFn, service) } class="account-wizard-section" data-wizard-section-steps={ strconv.Itoa(step) } data-active="false" data-disabled={ strconv.FormatBool(navigationDisabled) }>
		<div class="account-wizard-section-heading">
			<button type="button" data-on-click={ onAction(goFn, step) } data-account-wizard-action={ goFn } data-account-wizard-target-step={ strconv.Itoa(step) } class="account-wizard-section-title" data-account-wizard-step={ strconv.Itoa(step) } data-active="false" disabled?={ navigationDisabled }>
				<span class="account-wizard-index">{ index }</span>
				<span class="min-w-0"><span class="block text-sm font-semibold">{ title }</span><span class="block text-xs text-muted-foreground">{ description }</span></span>
			</button>
			if service != "" {
				@AccountWizardSectionSwitch(goFn, accountID, service, enabled, switchDisabled, accountID != "" && service != "contacts" && service != "calendar", false, attrs)
			}
		</div>
	</div>
}

templ AccountWizardSectionSwitch(goFn string, accountID string, service string, enabled bool, disabled bool, persist bool, oob bool, attrs templ.Attributes) {
	<form
		id={ fmt.Sprintf("%s-wizard-service-switch-%s", goFn, service) }
		class="shrink-0 pt-0.5"
		data-wizard-service-form
		data-wizard-service={ service }
		data-account-id={ accountID }
		if oob {
			hx-swap-oob="outerHTML"
		}
		if persist && service != "calendar" {
			hx-post={ fmt.Sprintf("/api/accounts/%s/services", accountID) }
			hx-swap="none"
		}
	>
		if persist {
			<input type="hidden" name="service" value={ service }/>
		}
		@switchcomp.Switch(switchcomp.Props{
			ID:         fmt.Sprintf("account-wizard-%s-%s", accountID, service),
			Name:       "enabled",
			Value:      "true",
			Checked:    enabled,
			Disabled:   disabled,
			Attributes: mergeTemplAttrs(attrs, templ.Attributes{"data-wizard-service-switch": service, "data-wizard-service-initial-enabled": strconv.FormatBool(enabled), "data-on-change": onAction("ravenSubmitHTMXForm", actionElement)}),
		})
	</form>
}

func mergeTemplAttrs(base templ.Attributes, extra templ.Attributes) templ.Attributes {
	if base == nil {
		base = templ.Attributes{}
	}
	for k, v := range extra {
		base[k] = v
	}
	return base
}

templ AddAccountWizardFooter() {
	<div id="add-wizard-footer" class="account-wizard-card-footer">
		<div data-wizard-footer-step="0" data-active="true" class="flex justify-end">
			<button type="button" data-on-click='["wizardGo",1]' class="inline-flex items-center gap-1.5 text-sm font-medium px-4 py-2 rounded-lg bg-primary text-primary-foreground hover:bg-primary/90 transition-colors">
				Next
				@icon.ChevronRight(icon.Props{Class: "size-4"})
			</button>
		</div>
		<div data-wizard-footer-step="1" data-active="false" class="hidden flex justify-between">
			<button type="button" data-on-click='["wizardGo",0]' class="inline-flex items-center gap-1.5 text-sm text-muted-foreground hover:text-foreground transition-colors px-3 py-2 rounded-md border border-border hover:bg-accent">
				@icon.ArrowLeft(icon.Props{Class: "size-4"})
				Back
			</button>
			<button type="button" data-on-click='["wizardGo",2]' class="inline-flex items-center gap-1.5 text-sm font-medium px-4 py-2 rounded-lg bg-primary text-primary-foreground hover:bg-primary/90 transition-colors">
				Next
				@icon.ChevronRight(icon.Props{Class: "size-4"})
			</button>
		</div>
		<div data-wizard-footer-step="2" data-active="false" class="hidden flex justify-between">
			<button type="button" data-on-click='["wizardGo",1]' class="inline-flex items-center gap-1.5 text-sm text-muted-foreground hover:text-foreground transition-colors px-3 py-2 rounded-md border border-border hover:bg-accent">
				@icon.ArrowLeft(icon.Props{Class: "size-4"})
				Back
			</button>
			<button type="button" data-on-click='["wizardGo",3]' data-add-account-submit-button disabled class="inline-flex items-center gap-1.5 text-sm font-medium px-4 py-2 rounded-lg bg-primary text-primary-foreground hover:bg-primary/90 transition-colors disabled:pointer-events-none disabled:opacity-50">
				Next
				@icon.ChevronRight(icon.Props{Class: "size-4"})
			</button>
		</div>
		<div data-wizard-footer-step="3" data-active="false" class="hidden flex flex-wrap justify-between gap-2">
			<button type="button" data-on-click='["wizardGo",2]' data-account-test-action data-account-test-back class="inline-flex items-center gap-1.5 text-sm text-muted-foreground hover:text-foreground transition-colors px-3 py-2 rounded-md border border-border hover:bg-accent disabled:pointer-events-none disabled:opacity-50">
				@icon.ArrowLeft(icon.Props{Class: "size-4"})
				Back
			</button>
			<div class="ml-auto flex flex-wrap justify-end gap-2">
				<button type="submit" form="account-form" data-account-test-action data-account-test-anyway class="inline-flex items-center gap-1.5 text-sm font-medium px-3 py-2 rounded-lg border border-border text-foreground hover:bg-accent transition-colors disabled:pointer-events-none disabled:opacity-50">Skip test and create</button>
				<button type="button" data-on-click='["addAccountTest.run",true]' data-account-test-action data-account-test-retest hidden class="inline-flex items-center gap-1.5 text-sm font-medium px-4 py-2 rounded-lg bg-primary text-primary-foreground hover:bg-primary/90 transition-colors disabled:pointer-events-none disabled:opacity-50">
					@icon.RefreshCw(icon.Props{Class: "size-4"})
					Test again
				</button>
				<button type="submit" form="account-form" data-account-test-action data-account-test-save hidden class="inline-flex items-center gap-1.5 text-sm font-medium px-4 py-2 rounded-lg bg-primary text-primary-foreground hover:bg-primary/90 transition-colors disabled:pointer-events-none disabled:opacity-50">
					Create account
					@icon.ChevronRight(icon.Props{Class: "size-4"})
				</button>
				<button type="button" data-on-click='["ravenNavigate","/settings/accounts?account_added=1"]' data-account-test-close hidden class="inline-flex items-center gap-1.5 text-sm font-medium px-3 py-2 rounded-lg border border-border text-foreground hover:bg-accent transition-colors disabled:pointer-events-none disabled:opacity-50">Close</button>
				<button type="button" data-on-click='["wizardGo",4]' data-account-test-continue hidden class="inline-flex items-center gap-1.5 text-sm font-medium px-4 py-2 rounded-lg bg-primary text-primary-foreground hover:bg-primary/90 transition-colors disabled:pointer-events-none disabled:opacity-50">
					Continue to Contacts
					@icon.ChevronRight(icon.Props{Class: "size-4"})
				</button>
			</div>
		</div>
		<div id="add-wizard-footer-step-4" data-wizard-footer-step="4" data-active="false" class="hidden"></div>
		<div id="add-wizard-footer-step-5" data-wizard-footer-step="5" data-active="false" class="hidden"></div>
	</div>
}

templ ProviderAPIMailPanel(provider string, mode string) {
	<h4 class="account-wizard-sticky-header text-sm font-semibold text-foreground flex items-center gap-2">
		if mode == "send" {
			@icon.Send(icon.Props{Class: "size-4 text-muted-foreground"})
		} else {
			@icon.MailCheck(icon.Props{Class: "size-4 text-muted-foreground"})
		}
		{ providerAPIMailPanelTitle(provider, mode) }
		<span class="text-xs font-normal text-muted-foreground">({ providerAPIMailTransportLabel(provider) })</span>
	</h4>
	<div class="rounded-lg border border-border bg-background/45 p-4">
		<div class="flex items-start gap-3">
			<div class="mt-0.5 flex size-8 shrink-0 items-center justify-center rounded-md border border-border/70 bg-card text-muted-foreground">
				if mode == "send" {
					@icon.Send(icon.Props{Class: "size-4"})
				} else {
					@icon.MailCheck(icon.Props{Class: "size-4"})
				}
			</div>
			<div class="min-w-0">
				<div class="text-xs font-semibold text-muted-foreground">{ providerAPIMailTransportLabel(provider) }</div>
				<p class="mt-1 text-xs leading-relaxed text-muted-foreground">{ providerAPIMailPanelDescription(provider, mode) }</p>
			</div>
		</div>
	</div>
}

templ UnencryptedTransportWarning(id string, active bool) {
	<span class="relative inline-flex size-4 shrink-0 align-middle">
		@popover.Root(popover.RootProps{ID: id, Class: "contents"}) {
			@popover.Trigger(popover.TriggerProps{TriggerType: popover.TriggerTypeHover}) {
				<button
					type="button"
					data-unencrypted-transport-warning
					class={ "size-4 items-center justify-center rounded-sm text-amber-700 transition-colors hover:bg-amber-500/10 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring dark:text-amber-300", templ.KV("hidden", !active), templ.KV("inline-flex", active) }
					aria-label="Show unencrypted connection warning"
				>
					@icon.TriangleAlert(icon.Props{Class: "size-3.5"})
				</button>
			}
			@popover.Content(popover.ContentProps{Placement: popover.PlacementBottomStart, Offset: 8, ShowArrow: true, Class: "w-80 p-3"}) {
				<div class="flex items-start gap-2.5">
					@icon.TriangleAlert(icon.Props{Class: "mt-0.5 size-4 shrink-0 text-amber-700 dark:text-amber-300"})
					<p class="text-xs leading-relaxed text-muted-foreground">Unencrypted connections only work while this exact endpoint remains approved under Mail security.</p>
				</div>
			}
		}
	</span>
}

func accountEditUsesProviderAPI(provider string) bool {
	return syncSettingsAccountUsesProviderAPI(provider)
}

func providerAPIMailTransportLabel(provider string) string {
	if strings.EqualFold(strings.TrimSpace(provider), "outlook") {
		return "Microsoft Graph"
	}
	return "Gmail API"
}

func providerAPIMailPanelTitle(provider string, mode string) string {
	if mode == "send" {
		if strings.EqualFold(strings.TrimSpace(provider), "outlook") {
			return "Outlook Sending"
		}
		return "Gmail Sending"
	}
	if strings.EqualFold(strings.TrimSpace(provider), "outlook") {
		return "Outlook Mail"
	}
	return "Gmail Mail"
}

func providerAPIMailPanelDescription(provider string, mode string) string {
	if strings.EqualFold(strings.TrimSpace(provider), "outlook") {
		if mode == "send" {
			return "Outlook messages and drafts are sent through Microsoft Graph. SMTP server settings are not used for this account."
		}
		return "Outlook mail is read through Microsoft Graph delta sync. IMAP server settings are not used for this account."
	}
	if mode == "send" {
		return "Gmail messages and drafts are sent through the Gmail API. SMTP server settings are not used for this account."
	}
	return "Gmail mail is read through Gmail API history changes. IMAP server settings are not used for this account."
}

templ EditAccountDialog(data models.EditAccountData) {
	@dialog.Dialog(dialog.Props{ID: "edit-account-dialog"}) {
		@dialog.Content(dialog.ContentProps{Class: "account-wizard-dialog sm:max-w-4xl"}) {
			@dialog.Header() {
				@dialog.Title() {
					Edit Account
				}
				@dialog.Description() {
					Update mail settings and optional contacts and calendar services.
				}
			}
			<div class="account-wizard-shell grid gap-4 pt-2 md:grid-cols-[14.5rem_minmax(0,1fr)]">
		@AccountWizardEditSidebar(data)
				<div id="edit-wizard-viewport" class="account-wizard-viewport">
					<div id="edit-wizard-track" class="flex items-start transition-transform duration-300 ease-in-out" style="width: 600%">
						<form id="edit-account-form" hx-post={ fmt.Sprintf("/api/accounts/%s/edit", data.AccountID) } hx-target="#edit-account-save-status" hx-swap="innerHTML" data-on-htmx-before-request='["handleEditAccountSaveStart","$event"]' data-on-htmx-after-request='["handleEditAccountSaveResult","$event"]' class="contents">
						<input type="hidden" name="provider" value={ data.Provider }/>
						<div class="w-1/6 shrink-0 px-1" data-wizard-step="0">
							<div class="account-wizard-panel">
							<div class="account-wizard-scroll" data-wizard-service-content="email">
							<h4 class="account-wizard-sticky-header text-sm font-semibold text-foreground flex items-center gap-2">
								@icon.User(icon.Props{Class: "size-4 text-muted-foreground"})
								Account details
							</h4>
							<div class="space-y-4">
								<div>
									<label class="text-xs font-medium text-muted-foreground mb-1.5 block">Email Address</label>
									@input.Input(input.Props{
										Name:  "email_address",
										Type:  input.TypeEmail,
										Value: data.EmailAddress,
									})
								</div>
								<div>
									<label class="text-xs font-medium text-muted-foreground mb-1.5 block">Display Name</label>
									@input.Input(input.Props{
										Name:  "display_name",
										Type:  input.TypeText,
										Value: data.DisplayName,
									})
								</div>
								<div>
									<label class="text-xs font-medium text-muted-foreground mb-1.5 block">Sidebar label <span class="font-normal">(optional)</span></label>
									@input.Input(input.Props{
										Name:  "label",
										Type:  input.TypeText,
										Value: data.Label,
										Attributes: templ.Attributes{"maxlength": "64", "placeholder": "e.g. Work"},
									})
									<p class="mt-1 text-xs text-muted-foreground">Shown only in Raven, not to recipients. Display Name above is what recipients see.</p>
								</div>
							</div>
							</div>
							<div class="account-wizard-controls flex justify-end">
								<button type="button" data-on-click='["editWizardGo",1]' class="inline-flex items-center gap-1.5 text-sm font-medium px-4 py-2 rounded-lg bg-primary text-primary-foreground hover:bg-primary/90 transition-colors">
									Next
									@icon.ChevronRight(icon.Props{Class: "size-4"})
								</button>
							</div>
							</div>
						</div>

						<div class="w-1/6 shrink-0 px-1" data-wizard-step="1">
							<div class="account-wizard-panel">
							<div class="account-wizard-scroll" data-wizard-service-content="email">
							if accountEditUsesProviderAPI(data.Provider) {
								@ProviderAPIMailPanel(data.Provider, "receive")
							} else {
								<h4 class="account-wizard-sticky-header text-sm font-semibold text-foreground flex items-center gap-2">
									@icon.Inbox(icon.Props{Class: "size-4 text-muted-foreground"})
									Incoming Mail
									<span class="text-xs font-normal text-muted-foreground">(IMAP)</span>
								</h4>
								<div class="grid grid-cols-2 gap-3">
									<div class="col-span-2">
										<label class="text-xs font-medium text-muted-foreground mb-1.5 block">IMAP Host</label>
										@input.Input(input.Props{
											Name:  "imap_host",
											Type:  input.TypeText,
											Value: data.IMAPHost,
										})
										<div data-server-check="imap" class="mt-1.5 hidden space-y-1" aria-live="polite"></div>
									</div>
									<div>
										<label class="text-xs font-medium text-muted-foreground mb-1.5 block">Port</label>
										@input.Input(input.Props{
											Name:  "imap_port",
											Type:  input.TypeNumber,
											Value: strconv.Itoa(data.IMAPPort),
										})
									</div>
					<div>
											<label class="text-xs font-medium text-muted-foreground mb-1.5 flex items-center gap-1.5">
												<span>Encryption</span>
												@UnencryptedTransportWarning("edit-imap-unencrypted-warning", data.IMAPTLSMode == "plaintext")
											</label>
											@selectbox.SelectBox() {
												@selectbox.Trigger(selectbox.TriggerProps{Name: "imap_tls_mode", DisableClear: true, Attributes: templ.Attributes{"data-on-change": onAction("toggleUnencryptedTransportWarning", actionElement)}}) {
												@selectbox.Value(selectbox.ValueProps{Placeholder: "TLS"}) { TLS }
											}
										@selectbox.Content(selectbox.ContentProps{NoSearch: true}) {
											@selectbox.Item(selectbox.ItemProps{Value: "tls", Selected: data.IMAPTLSMode == "tls"}) { TLS }
											@selectbox.Item(selectbox.ItemProps{Value: "starttls", Selected: data.IMAPTLSMode == "starttls"}) { STARTTLS }
											@selectbox.Item(selectbox.ItemProps{Value: "plaintext", Selected: data.IMAPTLSMode == "plaintext"}) { Unencrypted (admin exception) }
										}
									}
										</div>
								</div>
								<hr class="my-4 border-border"/>
								<h4 class="text-sm font-semibold text-foreground flex items-center gap-2 mb-4">
									@icon.Key(icon.Props{Class: "size-4 text-muted-foreground"})
									Login
								</h4>
								<div class="grid grid-cols-2 gap-3">
									<div class="col-span-2">
										<label class="text-xs font-medium text-muted-foreground mb-1.5 block">Username</label>
										@input.Input(input.Props{
											Name:  "username",
											Type:  input.TypeText,
											Value: data.Username,
										})
									</div>
									<div class="col-span-2">
										<label class="text-xs font-medium text-muted-foreground mb-1.5 block">Password</label>
										@input.Input(input.Props{
											Name:        "password",
											Type:        input.TypePassword,
											Placeholder: "Leave blank to keep current",
										})
									</div>
									<div class="col-span-2">
										<label class="text-xs font-medium text-muted-foreground mb-1.5 block">Method</label>
										@selectbox.SelectBox() {
											@selectbox.Trigger(selectbox.TriggerProps{Name: "auth_method"}) {
												@selectbox.Value(selectbox.ValueProps{Placeholder: "PLAIN"}) { PLAIN }
											}
											@selectbox.Content(selectbox.ContentProps{NoSearch: true}) {
												@selectbox.Item(selectbox.ItemProps{Value: "plain", Selected: data.AuthMethod == "plain"}) { PLAIN }
												@selectbox.Item(selectbox.ItemProps{Value: "oauth2", Selected: data.AuthMethod == "oauth2"}) { OAuth2 }
											}
										}
									</div>
								</div>
							}
							</div>
							<div class="account-wizard-controls flex justify-between">
								<button type="button" data-on-click='["editWizardGo",0]' class="inline-flex items-center gap-1.5 text-sm text-muted-foreground hover:text-foreground transition-colors px-3 py-2 rounded-md border border-border hover:bg-accent">
									@icon.ArrowLeft(icon.Props{Class: "size-4"})
									Back
								</button>
								<button type="button" data-on-click='["editWizardGo",2]' class="inline-flex items-center gap-1.5 text-sm font-medium px-4 py-2 rounded-lg bg-primary text-primary-foreground hover:bg-primary/90 transition-colors">
									Next
									@icon.ChevronRight(icon.Props{Class: "size-4"})
								</button>
							</div>
							</div>
						</div>

						<div class="w-1/6 shrink-0 px-1" data-wizard-step="2">
							<div class="account-wizard-panel">
							<div class="account-wizard-scroll" data-wizard-service-content="email">
							if accountEditUsesProviderAPI(data.Provider) {
								@ProviderAPIMailPanel(data.Provider, "send")
							} else {
							<h4 class="account-wizard-sticky-header text-sm font-semibold text-foreground flex items-center gap-2">
								@icon.Send(icon.Props{Class: "size-4 text-muted-foreground"})
								Sending Mail
								<span class="text-xs font-normal text-muted-foreground">(SMTP)</span>
							</h4>
							<div class="grid grid-cols-2 gap-3">
								<div class="col-span-2">
									<label class="text-xs font-medium text-muted-foreground mb-1.5 block">SMTP Host</label>
									@input.Input(input.Props{
										Name:  "smtp_host",
										Type:  input.TypeText,
										Value: data.SMTPHost,
									})
									<div data-server-check="smtp" class="mt-1.5 hidden space-y-1" aria-live="polite"></div>
								</div>
								<div>
									<label class="text-xs font-medium text-muted-foreground mb-1.5 block">Port</label>
									@input.Input(input.Props{
										Name:  "smtp_port",
										Type:  input.TypeNumber,
										Value: strconv.Itoa(data.SMTPPort),
									})
								</div>
					<div>
									<label class="text-xs font-medium text-muted-foreground mb-1.5 flex items-center gap-1.5">
										<span>Encryption</span>
										@UnencryptedTransportWarning("edit-smtp-unencrypted-warning", data.SMTPTLSMode == "plaintext")
									</label>
									@selectbox.SelectBox() {
										@selectbox.Trigger(selectbox.TriggerProps{Name: "smtp_tls_mode", DisableClear: true, Attributes: templ.Attributes{"data-on-change": onAction("toggleUnencryptedTransportWarning", actionElement)}}) {
											@selectbox.Value(selectbox.ValueProps{Placeholder: "TLS"}) { TLS }
										}
									@selectbox.Content(selectbox.ContentProps{NoSearch: true}) {
										@selectbox.Item(selectbox.ItemProps{Value: "tls", Selected: data.SMTPTLSMode == "tls"}) { TLS }
										@selectbox.Item(selectbox.ItemProps{Value: "starttls", Selected: data.SMTPTLSMode == "starttls"}) { STARTTLS }
										@selectbox.Item(selectbox.ItemProps{Value: "plaintext", Selected: data.SMTPTLSMode == "plaintext"}) { Unencrypted (admin exception) }
									}
								}
							</div>
							</div>
							<hr class="my-4 border-border"/>
							<label class="flex items-center gap-2 cursor-pointer mb-4">
								@checkbox.Checkbox(checkbox.Props{
									ID:         "edit-smtp-same-auth",
									Checked:    data.SameSmtpAuth,
									Attributes: templ.Attributes{"data-on-change": onAction("editToggleSmtpAuth", actionChecked)},
								})
								<span class="text-sm">Use same login as incoming mail</span>
							</label>
							<div id="edit-smtp-auth-fields" class={ templ.KV("opacity-50", data.SameSmtpAuth) }>
								<div class="grid grid-cols-2 gap-3">
									<div class="col-span-2">
										<label class="text-xs font-medium text-muted-foreground mb-1.5 block">SMTP Username</label>
										@input.Input(input.Props{
											Name:     "smtp_username",
											Type:     input.TypeText,
											Value:    data.SmtpUsername,
											Disabled: data.SameSmtpAuth,
										})
									</div>
									<div class="col-span-2">
										<label class="text-xs font-medium text-muted-foreground mb-1.5 block">SMTP Password</label>
										@input.Input(input.Props{
											Name:        "smtp_password",
											Type:        input.TypePassword,
											Placeholder: "Leave blank to keep current",
											Disabled:    data.SameSmtpAuth,
										})
									</div>
								</div>
							</div>
							}
							</div>
							<div class="account-wizard-controls flex justify-between">
								<button type="button" data-on-click='["editWizardGo",1]' class="inline-flex items-center gap-1.5 text-sm text-muted-foreground hover:text-foreground transition-colors px-3 py-2 rounded-md border border-border hover:bg-accent">
									@icon.ArrowLeft(icon.Props{Class: "size-4"})
									Back
								</button>
								<button type="button" data-on-click='["editWizardGo",3]' class="inline-flex items-center gap-1.5 text-sm font-medium px-4 py-2 rounded-lg bg-primary text-primary-foreground hover:bg-primary/90 transition-colors">
									Next
									@icon.ChevronRight(icon.Props{Class: "size-4"})
								</button>
							</div>
							</div>
						</div>
						</form>

						<div class="w-1/6 shrink-0 px-1" data-wizard-step="3">
							<div class="account-wizard-panel">
							<div class="account-wizard-scroll">
								<h4 class="account-wizard-sticky-header text-sm font-semibold text-foreground flex items-center gap-2">
									@icon.PlugZap(icon.Props{Class: "size-4 text-muted-foreground"})
									Test and save
								</h4>
								<p class="text-xs leading-relaxed text-muted-foreground">{ editAccountTestDescription(data) }</p>
								<div data-edit-account-unsaved hidden role="status" class="mt-3 rounded-md border border-amber-500/30 bg-amber-500/10 px-3 py-2 text-xs text-amber-900 dark:text-amber-100">Save your mail changes before moving on, or close this window to discard them.</div>
								<div id="edit-account-test-results" data-test-url={ editAccountTestURL(data) } data-test-typed={ strconv.FormatBool(editAccountTestsTypedSettings(data)) } aria-live="polite" class="mt-4 min-w-0 space-y-3 [overflow-wrap:anywhere]"></div>
								<div id="edit-account-save-status" class="mt-3"></div>
							</div>
							</div>
						</div>

						<div class="w-1/6 shrink-0 px-1" data-wizard-step="4">
							<div class="account-wizard-panel">
							<div class="account-wizard-scroll">
								<div data-wizard-service-content="contacts">
									@ContactSyncSettings(data)
								</div>
							</div>
							<div class="account-wizard-controls flex justify-between gap-2">
								<button type="button" data-on-click='["editWizardGo",3]' class="inline-flex items-center gap-1.5 text-sm text-muted-foreground hover:text-foreground transition-colors px-3 py-2 rounded-md border border-border hover:bg-accent">
									@icon.ArrowLeft(icon.Props{Class: "size-4"})
									Back
								</button>
				<button type="button" data-on-click='["wizardServiceNext","$this","contacts",5]' class="inline-flex items-center gap-1.5 rounded-lg bg-primary px-4 py-2 text-sm font-medium text-primary-foreground transition-colors hover:bg-primary/90">
					Next
					@icon.ChevronRight(icon.Props{Class: "size-4"})
				</button>
							</div>
							</div>
						</div>

						<div class="w-1/6 shrink-0 px-1" data-wizard-step="5">
							<div class="account-wizard-panel">
							<div class="account-wizard-scroll">
								<div
									data-wizard-service-content="calendar"
									data-wizard-service-always-active="true"
								>
									@CalendarSyncSettings(data)
								</div>
							</div>
							<div class="account-wizard-controls flex justify-between gap-2">
								<button type="button" data-on-click='["editWizardGo",4]' class="inline-flex items-center gap-1.5 text-sm text-muted-foreground hover:text-foreground transition-colors px-3 py-2 rounded-md border border-border hover:bg-accent">
									@icon.ArrowLeft(icon.Props{Class: "size-4"})
									Back
								</button>
				<button type="button" data-on-click='["wizardServiceNext","$this","calendar","done"]' class="inline-flex items-center gap-1.5 rounded-lg bg-primary px-4 py-2 text-sm font-medium text-primary-foreground transition-colors hover:bg-primary/90">
					Next
					@icon.ChevronRight(icon.Props{Class: "size-4"})
				</button>
							</div>
						</div>
						</div>
					</div>
				</div>
			</div>
			@EditAccountWizardFooter(data)
		}
	}
}

templ EditAccountWizardFooter(data models.EditAccountData) {
	<div id="edit-wizard-footer" class="account-wizard-card-footer">
		<div data-wizard-footer-step="0" data-active="true" class="flex justify-end">
			<button type="button" data-on-click='["editWizardGo",1]' class="inline-flex items-center gap-1.5 text-sm font-medium px-4 py-2 rounded-lg bg-primary text-primary-foreground hover:bg-primary/90 transition-colors disabled:pointer-events-none disabled:opacity-50">
				Next
				@icon.ChevronRight(icon.Props{Class: "size-4"})
			</button>
		</div>
		<div data-wizard-footer-step="1" data-active="false" class="hidden flex justify-between">
			<button type="button" data-on-click='["editWizardGo",0]' class="inline-flex items-center gap-1.5 text-sm text-muted-foreground hover:text-foreground transition-colors px-3 py-2 rounded-md border border-border hover:bg-accent disabled:pointer-events-none disabled:opacity-50">
				@icon.ArrowLeft(icon.Props{Class: "size-4"})
				Back
			</button>
			<button type="button" data-on-click='["editWizardGo",2]' class="inline-flex items-center gap-1.5 text-sm font-medium px-4 py-2 rounded-lg bg-primary text-primary-foreground hover:bg-primary/90 transition-colors disabled:pointer-events-none disabled:opacity-50">
				Next
				@icon.ChevronRight(icon.Props{Class: "size-4"})
			</button>
		</div>
		<div data-wizard-footer-step="2" data-active="false" class="hidden flex justify-between">
			<button type="button" data-on-click='["editWizardGo",1]' class="inline-flex items-center gap-1.5 text-sm text-muted-foreground hover:text-foreground transition-colors px-3 py-2 rounded-md border border-border hover:bg-accent disabled:pointer-events-none disabled:opacity-50">
				@icon.ArrowLeft(icon.Props{Class: "size-4"})
				Back
			</button>
			<button type="button" data-on-click='["editWizardGo",3]' class="inline-flex items-center gap-1.5 text-sm font-medium px-4 py-2 rounded-lg bg-primary text-primary-foreground hover:bg-primary/90 transition-colors disabled:pointer-events-none disabled:opacity-50">
				Next
				@icon.ChevronRight(icon.Props{Class: "size-4"})
			</button>
		</div>
		<div data-wizard-footer-step="3" data-active="false" class="hidden flex flex-wrap justify-between gap-2">
			<button type="button" data-on-click='["editWizardGo",2]' data-account-test-action data-account-test-back class="inline-flex items-center gap-1.5 text-sm text-muted-foreground hover:text-foreground transition-colors px-3 py-2 rounded-md border border-border hover:bg-accent disabled:pointer-events-none disabled:opacity-50">
				@icon.ArrowLeft(icon.Props{Class: "size-4"})
				Back
			</button>
			<div class="ml-auto flex flex-wrap justify-end gap-2">
				<button type="submit" form="edit-account-form" data-account-test-action data-account-test-anyway class="inline-flex items-center gap-1.5 text-sm font-medium px-3 py-2 rounded-lg border border-border text-foreground hover:bg-accent transition-colors disabled:pointer-events-none disabled:opacity-50">Skip test and save</button>
				<button type="button" data-on-click='["editAccountTest.run",true]' data-account-test-action data-account-test-retest hidden class="inline-flex items-center gap-1.5 text-sm font-medium px-4 py-2 rounded-lg bg-primary text-primary-foreground hover:bg-primary/90 transition-colors disabled:pointer-events-none disabled:opacity-50">
					@icon.RefreshCw(icon.Props{Class: "size-4"})
					Test again
				</button>
				<button type="button" data-on-click='["editAccountSaveOrContinue"]' data-account-test-action data-account-test-save hidden class="inline-flex items-center gap-1.5 text-sm font-medium px-4 py-2 rounded-lg bg-primary text-primary-foreground hover:bg-primary/90 transition-colors disabled:pointer-events-none disabled:opacity-50">
					<span data-edit-account-save-label>Save changes</span>
					@icon.ChevronRight(icon.Props{Class: "size-4"})
				</button>
				<button type="button" data-on-click='["ravenNavigate","/settings/accounts"]' data-account-test-close hidden class="inline-flex items-center gap-1.5 text-sm font-medium px-3 py-2 rounded-lg border border-border text-foreground hover:bg-accent transition-colors disabled:pointer-events-none disabled:opacity-50">Close</button>
				<button type="button" data-on-click='["editWizardGo",4,true]' data-account-test-continue hidden class="inline-flex items-center gap-1.5 text-sm font-medium px-4 py-2 rounded-lg bg-primary text-primary-foreground hover:bg-primary/90 transition-colors disabled:pointer-events-none disabled:opacity-50">
					Continue to Contacts
					@icon.ChevronRight(icon.Props{Class: "size-4"})
				</button>
			</div>
		</div>
		<div data-wizard-footer-step="4" data-active="false" class="hidden flex justify-between gap-2">
			<button type="button" data-on-click='["editWizardGo",3]' class="inline-flex items-center gap-1.5 text-sm text-muted-foreground hover:text-foreground transition-colors px-3 py-2 rounded-md border border-border hover:bg-accent disabled:pointer-events-none disabled:opacity-50">
				@icon.ArrowLeft(icon.Props{Class: "size-4"})
				Back
			</button>
			<button type="button" data-on-click='["wizardServiceNext","$this","contacts",5]' class="inline-flex items-center gap-1.5 rounded-lg bg-primary px-4 py-2 text-sm font-medium text-primary-foreground transition-colors hover:bg-primary/90">
				Next
				@icon.ChevronRight(icon.Props{Class: "size-4"})
			</button>
		</div>
		<div data-wizard-footer-step="5" data-active="false" class="hidden flex justify-between gap-2">
			<button type="button" data-on-click='["editWizardGo",4]' class="inline-flex items-center gap-1.5 text-sm text-muted-foreground hover:text-foreground transition-colors px-3 py-2 rounded-md border border-border hover:bg-accent disabled:pointer-events-none disabled:opacity-50">
				@icon.ArrowLeft(icon.Props{Class: "size-4"})
				Back
			</button>
			<button type="button" data-on-click='["wizardServiceNext","$this","calendar","done"]' class="inline-flex items-center gap-1.5 rounded-lg bg-primary px-4 py-2 text-sm font-medium text-primary-foreground transition-colors hover:bg-primary/90">
				@icon.Check(icon.Props{Class: "size-4"})
				Done
			</button>
		</div>
	</div>
}

func editAccountTestsTypedSettings(data models.EditAccountData) bool {
	return data.Provider == "imap" && data.AuthMethod == "plain"
}

// editAccountTestURL tests the typed settings of accounts that sign in with a
// password. Others, such as Gmail or Outlook, have no mail settings to type,
// so the saved connection is tested.
func editAccountTestURL(data models.EditAccountData) string {
	if editAccountTestsTypedSettings(data) {
		return "/api/accounts/" + data.AccountID + "/test-changes"
	}
	return "/api/accounts/" + data.AccountID + "/test?wizard=check"
}

func editAccountTestDescription(data models.EditAccountData) string {
	if editAccountTestsTypedSettings(data) {
		return "Raven signs in to both servers with the settings you entered. Nothing changes until you save."
	}
	return "Raven checks this account's connection. Nothing changes until you save."
}

templ ContactSyncSettings(data models.EditAccountData) {
	{{ sameCardDAVAuth := strings.TrimSpace(data.ContactSync.Username) == "" || strings.TrimSpace(data.ContactSync.Username) == strings.TrimSpace(data.Username) }}
	{{ isBuiltinOAuthContactSync := data.Provider == "gmail" || data.Provider == "outlook" }}
	{{ providerName := accountProviderName(data.Provider) }}
	<div class="space-y-3">
		<div class="account-wizard-sticky-header flex items-start justify-between gap-4">
			<div class="min-w-0">
				<h4 class="text-sm font-semibold text-foreground flex items-center gap-2">
					@icon.BookUser(icon.Props{Class: "size-4 text-muted-foreground"})
					Contact sync
				</h4>
				<p class="mt-1 text-xs text-muted-foreground leading-relaxed">Control whether this account appears as a contact sync target.</p>
			</div>
			if data.ContactSync.Enabled {
				<span class="shrink-0 rounded-full bg-emerald-500/10 px-2 py-0.5 text-xs font-semibold text-emerald-600 dark:text-emerald-400">Enabled</span>
			} else {
				<span class="shrink-0 rounded-md bg-muted px-2 py-0.5 text-xs font-semibold text-muted-foreground">Not configured</span>
			}
		</div>
		<div data-wizard-service-status="contacts" class="min-h-0"></div>
		if isBuiltinOAuthContactSync {
			<div class="rounded-lg border border-border bg-background/50 p-3 text-xs text-muted-foreground leading-relaxed">{ providerName } contacts use this account's existing authorization. Reconnect the account if contact sync reports missing access.</div>
		} else {
			<form id={ fmt.Sprintf("account-contact-sync-form-%s", data.AccountID) } data-contact-sync-form data-wizard-contact-form data-wizard-next-step="5" data-account-id={ data.AccountID } hx-post={ fmt.Sprintf("/api/accounts/%s/contacts/sync", data.AccountID) } hx-target={ fmt.Sprintf("#account-contact-sync-status-%s", data.AccountID) } hx-swap="innerHTML" class="space-y-3">
				<div id={ fmt.Sprintf("account-contact-sync-fields-%s", data.AccountID) } class="grid gap-3 sm:grid-cols-2">
					<div class="sm:col-span-2">
						<div class="mb-1.5 flex flex-col gap-1.5 sm:flex-row sm:items-center sm:justify-between">
							<label class="text-xs font-medium text-muted-foreground">Base URL</label>
							@CardDAVAutodiscoverButton(data.AccountID, fmt.Sprintf("account-contact-sync-fields-%s", data.AccountID), fmt.Sprintf("account-contact-sync-status-%s", data.AccountID))
						</div>
						@input.Input(input.Props{Name: "base_url", Type: input.TypeURL, Value: data.ContactSync.BaseURL, Placeholder: "https://dav.example.com/"})
						<div data-server-check-url class="mt-1.5 hidden space-y-1" aria-live="polite"></div>
					</div>
					<label class="sm:col-span-2 flex items-center gap-2 cursor-pointer">
						@checkbox.Checkbox(checkbox.Props{
							Name:       "use_account_credentials",
							Value:      "1",
							Checked:    sameCardDAVAuth,
							Attributes: templ.Attributes{"data-on-change": onAction("toggleCardDAVAuth", actionElement)},
						})
						<span class="text-sm">Use same credentials as incoming mail</span>
					</label>
					<div class={ "sm:col-span-2 grid gap-3 sm:grid-cols-2", templ.KV("opacity-50", sameCardDAVAuth) } data-carddav-credential-fields>
						<div>
							<label class="text-xs font-medium text-muted-foreground mb-1.5 block">Username</label>
							@input.Input(input.Props{Name: "username", Type: input.TypeText, Value: data.ContactSync.Username, Placeholder: data.Username, Disabled: sameCardDAVAuth})
						</div>
						<div>
							<label class="text-xs font-medium text-muted-foreground mb-1.5 block">Password or app password</label>
							@input.Input(input.Props{Name: "password", Type: input.TypePassword, Placeholder: contactSyncPasswordPlaceholder(data.ContactSync), Disabled: sameCardDAVAuth})
						</div>
					</div>
					if len(data.ContactSync.AddressBooks) > 1 {
						<div class="sm:col-span-2 rounded-lg border border-border bg-background/45 p-3" data-carddav-addressbook-section>
							<div class="text-xs font-semibold text-foreground">Selected address books</div>
							<p class="mt-1 text-xs leading-relaxed text-muted-foreground">Select one or more address books to sync. The default is used for new contacts.</p>
							<div class="mt-3 space-y-2">
								for i, book := range data.ContactSync.AddressBooks {
									<label class="flex w-full items-start gap-3 rounded-md border border-primary bg-primary/10 px-3 py-2 text-xs">
										<span class="mt-0.5 inline-flex">
											@checkbox.Checkbox(checkbox.Props{Name: "addressbook_url", Value: book.URL, Checked: true})
										</span>
										<input type="hidden" name="addressbook_id" value={ book.ID }/>
										<input type="hidden" name="addressbook_name" value={ book.Name }/>
										<div class="min-w-0 flex-1">
											<div class="font-semibold text-foreground">{ contactAddressBookName(book) }</div>
											<div class="mt-0.5 truncate text-muted-foreground">{ book.URL }</div>
											<label class="mt-2 inline-flex items-center gap-1.5 text-xs text-muted-foreground">
												if book.Default || (!contactSyncHasDefaultBook(data.ContactSync.AddressBooks) && i == 0) {
													@radio.Radio(radio.Props{Name: "default_addressbook_url", Value: book.URL, Checked: true})
												} else {
													@radio.Radio(radio.Props{Name: "default_addressbook_url", Value: book.URL})
												}
												Default for new contacts
											</label>
										</div>
									</label>
								}
							</div>
						</div>
					} else if strings.TrimSpace(data.ContactSync.AddressBookURL) != "" {
						<div class="sm:col-span-2 rounded-md border border-border bg-background/35 px-3 py-2" data-carddav-addressbook-section data-carddav-manual-addressbook>
							<label class="text-xs font-medium text-muted-foreground mb-1.5 block">Exact address book URL</label>
							@input.Input(input.Props{Name: "addressbook_url", Type: input.TypeURL, Value: data.ContactSync.AddressBookURL, Placeholder: "https://dav.example.com/addressbooks/user/default/"})
							<div data-server-check-url class="mt-1.5 hidden space-y-1" aria-live="polite"></div>
						</div>
					} else {
						<div class="hidden sm:col-span-2 rounded-md border border-border bg-background/35 px-3 py-2" data-carddav-addressbook-section data-carddav-manual-addressbook>
							<label class="text-xs font-medium text-muted-foreground mb-1.5 block">Exact address book URL</label>
							@input.Input(input.Props{Name: "addressbook_url", Type: input.TypeURL, Placeholder: "https://dav.example.com/addressbooks/user/default/"})
							<div data-server-check-url class="mt-1.5 hidden space-y-1" aria-live="polite"></div>
						</div>
					}
				</div>
				<div id={ fmt.Sprintf("account-contact-sync-status-%s", data.AccountID) } class="min-h-0"></div>
				<div class="flex flex-wrap justify-end gap-2">
					@CardDAVDiscoverAddressBooksButton(data.AccountID, fmt.Sprintf("account-contact-sync-fields-%s", data.AccountID), fmt.Sprintf("account-contact-sync-status-%s", data.AccountID), data.ContactSync.BaseURL)
					@CardDAVManualAddressBookButton(fmt.Sprintf("account-contact-sync-fields-%s", data.AccountID), data.ContactSync.BaseURL)
				</div>
			</form>
		}
	</div>
}

templ CalendarSyncSettings(data models.EditAccountData) {
	@CalendarSyncSettingsPanel(data, "", false)
}

templ CalendarSyncSettingsResult(data models.EditAccountData, message string, isError bool) {
	@CalendarSyncSettingsPanel(data, message, isError)
}

templ CalendarProviderAccessNotice(title string, message string) {
	<div class="rounded-lg border border-border bg-background/50 p-3 text-xs leading-relaxed text-muted-foreground">
		<p class="font-semibold text-foreground">{ title }</p>
		<p class="mt-0.5">{ message }</p>
	</div>
}

templ CalendarSyncSettingsPanel(data models.EditAccountData, message string, isError bool) {
	<div id={ fmt.Sprintf("account-calendar-sync-panel-%s", data.AccountID) } class="space-y-3" data-wizard-service-content="calendar">
		<div class="account-wizard-sticky-header flex items-start justify-between gap-4">
			<div class="min-w-0">
				<h4 class="flex items-center gap-2 text-sm font-semibold text-foreground">
					@icon.CalendarDays(icon.Props{Class: "size-4 text-muted-foreground"})
					Calendar sync
				</h4>
				<p class="mt-1 text-xs leading-relaxed text-muted-foreground">Choose whether this account contributes calendars to Raven.</p>
			</div>
			if data.CalendarSync.Enabled {
				<span class="shrink-0 rounded-full bg-emerald-500/10 px-2 py-0.5 text-[11px] font-semibold text-emerald-600 dark:text-emerald-400">Enabled</span>
			} else if data.CalendarSync.SourceCount > 0 {
				<span class="shrink-0 rounded-md bg-muted px-2 py-0.5 text-[11px] font-semibold text-muted-foreground">Not selected</span>
			} else {
				<span class="shrink-0 rounded-md bg-muted px-2 py-0.5 text-[11px] font-semibold text-muted-foreground">Not configured</span>
			}
		</div>
		<div data-wizard-service-status="calendar" class="min-h-0"></div>
		if data.Provider == "gmail" {
			@CalendarProviderAccessNotice("Google Calendar access", "Discovery uses this account's Google authorization. If Calendar access is missing, reconnect the account from its actions menu, then try again.")
			<form method="POST" action={ fmt.Sprintf("/api/accounts/%s/calendar/discover", data.AccountID) } data-calendar-discovery-form hx-post={ fmt.Sprintf("/api/accounts/%s/calendar/discover", data.AccountID) } hx-target={ fmt.Sprintf("#account-calendar-sync-panel-%s", data.AccountID) } hx-swap="outerHTML" data-on-htmx-before-request='["handleCalendarDiscoveryStart","$event"]' data-on-htmx-after-request='["handleCalendarDiscoveryResult","$event"]' class="flex justify-end">
				<button type="submit" data-calendar-discovery-submit class="inline-flex h-8 items-center gap-1.5 rounded-md bg-primary px-3 text-xs font-semibold text-primary-foreground transition-colors hover:bg-primary/90 disabled:pointer-events-none disabled:opacity-70">
					@icon.RefreshCw(icon.Props{Class: "size-3.5"})
					<span data-calendar-discovery-label>
						if data.CalendarSync.SourceCount > 0 {
							Refresh calendars
						} else {
							Discover calendars
						}
					</span>
				</button>
			</form>
		} else if data.Provider == "outlook" {
			@CalendarProviderAccessNotice("Microsoft Calendar access", "Discovery uses this account's Microsoft authorization. If Calendar access is missing, reconnect the account from its actions menu, then try again.")
			<form method="POST" action={ fmt.Sprintf("/api/accounts/%s/calendar/discover", data.AccountID) } data-calendar-discovery-form hx-post={ fmt.Sprintf("/api/accounts/%s/calendar/discover", data.AccountID) } hx-target={ fmt.Sprintf("#account-calendar-sync-panel-%s", data.AccountID) } hx-swap="outerHTML" data-on-htmx-before-request='["handleCalendarDiscoveryStart","$event"]' data-on-htmx-after-request='["handleCalendarDiscoveryResult","$event"]' class="flex justify-end">
				<button type="submit" data-calendar-discovery-submit class="inline-flex h-8 items-center gap-1.5 rounded-md bg-primary px-3 text-xs font-semibold text-primary-foreground transition-colors hover:bg-primary/90 disabled:pointer-events-none disabled:opacity-70">
					@icon.RefreshCw(icon.Props{Class: "size-3.5"})
					<span data-calendar-discovery-label>
						if data.CalendarSync.SourceCount > 0 {
							Refresh calendars
						} else {
							Discover calendars
						}
					</span>
				</button>
			</form>
		} else if data.Provider == "imap" {
			<form method="POST" action={ fmt.Sprintf("/api/accounts/%s/calendar/discover", data.AccountID) } data-calendar-discovery-form hx-post={ fmt.Sprintf("/api/accounts/%s/calendar/discover", data.AccountID) } hx-target={ fmt.Sprintf("#account-calendar-sync-panel-%s", data.AccountID) } hx-swap="outerHTML" data-on-htmx-before-request='["handleCalendarDiscoveryStart","$event"]' data-on-htmx-after-request='["handleCalendarDiscoveryResult","$event"]' class="space-y-3">
				<div class="grid gap-3 sm:grid-cols-2">
					<div class="sm:col-span-2">
						<div class="mb-1.5 flex flex-col gap-1.5 sm:flex-row sm:items-center sm:justify-between">
							<label class="text-xs font-medium text-muted-foreground">Base URL</label>
							<button type="button" data-calendar-autodiscover class="inline-flex h-8 w-fit shrink-0 items-center gap-1.5 rounded-md border border-primary/30 bg-primary/10 px-3 text-xs font-semibold text-primary shadow-sm transition-colors hover:border-primary/45 hover:bg-primary/15 disabled:pointer-events-none disabled:opacity-70">
								@icon.Search(icon.Props{Class: "size-3.5"})
								<span data-calendar-autodiscover-label>Attempt URL autodiscover</span>
							</button>
						</div>
						@input.Input(input.Props{Name: "caldav_url", Type: input.TypeURL, Value: data.CalendarSync.CalDAVBaseURL, Placeholder: "https://cdav.migadu.com"})
						<div data-server-check-url class="mt-1.5 hidden space-y-1" aria-live="polite"></div>
					</div>
					<label class="sm:col-span-2 flex cursor-pointer items-center gap-2">
						@checkbox.Checkbox(checkbox.Props{
							Name:       "use_account_credentials",
							Value:      "1",
							Checked:    data.CalendarSync.CalDAVUseAccountCredentials,
							Attributes: templ.Attributes{"data-on-change": onAction("toggleCalendarAuth", actionElement)},
						})
						<span class="text-sm">Use same credentials as incoming mail</span>
					</label>
					<div class={ "sm:col-span-2 grid gap-3 sm:grid-cols-2", templ.KV("opacity-50", data.CalendarSync.CalDAVUseAccountCredentials) } data-calendar-credential-fields>
						<div>
							<label class="mb-1.5 block text-xs font-medium text-muted-foreground">Username</label>
							@input.Input(input.Props{Name: "username", Type: input.TypeText, Value: data.CalendarSync.CalDAVUsername, Placeholder: data.Username, Disabled: data.CalendarSync.CalDAVUseAccountCredentials})
						</div>
						<div>
							<label class="mb-1.5 block text-xs font-medium text-muted-foreground">Password or app password</label>
							@input.Input(input.Props{Name: "password", Type: input.TypePassword, Placeholder: calDAVPasswordPlaceholder(data.CalendarSync), Disabled: data.CalendarSync.CalDAVUseAccountCredentials})
						</div>
					</div>
				</div>
				<div class="flex flex-wrap justify-end gap-2">
					<button type="submit" data-calendar-discovery-submit class="inline-flex h-8 shrink-0 items-center gap-1.5 rounded-md bg-primary px-3 text-xs font-semibold text-primary-foreground transition-colors hover:bg-primary/90 disabled:pointer-events-none disabled:opacity-70">
						@icon.RefreshCw(icon.Props{Class: "size-3.5"})
						<span data-calendar-discovery-label>
							if data.CalendarSync.SourceCount > 0 {
								Refresh calendars
							} else {
								Discover calendars
							}
						</span>
					</button>
				</div>
			</form>
		} else {
			<div class="rounded-lg border border-border bg-background/50 p-4">
				<div class="flex items-start gap-3">
					<div class="mt-0.5 flex size-8 shrink-0 items-center justify-center rounded-md border border-border/70 bg-card text-muted-foreground">
						@icon.LockKeyhole(icon.Props{Class: "size-4"})
					</div>
					<div class="min-w-0">
						<p class="text-xs font-semibold text-foreground">Calendar discovery is not available</p>
						<p class="mt-1 text-xs leading-relaxed text-muted-foreground">Calendar discovery is available for Google and Microsoft accounts. This account will remain out of the Calendar view until a source is connected and selected.</p>
					</div>
					<span class="shrink-0 rounded-full bg-muted px-2 py-0.5 text-[10px] font-semibold uppercase tracking-wide text-muted-foreground">Next</span>
				</div>
			</div>
		}
		if data.CalendarSync.SourceCount > 0 {
			<div class="rounded-lg border border-border bg-background/45 p-3">
				<div class="flex items-center justify-between gap-4">
					<div class="text-xs font-semibold text-foreground">Selected calendars</div>
					<span class="shrink-0 rounded-md bg-muted px-2 py-0.5 text-[11px] font-semibold text-muted-foreground">{ fmt.Sprintf("%d of %d selected", data.CalendarSync.SelectedSourceCount, data.CalendarSync.SourceCount) }</span>
				</div>
				<p class="mt-1 text-[11px] leading-relaxed text-muted-foreground">Select calendars to sync. Your choices are saved when you click Next.</p>
				<form
					method="POST"
					action={ fmt.Sprintf("/api/accounts/%s/calendar/sources", data.AccountID) }
					data-calendar-source-form
					data-account-id={ data.AccountID }
					hx-post={ fmt.Sprintf("/api/accounts/%s/calendar/sources", data.AccountID) }
					hx-target={ fmt.Sprintf("#account-calendar-sync-panel-%s", data.AccountID) }
					hx-swap="outerHTML"
					data-on-htmx-before-request='["handleCalendarSourceSaveStart","$event"]'
					data-on-htmx-after-request='["handleCalendarSourceSaveResult","$event"]'
					class="mt-3"
				>
					<div class="max-h-56 space-y-2 overflow-y-auto overscroll-contain pr-1">
						for _, source := range data.CalendarSync.Sources {
							<label class="flex w-full cursor-pointer items-start gap-3 rounded-md border border-border bg-background/35 px-3 py-2 text-xs transition-colors hover:bg-accent/50 has-[:checked]:border-primary/40 has-[:checked]:bg-primary/[0.06]">
								<span class="mt-0.5 inline-flex shrink-0">
									@checkbox.Checkbox(checkbox.Props{
										ID:      fmt.Sprintf("calendar-source-%s", source.ID),
										Name:    "source_id",
										Value:   source.ID,
										Checked: source.IsSelected,
										Attributes: templ.Attributes{
											"data-calendar-source-checkbox": "",
										},
									})
								</span>
								<span class="mt-1 size-2 shrink-0 rounded-full" style={ accountColorStyle(source.Color) }></span>
								<span class="min-w-0 flex-1">
									<span class="block truncate font-semibold text-foreground">{ calendarSourceName(source) }</span>
									if calendarSourceDetails(source) != "" {
										<span class="mt-0.5 block truncate text-[11px] text-muted-foreground">{ calendarSourceDetails(source) }</span>
									}
								</span>
								if source.IsPrimary {
									<span class="shrink-0 rounded-full bg-primary/10 px-2 py-0.5 text-[10px] font-semibold text-primary">Primary</span>
								}
							</label>
						}
					</div>
					<div data-calendar-source-save-status class="mt-3 min-h-0"></div>
				</form>
			</div>
		} else if data.Provider == "gmail" || data.Provider == "outlook" || data.Provider == "imap" {
			<div class="rounded-lg border border-border bg-background/50 p-3 text-xs leading-relaxed text-muted-foreground">
				<p class="font-semibold text-foreground">No calendars discovered yet</p>
				<p class="mt-0.5">Run discovery above. This account will appear in Calendar once at least one source is selected.</p>
			</div>
		}
		if message != "" {
			if isError {
				<div role="alert" class="rounded-lg border border-destructive/30 bg-destructive/5 px-3 py-2 text-xs leading-relaxed text-destructive">{ message }</div>
			} else {
				<div role="status" class="rounded-lg border border-emerald-500/25 bg-emerald-500/5 px-3 py-2 text-xs leading-relaxed text-emerald-700 dark:text-emerald-300">{ message }</div>
			}
		}
	</div>
}

templ CalendarSetupNotice() {
	<div data-wizard-service-content="calendar" data-wizard-service-always-active="true" class="rounded-lg border border-border bg-background/45 p-4">
		<div class="flex items-start justify-between gap-4">
			<div class="flex min-w-0 items-start gap-3">
				<div class="mt-0.5 flex size-8 shrink-0 items-center justify-center rounded-md border border-border/70 bg-card text-muted-foreground">
					@icon.CalendarDays(icon.Props{Class: "size-4"})
				</div>
				<div class="min-w-0">
					<h4 class="text-sm font-semibold text-foreground">Calendar sync</h4>
					<p class="mt-1 text-xs leading-relaxed text-muted-foreground">Calendar setup is optional and depends on the provider. Google and Microsoft use account authorization; IMAP mailboxes can connect a separate CalDAV service.</p>
				</div>
			</div>
			<span class="shrink-0 rounded-full bg-muted px-2 py-0.5 text-[11px] font-semibold text-muted-foreground">Available</span>
		</div>
		<p class="mt-3 border-t border-border/60 pt-3 text-[11px] leading-relaxed text-muted-foreground">This account will not appear in Calendar until a calendar source has been discovered and selected.</p>
	</div>
}

func contactSyncPasswordPlaceholder(cfg models.ContactSyncConfig) string {
	if cfg.HasPassword {
		return "Leave blank to keep current"
	}
	return "App password"
}

func calDAVPasswordPlaceholder(cfg models.CalendarSyncConfig) string {
	if cfg.CalDAVHasPassword {
		return "Leave blank to keep current"
	}
	return "App password"
}

func contactAddressBookName(book models.ContactAddressBook) string {
	if strings.TrimSpace(book.Name) != "" {
		return strings.TrimSpace(book.Name)
	}
	return "Address book"
}

func contactSyncHasDefaultBook(books []models.ContactAddressBook) bool {
	for _, book := range books {
		if book.Default {
			return true
		}
	}
	return false
}

templ CardDAVBaseURLRequiredTooltip(hidden bool) {
	<span data-carddav-disabled-action class={ "inline-flex", templ.KV("!hidden", hidden) }>
		@tooltip.Tooltip() {
			@tooltip.Trigger(tooltip.TriggerProps{Class: "inline-flex"}) {
				<span class="inline-flex cursor-not-allowed" title="Fill the Base URL first, or use Attempt URL autodiscover.">
					{ children... }
				</span>
			}
			@tooltip.Content(tooltip.ContentProps{Position: tooltip.PositionTop, ShowArrow: true, Class: "max-w-56 px-3 py-1.5 text-center text-xs leading-relaxed"}) {
				Fill the Base URL first, or use Attempt URL autodiscover.
			}
		}
	</span>
}

templ CardDAVAutodiscoverButton(accountID string, fieldsID string, statusID string) {
	@button.Button(button.Props{
		Variant: button.VariantOutline,
		Size:    button.SizeSm,
		Class:   "h-8 w-fit shrink-0 gap-1.5 border-primary/30 bg-primary/10 px-3 text-xs font-semibold text-primary shadow-sm hover:border-primary/45 hover:bg-primary/15 hover:text-primary dark:border-primary/35 dark:bg-primary/15 dark:hover:border-primary/55 dark:hover:bg-primary/20",
		Attributes: templ.Attributes{
			"data-carddav-discover":      "",
			"data-carddav-autodiscover": "true",
			"data-account-id":           accountID,
			"data-fields-id":            fieldsID,
			"data-status-id":            statusID,
		},
	}) {
		@icon.Search(icon.Props{Class: "size-3.5"})
		Attempt URL autodiscover
	}
}

templ CardDAVDiscoverAddressBooksButton(accountID string, fieldsID string, statusID string, baseURL string) {
	{{ disabled := strings.TrimSpace(baseURL) == "" }}
	<span data-carddav-base-url-action data-fields-id={ fieldsID } class="contents">
		<button type="button" data-carddav-enabled-action data-carddav-discover data-account-id={ accountID } data-fields-id={ fieldsID } data-status-id={ statusID } class={ "inline-flex items-center gap-1.5 rounded-md border border-border px-3 py-2 text-xs font-semibold text-foreground hover:bg-accent", templ.KV("!hidden", disabled) }>
			@icon.Search(icon.Props{Class: "size-3.5"})
			Connect and discover address books
		</button>
		@CardDAVBaseURLRequiredTooltip(!disabled) {
			<button type="button" disabled class="pointer-events-none inline-flex items-center gap-1.5 rounded-md border border-border px-3 py-2 text-xs font-semibold text-muted-foreground opacity-50">
				@icon.Search(icon.Props{Class: "size-3.5"})
				Connect and discover address books
			</button>
		}
	</span>
}

templ CardDAVManualAddressBookButton(fieldsID string, baseURL string) {
	{{ disabled := strings.TrimSpace(baseURL) == "" }}
	<span data-carddav-base-url-action data-fields-id={ fieldsID } class="contents">
		<button type="button" data-carddav-enabled-action data-carddav-manual data-fields-id={ fieldsID } class={ "inline-flex items-center gap-1.5 rounded-md border border-border px-3 py-2 text-xs font-semibold text-foreground hover:bg-accent", templ.KV("!hidden", disabled) }>
			@icon.Pencil(icon.Props{Class: "size-3.5"})
			Enter address book URL manually
		</button>
		@CardDAVBaseURLRequiredTooltip(!disabled) {
			<button type="button" disabled class="pointer-events-none inline-flex items-center gap-1.5 rounded-md border border-border px-3 py-2 text-xs font-semibold text-muted-foreground opacity-50">
				@icon.Pencil(icon.Props{Class: "size-3.5"})
				Enter address book URL manually
			</button>
		}
	</span>
}

templ AddAccountPostCreateStep(data models.EditAccountData) {
	{{ accountID := data.AccountID }}
	<div id="add-wizard-footer-step-4" data-wizard-footer-step="4" data-active="false" hx-swap-oob="outerHTML" class="hidden flex-wrap justify-end gap-2">
		<button type="submit" form={ fmt.Sprintf("add-contact-sync-form-%s", accountID) } class="inline-flex items-center gap-1.5 rounded-lg bg-primary px-4 py-2 text-sm font-medium text-primary-foreground hover:bg-primary/90 transition-colors">
			Next
			@icon.ChevronRight(icon.Props{Class: "size-4"})
		</button>
	</div>
	<div id="add-wizard-footer-step-5" data-wizard-footer-step="5" data-active="false" hx-swap-oob="outerHTML" class="hidden flex-wrap justify-between gap-2">
		<button type="button" data-on-click='["wizardGo",4]' class="inline-flex items-center gap-1.5 rounded-md border border-border px-3 py-2 text-sm text-muted-foreground transition-colors hover:bg-accent hover:text-foreground">
			@icon.ArrowLeft(icon.Props{Class: "size-4"})
			Back
		</button>
		<button type="button" data-on-click='["wizardServiceNext","$this","calendar","done"]' class="inline-flex items-center gap-1.5 rounded-lg bg-primary px-4 py-2 text-sm font-medium text-primary-foreground transition-colors hover:bg-primary/90">
			@icon.Check(icon.Props{Class: "size-4"})
			Done
		</button>
	</div>
	<div id="add-calendar-content" hx-swap-oob="innerHTML">
		@CalendarSyncSettings(data)
	</div>
	@AccountWizardSectionSwitch("wizardGo", accountID, "calendar", data.CalendarSync.Enabled, false, false, true, nil)
	<div class="flex h-full flex-col pt-1">
		<div class="account-wizard-scroll space-y-5">
		<div data-add-account-created hidden></div>
		<div data-wizard-service-content="contacts" class="space-y-5">
		<h4 class="account-wizard-sticky-header text-sm font-semibold text-foreground flex items-center gap-2">
			@icon.BookUser(icon.Props{Class: "size-4 text-muted-foreground"})
			Contact sync
		</h4>
		<form id={ fmt.Sprintf("add-contact-sync-form-%s", accountID) } data-wizard-contact-form data-wizard-next-step="5" hx-post={ fmt.Sprintf("/api/accounts/%s/contacts/sync", accountID) } hx-target={ fmt.Sprintf("#add-contact-sync-status-%s", accountID) } hx-swap="innerHTML" class="rounded-lg border border-border bg-background/45 p-4">
			<div class="mb-3 flex items-start justify-between gap-4">
				<div class="min-w-0">
					<h4 class="flex items-center gap-2 text-sm font-semibold text-foreground">
						@icon.BookUser(icon.Props{Class: "size-4 text-muted-foreground"})
						Contact sync
					</h4>
					<p class="mt-1 text-xs leading-relaxed text-muted-foreground">Enable this only if the account has a CardDAV address book.</p>
				</div>
				<span class="shrink-0 rounded-full bg-muted px-2 py-0.5 text-xs font-semibold text-muted-foreground">Optional</span>
			</div>
			<div id={ fmt.Sprintf("add-contact-sync-fields-%s", accountID) } class="space-y-3">
				<div class="grid gap-3 sm:grid-cols-2">
					<div class="sm:col-span-2">
						<div class="mb-1.5 flex flex-col gap-1.5 sm:flex-row sm:items-center sm:justify-between">
							<label class="text-xs font-medium text-muted-foreground">Base URL</label>
							@CardDAVAutodiscoverButton(accountID, fmt.Sprintf("add-contact-sync-fields-%s", accountID), fmt.Sprintf("add-contact-sync-status-%s", accountID))
						</div>
						@input.Input(input.Props{Name: "base_url", Type: input.TypeURL, Placeholder: "https://dav.example.com/"})
						<div data-server-check-url class="mt-1.5 hidden space-y-1" aria-live="polite"></div>
					</div>
					<label class="flex items-center gap-2 cursor-pointer sm:col-span-2">
						@checkbox.Checkbox(checkbox.Props{
							Name:       "use_account_credentials",
							Value:      "1",
							Checked:    true,
							Attributes: templ.Attributes{"data-on-change": onAction("toggleCardDAVAuth", actionElement)},
						})
						<span class="text-sm">Use same credentials as incoming mail</span>
					</label>
					<div class="sm:col-span-2 grid gap-3 sm:grid-cols-2 opacity-50" data-carddav-credential-fields>
						<div>
							<label class="mb-1.5 block text-xs font-medium text-muted-foreground">Username</label>
							@input.Input(input.Props{Name: "username", Type: input.TypeText, Placeholder: "Same as incoming mail", Disabled: true})
						</div>
						<div>
							<label class="mb-1.5 block text-xs font-medium text-muted-foreground">Password or app password</label>
							@input.Input(input.Props{Name: "password", Type: input.TypePassword, Placeholder: "Same as incoming mail", Disabled: true})
						</div>
					</div>
					<div class="hidden sm:col-span-2 rounded-md border border-border bg-background/35 px-3 py-2" data-carddav-addressbook-section data-carddav-manual-addressbook>
						<label class="mb-1.5 block text-xs font-medium text-muted-foreground">Exact address book URL</label>
						@input.Input(input.Props{Name: "addressbook_url", Type: input.TypeURL, Placeholder: "https://dav.example.com/addressbooks/user/default/"})
						<div data-server-check-url class="mt-1.5 hidden space-y-1" aria-live="polite"></div>
					</div>
				</div>
			</div>
			<div id={ fmt.Sprintf("add-contact-sync-status-%s", accountID) } class="mt-3 min-h-0"></div>
			<div class="mt-4 flex flex-wrap justify-end gap-2">
				@CardDAVDiscoverAddressBooksButton(accountID, fmt.Sprintf("add-contact-sync-fields-%s", accountID), fmt.Sprintf("add-contact-sync-status-%s", accountID), "")
				@CardDAVManualAddressBookButton(fmt.Sprintf("add-contact-sync-fields-%s", accountID), "")
			</div>
		</form>
		</div>
		</div>
		<div class="account-wizard-controls flex flex-wrap justify-between gap-2">
			<button type="button" data-on-click='["wizardGo",2]' class="inline-flex items-center gap-1.5 rounded-md border border-border px-3 py-2 text-sm text-muted-foreground transition-colors hover:bg-accent hover:text-foreground">
				@icon.ArrowLeft(icon.Props{Class: "size-4"})
				Back
			</button>
			<button type="submit" form={ fmt.Sprintf("add-contact-sync-form-%s", accountID) } class="inline-flex items-center gap-1.5 rounded-lg bg-primary px-4 py-2 text-sm font-medium text-primary-foreground hover:bg-primary/90 transition-colors">
				Next
				@icon.ChevronRight(icon.Props{Class: "size-4"})
			</button>
		</div>
	</div>
}

// AccountChangesSaved confirms that the edit wizard saved the mail changes.
templ AccountChangesSaved() {
	<div role="status" class="rounded-md border border-border bg-muted/35 px-3 py-2 text-xs text-foreground">Changes saved.</div>
}

func syncFolderDisplayName(f models.FolderSyncStatus) string {
	if remoteID := strings.TrimSpace(f.RemoteID); remoteID != "" {
		return remoteID
	}
	if name := strings.TrimSpace(f.Name); name != "" {
		return name
	}
	return f.Role
}

func syncSettingsHasConfigurableFolderModes(settings models.SyncSettings) bool {
	for _, account := range settings.Accounts {
		if !syncSettingsAccountUsesProviderAPI(account.Provider) {
			return true
		}
	}
	return false
}

func syncSettingsAccountUsesProviderAPI(provider string) bool {
	switch strings.ToLower(strings.TrimSpace(provider)) {
	case "gmail", "outlook":
		return true
	default:
		return false
	}
}

func syncSettingsProviderAPITitle(provider string) string {
	if strings.EqualFold(strings.TrimSpace(provider), "outlook") {
		return "Outlook Graph sync"
	}
	return "Gmail API sync"
}

func syncSettingsProviderAPIDescription(provider string) string {
	if strings.EqualFold(strings.TrimSpace(provider), "outlook") {
		return "Outlook sync uses Microsoft Graph delta changes instead of per-folder IMAP IDLE. The scheduled interval remains a whole-account background check."
	}
	return "Gmail sync uses Gmail API history changes instead of per-folder IMAP IDLE. The scheduled interval remains a whole-account background check."
}

templ AccountFormError(message string) {
	<div class="space-y-4" data-account-form-error>
		<div class="flex items-center gap-3 p-3 rounded-lg bg-destructive/10 border border-destructive/20">
			@icon.CircleAlert(icon.Props{Class: "size-5 text-destructive"})
			<p class="text-sm text-destructive">{ message }</p>
		</div>
		<div class="flex justify-end pt-2">
		<a href="/settings/accounts" class="inline-flex items-center gap-1.5 text-sm text-muted-foreground hover:text-foreground transition-colors px-3 py-1.5 rounded-md border border-border hover:bg-accent">
			@icon.ArrowLeft(icon.Props{Class: "size-4"})
			Try Again
		</a>
		</div>
	</div>
}

templ ConnectionTestResults(results []models.ConnectionTestResult, accountID string, wizardType string) {
	<div class="min-w-0 space-y-3 [overflow-wrap:anywhere]">
		<div class={ "grid grid-cols-1 gap-3", templ.KV("sm:grid-cols-2", len(results) > 1) }>
			for _, r := range results {
				<div class={
					"flex items-center gap-3 p-3 rounded-lg border",
					templ.KV("bg-muted/35 border-border", r.Success),
					templ.KV("bg-destructive/10 border-destructive/20", !r.Success),
				}>
					if r.Success {
						@icon.Check(icon.Props{Class: "size-5 text-muted-foreground"})
					} else {
						@icon.X(icon.Props{Class: "size-5 text-destructive"})
					}
					<div class="flex-1 min-w-0">
						<div class="flex items-center gap-2">
							<span class="text-xs font-semibold text-muted-foreground">{ r.Service }</span>
							if r.Success {
								<span class="text-xs text-muted-foreground font-medium">{ r.Message }</span>
							}
						</div>
						if !r.Success {
							<p class="text-xs text-destructive mt-0.5">{ r.Error }</p>
							<p class="text-xs text-muted-foreground mt-0.5">{ r.Message }</p>
						}
					</div>
				</div>
			}
		</div>
		if wizardType == "" {
			<button
				class="w-full inline-flex items-center justify-center gap-1.5 text-sm font-medium px-4 py-2 rounded-lg border border-border hover:bg-accent transition-colors"
				hx-post={ fmt.Sprintf("/api/accounts/%s/test", accountID) }
				hx-target="#test-results"
				hx-swap="outerHTML"
			>
				@icon.RefreshCw(icon.Props{Class: "size-4"})
				Retry
			</button>
		}
	</div>
}

func mailOperationTypeLabel(operationType string) string {
	switch operationType {
	case models.MailOperationMessageMutation:
		return "Message change"
	case models.MailOperationLabelMutation:
		return "Label change"
	case models.MailOperationIMAPDraft, models.MailOperationProviderDraft:
		return "Draft sync"
	case models.MailOperationSentCopy:
		return "Sent copy"
	default:
		return "Mail operation"
	}
}

func mailOperationStateLabel(operation models.MailOperationSummary) string {
	if operation.State == "blocked" {
		return "Blocked"
	}
	if operation.Ambiguous {
		return "Needs reconciliation"
	}
	if operation.CanRetry {
		return "Failed"
	}
	switch operation.State {
	case "failed":
		return "Failed"
	case "pending":
		return "Queued"
	case "processing", "syncing", "sent_copy_copying":
		return "In progress"
	case "sent_copy_pending":
		return "Waiting to copy"
	default:
		return "Waiting"
	}
}

func mailOperationTargetLabel(operation models.MailOperationSummary) string {
	parts := make([]string, 0, 3)
	if operation.Operation != "" {
		parts = append(parts, strings.ReplaceAll(operation.Operation, "_", " "))
	}
	if operation.LabelName != "" {
		parts = append(parts, "“"+operation.LabelName+"”")
	}
	if operation.FolderName != "" {
		if operation.DestinationFolderName != "" {
			parts = append(parts, operation.FolderName+" → "+operation.DestinationFolderName)
		} else {
			parts = append(parts, operation.FolderName)
		}
	}
	if len(parts) == 0 && operation.DraftKey != "" {
		return operation.DraftKey
	}
	return strings.Join(parts, " · ")
}

func mailOperationTimeLabel(value time.Time) string {
	if value.IsZero() {
		return "Not scheduled"
	}
	return value.Local().Format("Jan 2, 3:04 PM")
}

func mailOperationActionLabel(operation models.MailOperationSummary) string {
	if operation.CanReconcile {
		return "Reconcile now"
	}
	return "Retry now"
}

templ SettingsOperationsTab() {
	<div class="mt-6 space-y-6">
		<div class="settings-card bg-card rounded-lg border p-6">
			<div class="flex items-start gap-3">
				<div class="mt-0.5 flex size-8 shrink-0 items-center justify-center rounded-md border border-border/70 bg-background text-muted-foreground">
					@icon.ClipboardList(icon.Props{Class: "size-4"})
				</div>
				<div>
					<h3 class="text-sm font-semibold text-muted-foreground">Mail operations</h3>
					<p class="mt-1 text-xs leading-relaxed text-muted-foreground">See background message changes, draft sync, labels, and Sent copies that are still queued or need attention. Retrying here keeps the original operation identity.</p>
				</div>
			</div>
		</div>
		<div id="mail-operations-content" hx-get="/settings/operations/content" hx-trigger="load" hx-swap="outerHTML" class="settings-card rounded-lg border bg-card p-6 text-sm text-muted-foreground">
			Loading mail operations...
		</div>
	</div>
}

templ SettingsOperationsContent(status models.MailOperationsStatus) {
	<div id="mail-operations-content" hx-get="/settings/operations/content" hx-trigger="every 30s" hx-swap="outerHTML" class="settings-card rounded-lg border bg-card p-6 space-y-4">
		<div class="flex items-start justify-between gap-3">
			<div>
				<h3 class="text-sm font-semibold text-muted-foreground">Background mail work</h3>
				<p class="mt-1 text-xs text-muted-foreground">{ fmt.Sprintf("%d operation(s) currently retained locally", status.Total) }</p>
			</div>
			if status.ActionRequired > 0 {
				<span class="inline-flex shrink-0 items-center gap-1.5 rounded-full border border-amber-500/25 bg-amber-500/10 px-2 py-1 text-xs font-semibold text-amber-800 dark:text-amber-200">
					@icon.TriangleAlert(icon.Props{Class: "size-3.5"})
					{ fmt.Sprintf("%d need attention", status.ActionRequired) }
				</span>
			}
		</div>
		if len(status.Operations) == 0 {
			<div class="rounded-md border border-dashed border-border px-4 py-8 text-center text-xs text-muted-foreground">Nothing is waiting for provider work.</div>
		} else {
			<div class="space-y-2">
				for _, operation := range status.Operations {
					<div class={
						"settings-item rounded-lg border bg-background/40 p-4",
						templ.KV("border-amber-500/25", operation.CanRetry || operation.CanReconcile),
						templ.KV("border-border/60", !operation.CanRetry && !operation.CanReconcile),
					} data-mail-operation-id={ operation.ID }>
						<div class="flex flex-col gap-3 sm:flex-row sm:items-start sm:justify-between">
							<div class="min-w-0">
								<div class="flex flex-wrap items-center gap-2">
									<span class="text-sm font-semibold text-foreground">{ mailOperationTypeLabel(operation.Type) }</span>
									<span class={
										"rounded-full border px-2 py-0.5 text-xs font-semibold",
										templ.KV("border-amber-500/25 bg-amber-500/10 text-amber-800 dark:text-amber-200", operation.CanRetry || operation.CanReconcile),
										templ.KV("border-border bg-card text-muted-foreground", !operation.CanRetry && !operation.CanReconcile),
									}>{ mailOperationStateLabel(operation) }</span>
								</div>
								<div class="mt-1 text-xs text-muted-foreground">
									{ operation.AccountEmail }
									if mailOperationTargetLabel(operation) != "" {
										<span> · { mailOperationTargetLabel(operation) }</span>
									}
								</div>
								if operation.LastError != "" {
									<div class="mt-2 rounded-md border border-red-500/20 bg-red-500/10 px-3 py-2 text-xs leading-relaxed text-red-800 dark:text-red-200">{ operation.LastError }</div>
								}
								<div class="mt-2 text-xs text-muted-foreground">
									{ fmt.Sprintf("Attempt %d", operation.Attempts) } · next retry { mailOperationTimeLabel(operation.NextRetryAt) }
								</div>
							</div>
							<div class="flex shrink-0 items-center gap-2">
								if operation.CanRetry || operation.CanReconcile {
									<button type="button" data-mail-operation-retry data-mail-operation-id={ operation.ID } class="inline-flex items-center gap-1.5 rounded-md border border-border bg-card px-3 py-1.5 text-xs font-semibold text-foreground transition-colors hover:bg-accent">
										@icon.RefreshCw(icon.Props{Class: "size-3.5"})
										{ mailOperationActionLabel(operation) }
									</button>
								}
							</div>
						</div>
					</div>
				}
			</div>
		}
	</div>
}
