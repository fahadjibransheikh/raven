package views

import (
	"fmt"
	"strings"
	mailmessage "github.com/fahadjibransheikh/raven/internal/mail/message"
	"github.com/fahadjibransheikh/raven/internal/models"

	"github.com/fahadjibransheikh/raven/components/button"
	"github.com/fahadjibransheikh/raven/components/copybutton"
	"github.com/fahadjibransheikh/raven/components/dialog"
	"github.com/fahadjibransheikh/raven/components/dropdown"
	"github.com/fahadjibransheikh/raven/components/icon"
	"github.com/fahadjibransheikh/raven/components/popover"
	"github.com/fahadjibransheikh/raven/components/tabs"
	"github.com/fahadjibransheikh/raven/components/tooltip"

	"github.com/dustin/go-humanize"
)

func contactDisplay(c models.Contact) string {
	if c.Name != "" {
		return c.Name
	}
	return c.Email
}

// ThreadNewestFirst reports the reading order for conversations: newest message on
// top (the default) or, with thread_order=oldest_first, oldest on top.
func ThreadNewestFirst(settings map[string]string) bool {
	return uiSettingGet(settings, "thread_order", "newest_first") != "oldest_first"
}

// ThreadTargetID is the message an oldest-first thread scrolls to, as Gmail does: the
// oldest unread message, or the newest when everything is read. thread is oldest-first.
func ThreadTargetID(thread []models.ThreadItem) string {
	for _, item := range thread {
		if !item.IsRead {
			return item.ID
		}
	}
	if len(thread) == 0 {
		return ""
	}
	return thread[len(thread)-1].ID
}

// threadItemOpen says whether a thread message starts expanded. thread is in display
// order. Newest-first expands the newest message and every unread one; oldest-first
// expands only the scroll target.
func threadItemOpen(thread []models.ThreadItem, i int, newestFirst bool) bool {
	if newestFirst {
		return i == 0 || !thread[i].IsRead
	}
	return thread[i].ID == ThreadTargetID(thread)
}

// threadItemIsNewest is true for the message reply, reply-all and forward act on.
func threadItemIsNewest(thread []models.ThreadItem, i int, newestFirst bool) bool {
	if newestFirst {
		return i == 0
	}
	return i == len(thread)-1
}

templ MailViewAvatar(contact models.Contact, messageID string, class string, fallbackClass string) {
	if strings.TrimSpace(contact.AvatarURL) != "" {
		{{ dialogID := "mail-avatar-preview-" + messageID }}
		@dialog.Trigger(dialog.TriggerProps{For: dialogID, Class: "inline-flex shrink-0"}) {
			<button
				type="button"
				class="group relative inline-flex shrink-0 rounded-full focus:outline-none focus-visible:ring-2 focus-visible:ring-ink/25 focus-visible:ring-offset-2 focus-visible:ring-offset-paper"
				aria-label="View profile picture"
				data-contact-avatar-preview-trigger
				data-contact-avatar-preview-dialog={ dialogID }
				data-contact-avatar-preview-alt={ contactDisplay(contact) + " profile picture" }
				data-contact-avatar-preview-src={ contactAvatarRenderURL(contactAvatarPreviewURL(contact.AvatarURL)) }
			>
				@ContactAvatar(contact, class, fallbackClass)
				<span class="pointer-events-none absolute inset-0 flex items-center justify-center rounded-full bg-ink/0 text-white opacity-0 transition group-hover:bg-ink/25 group-hover:opacity-100 group-focus-visible:bg-ink/25 group-focus-visible:opacity-100">
					@icon.Search(icon.Props{Class: "size-4 drop-shadow"})
				</span>
			</button>
		}
		@ContactAvatarPreviewDialog(contact, dialogID)
	} else {
		@ContactAvatar(contact, class, fallbackClass)
	}
}

func threadAwareAction(singleFn, threadFn string, email *models.Email) string {
	if email.ThreadCount > 1 {
		return onAction(threadFn, email.ID)
	}
	return onAction(singleFn, email.ID)
}

// mailViewReadAttributes makes the toolbar read toggle act on the whole thread. Each thread
// message keeps its own toggle in its action row.
func mailViewReadAttributes(email *models.Email, thread []models.ThreadItem) templ.Attributes {
	read := fmt.Sprintf("%t", mailViewRead(email, thread))
	if email.ThreadCount > 1 {
		return templ.Attributes{"data-on-click": onAction("toggleThreadRead", email.ID), "data-read-thread": email.ID, "data-read-thread-id": email.ThreadID, "data-is-read": read}
	}
	return templ.Attributes{"data-on-click": onAction("toggleRead", email.ID), "data-read-email": email.ID, "data-is-read": read}
}

// mailViewRead reports whether the toolbar shows the message as read: for a thread, when
// every message in it is read.
func mailViewRead(email *models.Email, thread []models.ThreadItem) bool {
	if email.ThreadCount <= 1 || len(thread) == 0 {
		return email.IsRead
	}
	for _, item := range thread {
		if !item.IsRead {
			return false
		}
	}
	return true
}

// mailViewStarAttributes makes the toolbar star act on the whole thread, like the other
// toolbar actions. Each thread message keeps its own star in its action row.
func mailViewStarAttributes(email *models.Email) templ.Attributes {
	if email.ThreadCount > 1 {
		return templ.Attributes{"data-on-click": onAction("toggleThreadStar", email.ID), "data-star-thread": email.ID, "data-star-thread-id": email.ThreadID}
	}
	return templ.Attributes{"data-on-click": onAction("toggleStar", email.ID), "data-star-email": email.ID}
}

// mailViewStarred reports whether the toolbar star is filled: for a thread, when any of
// its messages is starred.
func mailViewStarred(email *models.Email, thread []models.ThreadItem) bool {
	if email.ThreadCount <= 1 || len(thread) == 0 {
		return email.IsStarred
	}
	for _, item := range thread {
		if item.IsStarred {
			return true
		}
	}
	return false
}

// mergeAttributes returns base with extra's entries added.
func mergeAttributes(base, extra templ.Attributes) templ.Attributes {
	out := templ.Attributes{}
	for key, value := range base {
		out[key] = value
	}
	for key, value := range extra {
		out[key] = value
	}
	return out
}

func threadAwareLabel(single, thread string, email *models.Email) string {
	if email.ThreadCount > 1 {
		return thread
	}
	return single
}

func formatContacts(contacts []models.Contact) string {
	parts := make([]string, len(contacts))
	for i, c := range contacts {
		if c.Name != "" {
			parts[i] = fmt.Sprintf("%s <%s>", c.Name, c.Email)
		} else {
			parts[i] = c.Email
		}
	}
	return strings.Join(parts, ", ")
}

func shouldShowAttachment(att models.Attachment) bool {
	if !att.Inline {
		return true
	}
	ct := strings.ToLower(att.ContentType)
	name := strings.ToLower(att.Filename)
	return !(strings.HasPrefix(ct, "image/") || strings.HasSuffix(name, ".png") || strings.HasSuffix(name, ".jpg") || strings.HasSuffix(name, ".jpeg") || strings.HasSuffix(name, ".gif") || strings.HasSuffix(name, ".webp") || strings.HasSuffix(name, ".svg"))
}

templ MailView(email *models.Email, thread []models.ThreadItem) {
	<div id="mail-view" class="hidden lg:flex flex-1 flex-col min-w-0 bg-background">
		if email != nil {
			@MailViewContent(email, thread, true)
		} else {
			@MailViewEmpty()
		}
	</div>
}

templ MailViewLoading() {
	<div id="mail-view" class="hidden lg:flex flex-1 flex-col min-w-0 bg-background">
		<div class="flex flex-col h-full p-2">
			<div class="bg-paper text-ink rounded-md flex flex-col h-full overflow-hidden">
				<div class="flex items-center justify-between px-6 py-2.5">
					<div class="flex items-center gap-1">
						<div class="size-8 rounded-md bg-ink/[0.03] border border-ink/6"></div>
						<div class="size-8 rounded-md bg-ink/[0.03] border border-ink/6"></div>
						<div class="size-8 rounded-md bg-ink/[0.03] border border-ink/6"></div>
					</div>
					<div class="h-4 w-20 rounded bg-ink/5 animate-pulse"></div>
				</div>
				<div class="h-px bg-border"></div>
				<div class="flex-1 overflow-y-auto">
					<div class="mx-auto px-8 py-6">
						<div class="flex items-start gap-4">
							<div class="size-11 rounded-full bg-muted shrink-0 animate-pulse"></div>
							<div class="flex-1 space-y-2">
								<div class="h-4 w-48 rounded bg-ink/5 animate-pulse"></div>
								<div class="h-3 w-64 rounded bg-ink/5 animate-pulse"></div>
							</div>
						</div>
						<div class="h-px bg-border my-6"></div>
						<div class="flex items-center gap-2 text-sm text-subtle-foreground">
							<div class="size-4 border-2 border-ink/15 border-t-ink/45 rounded-full animate-spin"></div>
							<span>Loading message...</span>
						</div>
						<div class="space-y-3 mt-5">
							<div class="h-4 w-full rounded bg-ink/5 animate-pulse"></div>
							<div class="h-4 w-11/12 rounded bg-ink/5 animate-pulse"></div>
							<div class="h-4 w-4/5 rounded bg-ink/5 animate-pulse"></div>
						</div>
					</div>
				</div>
			</div>
		</div>
	</div>
}

// MailViewContent renders a message or conversation. thread must already be in display
// order: newest first when newestFirst, else oldest first.
templ MailViewContent(email *models.Email, thread []models.ThreadItem, newestFirst bool) {
	{{ unsubID := ThreadUnsubscribeID(thread, newestFirst) }}
	<div class="mail-view-frame flex flex-col h-full p-2">
		<div class="bg-paper text-ink rounded-md flex flex-col h-full overflow-hidden">
			@MailViewHeader(email, thread)
			<div class="h-px bg-border"></div>
			<div class="flex-1 overflow-y-auto">
				<div class="mail-view-content mx-auto max-w-[720px] px-8 py-6">
					if thread != nil && len(thread) > 1 {
						<div class="mail-view-subject-row flex items-start justify-between gap-4 mb-1">
							<h1 class="text-[22px] leading-7 font-semibold tracking-tight text-foreground min-w-0 text-balance">{ email.Subject }</h1>
							@EmailBodyStyleTabs(email.ID, true, "h-8", "h-7")
						</div>
						@MailViewSignInCode(email)
						<div class="flex items-center gap-2 mb-6">
							@icon.MessagesSquare(icon.Props{Class: "size-3.5 text-subtle-foreground"})
							<span class="text-xs font-medium text-subtle-foreground">{ fmt.Sprintf("%d messages in this thread", len(thread)) }</span>
							<span class="text-xs text-subtle-foreground" aria-hidden="true">·</span>
							<button type="button" data-thread-expand-all class="flex items-center gap-1.5 text-xs text-subtle-foreground hover:text-foreground transition-colors cursor-pointer">
								@icon.ChevronsUpDown(icon.Props{Class: "size-3.5"})
								<span data-thread-expand-all-label>Expand all</span>
							</button>
						</div>
						for i, item := range thread {
							@MailViewThreadItemSender(email, &item, !newestFirst && threadItemOpen(thread, i, false))
							@SenderWarningBanner(item.SenderWarnings)
							@MailViewThreadItemMiniHeader(&item, threadItemIsNewest(thread, i, newestFirst))
							if len(item.Attachments) > 0 {
								@MailViewThreadItemAttachments(&item)
							}
							<details open?={ threadItemOpen(thread, i, newestFirst) } data-thread-details class="mt-4 group">
								<summary class="flex items-center gap-3 cursor-pointer list-none marker:hidden text-xs text-subtle-foreground transition-colors select-none">
									<span class="flex items-center gap-1.5 hover:text-foreground transition-colors">
										@icon.ChevronsDown(icon.Props{Class: "size-3.5 transition-transform group-open:rotate-180"})
										<span class="group-open:hidden">Show email</span>
										<span class="hidden group-open:inline">Hide email</span>
									</span>
									<span class="group-open:hidden">
										<span class="text-subtle-foreground" aria-hidden="true">·</span>
										<button type="button" data-thread-show-exclusive class="ml-1 text-subtle-foreground hover:text-foreground transition-colors cursor-pointer">Show only this</button>
									</span>
									<span class="hidden group-open:inline">
										<span class="text-subtle-foreground" aria-hidden="true">·</span>
										<button type="button" data-thread-hide-others class="ml-1 text-subtle-foreground hover:text-foreground transition-colors cursor-pointer">Collapse the rest</button>
									</span>
								</summary>
								<div class="thread-details-content mt-3">
									@MailViewBodyByID(item.ID)
									@MailViewThreadItemActions(&item, threadItemIsNewest(thread, i, newestFirst), item.ID == unsubID)
								</div>
							</details>
							<div class="h-px bg-ink/25 my-6"></div>
						}
					} else {
						@MailViewSender(email)
						@SenderWarningBanner(email.SenderWarnings)
						<div class="h-px bg-border my-6"></div>
						@MailViewBody(email)
					}
				</div>
			</div>
			<div id={"mail-calendar-footer-"+email.ID} data-mail-calendar-footer class="max-h-[35dvh] shrink-0 overflow-y-auto" hx-get={"/api/mail/"+email.ID+"/calendar"} hx-trigger="load" hx-swap="innerHTML" hx-sync="this:replace"></div>
			if thread == nil || len(thread) <= 1 {
				if email.IsDraft {
					@MailViewDraftBar(email)
				} else {
					@MailViewReplyBar(email)
				}
			}
		</div>
	</div>
}

templ MailViewThreadItemSender(email *models.Email, item *models.ThreadItem, isTarget bool) {
	<div class="mail-view-thread-sender flex items-start gap-4" data-thread-target?={ isTarget }>
		@MailViewAvatar(item.From, item.ID, "mail-view-avatar size-10 rounded-full text-sm font-medium shrink-0", contactAvatarThreadFallback(item.ID == email.ID))
		<div class="flex-1 min-w-0">
			<div class="flex items-center gap-2 flex-wrap">
				<span class="font-semibold text-ink">{ item.From.Name }</span>
				<span class="text-xs text-subtle-foreground">&lt;{ item.From.Email }&gt;</span>
				if item.FolderName != "" {
					<span class="text-xs font-medium text-subtle-foreground bg-ink/[0.04] px-1.5 py-0.5 rounded shrink-0">{ item.FolderName }</span>
				}
				for _, label := range item.Labels {
					<span class={ "text-xs px-1.5 py-0.5 rounded font-medium shrink-0", label.Color }>{ label.Name }</span>
				}
				if item.ID == email.ID {
					<span class="text-xs font-medium text-muted-foreground bg-muted px-1.5 py-0.5 rounded shrink-0">Current</span>
				}
			</div>
			<div class="text-xs text-subtle-foreground mt-0.5">
				if len(item.To) > 0 {
					to { contactDisplay(item.To[0]) }
					if len(item.To) > 1 {
						{ fmt.Sprintf(" and %d more", len(item.To)-1) }
					}
				}
				if len(item.CC) > 0 {
					, cc { contactDisplay(item.CC[0]) }
					if len(item.CC) > 1 {
						{ fmt.Sprintf(" and %d more", len(item.CC)-1) }
					}
				}
			</div>
			<div class="text-xs text-subtle-foreground mt-0.5">{ item.DateFull }</div>
		</div>
		@popover.Root() {
			@popover.Trigger() {
				<button type="button" aria-label="Message details" class="shrink-0 size-7 rounded flex items-center justify-center text-subtle-foreground hover:text-foreground hover:bg-row-hover transition-colors mt-0.5">
					@icon.EllipsisVertical(icon.Props{Class: "size-3.5"})
				</button>
			}
			@popover.Content(popover.ContentProps{
				Placement: popover.PlacementBottomEnd,
				Offset:    8,
				Class:     "w-80 p-0",
			}) {
				<div class="p-4 space-y-3">
					<div class="flex items-start gap-3">
						@ContactAvatar(item.From, "size-10 rounded-full text-sm font-medium shrink-0", "")
						<div class="flex-1 min-w-0">
							<div class="flex items-center gap-2">
								<span class="font-semibold text-sm text-ink truncate">{ item.From.Name }</span>
								@copybutton.CopyButton(copybutton.Props{
									TargetID: "detail-from-email-" + item.ID,
									Class:    "h-5 w-5",
								})
							</div>
							<p id={ "detail-from-email-" + item.ID } class="text-xs text-subtle-foreground truncate">{ item.From.Email }</p>
						</div>
					</div>
					if len(item.To) > 0 {
						<div>
							<span class="text-xs font-medium text-subtle-foreground">To</span>
							<div class="mt-1 space-y-0.5">
								for _, c := range item.To {
									<div class="flex items-center gap-2">
										<span class="text-sm text-ink truncate">{ contactDisplay(c) }</span>
										<span class="text-xs text-subtle-foreground truncate">&lt;{ c.Email }&gt;</span>
									</div>
								}
							</div>
						</div>
					}
					if len(item.CC) > 0 {
						<div>
							<span class="text-xs font-medium text-subtle-foreground">Cc</span>
							<div class="mt-1 space-y-0.5">
								for _, c := range item.CC {
									<div class="flex items-center gap-2">
										<span class="text-sm text-ink truncate">{ contactDisplay(c) }</span>
										<span class="text-xs text-subtle-foreground truncate">&lt;{ c.Email }&gt;</span>
									</div>
								}
							</div>
						</div>
					}
					if item.DateFull != "" {
						<div class="pt-2 border-t border-ink/6">
							<div class="flex items-center gap-2 text-xs text-subtle-foreground">
								@icon.Clock(icon.Props{Class: "size-3.5 shrink-0"})
								<span>{ item.DateFull }</span>
							</div>
						</div>
					}
				</div>
			}
		}
	</div>
}

templ MailViewThreadItemAttachments(item *models.ThreadItem) {
	<div class="mt-5 space-y-2">
		for _, att := range item.Attachments {
			if shouldShowAttachment(att) {
				<div class="mail-view-attachment flex items-center gap-3 px-4 py-2.5 rounded-lg border border-ink/8">
					<div class="flex items-center justify-center size-9 rounded-md bg-ink/[0.03] shadow-[0_1px_2px_rgba(0,0,0,0.06)_inset]">
						@icon.File(icon.Props{Class: "size-4 text-subtle-foreground"})
					</div>
					<div class="flex-1 min-w-0">
						<p class="text-sm font-medium text-ink truncate">{ att.Filename }</p>
						<p class="text-xs text-subtle-foreground">{ humanize.Bytes(uint64(att.SizeBytes)) }</p>
					</div>
					<a href={ fmt.Sprintf("/api/attachments/%d/download", att.ID) } download>
						@button.Button(button.Props{
							Variant: button.VariantOutline,
							Size:    button.SizeSm,
							Class:   "shrink-0 border-ink/10 text-muted-foreground hover:text-ink",
						}) {
							<span class="flex items-center gap-1.5">
								@icon.Download(icon.Props{Class: "size-3.5"})
								Download
							</span>
						}
					</a>
				</div>
			}
		}
	</div>
}

templ MailViewThreadItemMiniHeader(item *models.ThreadItem, isNewest bool) {
	<div class="flex items-center gap-0.5 mt-2 -ml-1">
		@tooltip.Tooltip() {
			@tooltip.Trigger() {
				@button.Button(button.Props{
					Variant:    button.VariantGhost,
					Size:       button.SizeIcon,
					Class:      "h-7 w-7",
					Attributes: templ.Attributes{"data-on-click": onAction("toggleStar", item.ID), "data-star-email": item.ID},
				}) {
					if item.IsStarred {
						@icon.Star(icon.Props{Class: "size-3.5 text-warning fill-warning drop-shadow-[0_1px_1px_rgba(180,120,0,0.3)]"})
					} else {
						@icon.Star(icon.Props{Class: "size-3.5 text-subtle-foreground"})
					}
				}
			}
			@tooltip.Content(tooltip.ContentProps{
				Position:  tooltip.PositionBottom,
				ShowArrow: true,
			}) {
				Star
			}
		}
		@tooltip.Tooltip() {
			@tooltip.Trigger() {
				@button.Button(button.Props{
					Variant:    button.VariantGhost,
					Size:       button.SizeIcon,
					Class:      mailDeleteActionClass("h-7 w-7", "text-subtle-foreground hover:text-foreground hover:bg-row-hover", mailThreadItemIsTrash(item)),
					Attributes: templ.Attributes{"data-on-click": onAction("deleteMessage", item.ID)},
				}) {
					@icon.Trash2(icon.Props{Class: "size-3.5"})
				}
			}
			@tooltip.Content(tooltip.ContentProps{
				Position:  tooltip.PositionBottom,
				ShowArrow: true,
			}) {
				if mailThreadItemIsTrash(item) {
					Permanently delete
				} else {
					Delete
				}
			}
		}
		@tooltip.Tooltip() {
			@tooltip.Trigger() {
				@button.Button(button.Props{
					Variant:    button.VariantGhost,
					Size:       button.SizeIcon,
					Class:      "h-7 w-7 text-subtle-foreground hover:text-foreground hover:bg-row-hover",
					Attributes: templ.Attributes{"data-on-click": onAction("toggleRead", item.ID), "data-read-email": item.ID, "data-is-read": fmt.Sprintf("%t", item.IsRead)},
				}) {
					if item.IsRead {
						@icon.Mail(icon.Props{Class: "size-3.5"})
					} else {
						@icon.MailOpen(icon.Props{Class: "size-3.5"})
					}
				}
			}
			@tooltip.Content(tooltip.ContentProps{
				Position:  tooltip.PositionBottom,
				ShowArrow: true,
			}) {
				if item.IsRead {
					Mark as unread
				} else {
					Mark as read
				}
			}
		}
		if !item.IsDraft {
			@MailViewThreadItemQuickReply(item, isNewest)
		}
	</div>
}

// Reply, reply all and forward stay reachable while a thread message is
// collapsed. handleReply reads the message and account ids from this element;
// data-thread-newest marks the newest message for the keyboard shortcuts.
templ MailViewThreadItemQuickReply(item *models.ThreadItem, isNewest bool) {
	<div class="mail-view-thread-quick-reply ml-auto flex items-center gap-0.5" data-thread-reply-data data-thread-newest?={ isNewest } data-message-id={ item.InternetMessageID } data-account-id={ item.AccountID }>
		@mailViewThreadQuickReplyButton("reply", "Reply") {
			@icon.Reply(icon.Props{Class: "size-3.5"})
		}
		@mailViewThreadQuickReplyButton("reply-all", "Reply all") {
			@icon.ReplyAll(icon.Props{Class: "size-3.5"})
		}
		@mailViewThreadQuickReplyButton("forward", "Forward") {
			@icon.Forward(icon.Props{Class: "size-3.5"})
		}
	</div>
}

templ mailViewThreadQuickReplyButton(mode string, label string) {
	@tooltip.Tooltip() {
		@tooltip.Trigger() {
			@button.Button(button.Props{
				Variant:    button.VariantGhost,
				Size:       button.SizeIcon,
				Class:      "h-7 w-7 text-subtle-foreground hover:text-foreground hover:bg-row-hover",
				Attributes: templ.Attributes{"data-on-click": onAction("handleReply", actionElement, mode), "aria-label": label},
			}) {
				{ children... }
			}
		}
		@tooltip.Content(tooltip.ContentProps{
			Position:  tooltip.PositionBottom,
			ShowArrow: true,
		}) {
			{ label }
		}
	}
}

templ EmailBodyStyleTabs(emailID string, global bool, listHeight string, triggerHeight string) {
	@tabs.Tabs(tabs.Props{Class: "gap-0 shrink-0", Attributes: templ.Attributes{"data-email-body-style-toggle": emailID, "data-force-email-scheme": emailID, "aria-label": "Change email body style"}}) {
		@tabs.List(tabs.ListProps{Class: "bg-card"}) {
			@tabs.Trigger(tabs.TriggerProps{Value: "dark", IsActive: true, Attributes: templ.Attributes{"data-email-body-mode-button": "dark", "data-email-body-mode-global": global, "aria-label": "Use dark email body"}}) {
				@icon.Moon(icon.Props{Class: "size-3.5"})
				Dark
			}
			@tabs.Trigger(tabs.TriggerProps{Value: "light", Attributes: templ.Attributes{"data-email-body-mode-button": "light", "data-email-body-mode-global": global, "aria-label": "Use light email body"}}) {
				@icon.Sun(icon.Props{Class: "size-3.5"})
				Light
			}
			@tabs.Trigger(tabs.TriggerProps{Value: "original", Attributes: templ.Attributes{"data-email-body-mode-button": "original", "data-email-body-mode-global": global, "aria-label": "View original email style"}}) {
				@icon.FileText(icon.Props{Class: "size-3.5"})
				Original
			}
		}
		@tabs.Content(tabs.ContentProps{Value: "dark", IsActive: true, Class: "sr-only"}) {}
		@tabs.Content(tabs.ContentProps{Value: "light", Class: "sr-only"}) {}
		@tabs.Content(tabs.ContentProps{Value: "original", Class: "sr-only"}) {}
	}
}

templ MailViewThreadItemActions(item *models.ThreadItem, isNewest bool, showUnsubscribe bool) {
	if item.IsDraft {
		// A draft in a thread is picked up again here, like a draft opened on its own.
		<div class="mt-4 pt-3 border-t border-ink/6" data-thread-draft-actions>
			<div class="mail-view-reply-actions flex items-center gap-2">
				@button.Button(button.Props{
					Variant:    button.VariantOutline,
					Class:      "flex-1 h-8 border-ink/10 text-subtle-foreground hover:text-ink hover:border-ink/20",
					Attributes: templ.Attributes{"data-on-click": onAction("continueEditingDraft", item.ID)},
				}) {
					<span class="flex items-center gap-1.5 text-xs">
						@icon.Pencil(icon.Props{Class: "size-3.5"})
						Continue editing
					</span>
				}
				@button.Button(button.Props{
					Variant:    button.VariantOutline,
					Class:      "flex-1 h-8 border-ink/10 text-subtle-foreground hover:text-destructive hover:border-destructive/20",
					Attributes: templ.Attributes{"data-on-click": onAction("discardReadPaneDraft", item.ID)},
				}) {
					<span class="flex items-center gap-1.5 text-xs">
						@icon.Trash2(icon.Props{Class: "size-3.5"})
						Discard draft
					</span>
				}
			</div>
		</div>
	} else if showUnsubscribe {
		// Reply, reply all and forward live in the message's header row, so unsubscribe is the
		// only action left down here. The bar shows only while its button does; app.js reveals
		// the button once the body is fetched and the headers are stored.
		<div class="mail-view-reply-actions hidden has-[button:not(.hidden)]:flex items-center gap-2 mt-4 pt-3 border-t border-ink/6">
			if method, target := UnsubscribeAction(threadItemEmail(item)); method != "" || item.ListUnsubscribe == "" {
				@button.Button(button.Props{
					Variant: button.VariantOutline,
					Class:   threadUnsubscribeButtonClass(method),
					Attributes: templ.Attributes{
						"data-on-click":           onAction("unsubscribeFromMessage", actionElement),
						"data-unsubscribe-id":     item.ID,
						"data-unsubscribe-method": method,
						"data-unsubscribe-target": target,
						"data-unsubscribe-sender": contactDisplay(item.From),
					},
				}) {
					<span class="flex items-center gap-1.5 text-xs">
						@icon.MailX(icon.Props{Class: "size-3.5"})
						Unsubscribe
					</span>
				}
			}
		</div>
	}
}

templ ShortcutKbd(id string) {
	<kbd class="kbd" data-shortcut={ id }>{ shortcutKeys[id] }</kbd>
}

func deleteLabel(email *models.Email) string {
	if mailEmailIsTrash(email) {
		return threadAwareLabel("Permanently delete", "Permanently delete thread", email)
	}
	return threadAwareLabel("Delete", "Delete thread", email)
}

func readLabel(email *models.Email, thread []models.ThreadItem) string {
	if mailViewRead(email, thread) {
		return threadAwareLabel("Mark as unread", "Mark thread as unread", email)
	}
	return threadAwareLabel("Mark as read", "Mark thread as read", email)
}

// MailViewSnoozeMenu hides the thread from the inbox until a time, or sets a
// reminder that fires only if nobody replies. Both are local to Raven.
templ MailViewSnoozeMenu(email *models.Email) {
	@dropdown.Dropdown() {
		@dropdown.Trigger() {
			@button.Button(button.Props{
				Variant:    button.VariantGhost,
				Size:       button.SizeIcon,
				Class:      "h-8 w-8 text-subtle-foreground hover:text-foreground hover:bg-row-hover",
				Attributes: templ.Attributes{"aria-label": withShortcut("Snooze or remind", "snooze"), "title": withShortcut("Snooze or remind", "snooze"), "aria-keyshortcuts": shortcutKeys["snooze"], "data-mail-snooze-menu": email.ID},
			}) {
				@icon.AlarmClock(icon.Props{Class: "size-4"})
			}
		}
		@dropdown.Content() {
			@dropdown.Label() {
				Snooze until
			}
			for _, preset := range snoozePresets {
				@dropdown.Item(dropdown.ItemProps{Attributes: templ.Attributes{"data-on-click": onAction("snoozeThread", email.ID, preset.Value)}}) {
					{ preset.Label }
				}
			}
			@dropdown.Separator()
			@dropdown.Label() {
				Remind me if no reply
			}
			for _, preset := range followUpPresets {
				@dropdown.Item(dropdown.ItemProps{Attributes: templ.Attributes{"data-on-click": onAction("followUpThread", email.ID, preset.Value)}}) {
					{ preset.Label }
				}
			}
			@dropdown.Separator()
			@dropdown.Item(dropdown.ItemProps{Attributes: templ.Attributes{"data-on-click": onAction("unsnoozeThread", email.ID)}}) {
				Unsnooze
			}
		}
	}
}

templ MailViewHeader(email *models.Email, thread []models.ThreadItem) {
	// Phone only: Back and the date stay at the top while the action toolbar below moves to
	// the bottom of the reader, within thumb reach (input.css, phone media block).
	<div class="mail-view-phone-top lg:hidden">
		<button type="button" class="inline-flex h-11 w-11 shrink-0 items-center justify-center rounded-md text-muted-foreground hover:text-foreground hover:bg-row-hover" aria-label="Back to list" data-on-click='["clearActiveMailSelection"]'>
			@icon.ChevronLeft(icon.Props{Class: "size-5"})
		</button>
		<span class="text-xs text-subtle-foreground tabular-nums">{ email.DateFull }</span>
	</div>
	<div class="mail-view-toolbar flex items-center justify-between px-6 py-2.5">
		<div class="mail-view-actions flex items-center gap-1 min-w-0">
			@tooltip.Tooltip() {
				@tooltip.Trigger() {
					@button.Button(button.Props{
						Variant:    button.VariantGhost,
						Class:      "h-8 gap-1.5 px-2 text-subtle-foreground hover:text-foreground hover:bg-row-hover",
						Attributes: templ.Attributes{"data-on-click": onAction("archiveThread", email.ID), "aria-label": withShortcut(threadAwareLabel("Archive", "Archive thread", email), "archive"), "aria-keyshortcuts": shortcutKeys["archive"]},
					}) {
						@icon.Archive(icon.Props{Class: "size-4"})
						<span class="mail-view-action-label text-sm">Archive</span>
						@ShortcutKbd("archive")
					}
				}
				@tooltip.Content(tooltip.ContentProps{
					Position:  tooltip.PositionBottom,
					ShowArrow: true,
				}) {
					{ withShortcut(threadAwareLabel("Archive", "Archive thread", email), "archive") }
				}
			}
			@MailViewSnoozeMenu(email)
			@tooltip.Tooltip() {
				@tooltip.Trigger() {
					@button.Button(button.Props{
						Variant:    button.VariantGhost,
						Size:       button.SizeIcon,
						Class:      mailDeleteActionClass("h-8 w-8", "text-subtle-foreground hover:text-foreground hover:bg-row-hover", mailEmailIsTrash(email)),
						Attributes: templ.Attributes{"data-on-click": threadAwareAction("deleteMessage", "deleteThread", email), "aria-label": withShortcut(deleteLabel(email), "delete"), "aria-keyshortcuts": shortcutKeys["delete"]},
					}) {
						@icon.Trash2(icon.Props{Class: "size-4"})
					}
				}
				@tooltip.Content(tooltip.ContentProps{
					Position:  tooltip.PositionBottom,
					ShowArrow: true,
				}) {
					{ withShortcut(deleteLabel(email), "delete") }
				}
				}
				@tooltip.Tooltip() {
					@tooltip.Trigger() {
						if mailEmailIsSpam(email) {
							@button.Button(button.Props{
								Variant:    button.VariantGhost,
								Size:       button.SizeIcon,
								Class:      "h-8 w-8 border border-amber-500/35 bg-amber-500/12 text-amber-700 shadow-[0_1px_2px_rgba(0,0,0,0.04)] hover:bg-amber-500/20 hover:text-amber-800 dark:border-amber-300/20 dark:bg-amber-300/10 dark:text-amber-300 dark:hover:text-amber-200",
								Attributes: templ.Attributes{"data-on-click": threadAwareAction("markNotSpam", "markThreadNotSpam", email), "aria-label": "Not spam"},
							}) {
								@icon.ShieldCheck(icon.Props{Class: "size-4"})
							}
						} else {
							@button.Button(button.Props{
								Variant:    button.VariantGhost,
								Size:       button.SizeIcon,
								Class:      "h-8 w-8 text-subtle-foreground hover:text-foreground hover:bg-row-hover",
								Attributes: templ.Attributes{"data-on-click": threadAwareAction("markSpam", "markThreadSpam", email), "aria-label": "Mark as spam"},
							}) {
								@icon.ShieldAlert(icon.Props{Class: "size-4"})
							}
						}
				}
				@tooltip.Content(tooltip.ContentProps{
					Position:  tooltip.PositionBottom,
					ShowArrow: true,
				}) {
					if mailEmailIsSpam(email) {
						{ threadAwareLabel("Not spam", "Mark thread as not spam", email) }
					} else {
						{ threadAwareLabel("Report spam", "Report thread as spam", email) }
					}
				}
			}
			@tooltip.Tooltip() {
				@tooltip.Trigger() {
					@button.Button(button.Props{
						Variant:    button.VariantGhost,
						Size:       button.SizeIcon,
						Class:      "h-8 w-8",
						Attributes: mergeAttributes(mailViewStarAttributes(email), templ.Attributes{"aria-label": withShortcut("Star", "star"), "aria-keyshortcuts": shortcutKeys["star"]}),
					}) {
						if mailViewStarred(email, thread) {
							@icon.Star(icon.Props{Class: "size-4 text-warning fill-warning drop-shadow-[0_1px_1px_rgba(180,120,0,0.3)]"})
						} else {
							@icon.Star(icon.Props{Class: "size-4 text-subtle-foreground"})
						}
					}
				}
				@tooltip.Content(tooltip.ContentProps{
					Position:  tooltip.PositionBottom,
					ShowArrow: true,
				}) {
					{ withShortcut("Star", "star") }
				}
			}
			@tooltip.Tooltip() {
				@tooltip.Trigger() {
					@button.Button(button.Props{
						Variant:    button.VariantGhost,
						Size:       button.SizeIcon,
						Class:      "h-8 w-8 text-subtle-foreground hover:text-foreground hover:bg-row-hover",
						Attributes: mergeAttributes(mailViewReadAttributes(email, thread), templ.Attributes{"aria-label": withShortcut(readLabel(email, thread), "read"), "aria-keyshortcuts": shortcutKeys["read"]}),
					}) {
						if mailViewRead(email, thread) {
							@icon.Mail(icon.Props{Class: "size-4"})
						} else {
							@icon.MailOpen(icon.Props{Class: "size-4"})
						}
					}
				}
				@tooltip.Content(tooltip.ContentProps{
					Position:  tooltip.PositionBottom,
					ShowArrow: true,
				}) {
					{ withShortcut(readLabel(email, thread), "read") }
				}
			}
		</div>
		<div class="mail-view-meta flex items-center gap-2">
			if len(email.Labels) > 0 {
				for _, label := range email.Labels {
					<span class={ "inline-flex items-center gap-1 text-xs pl-2 pr-1 py-0.5 rounded font-medium shadow-[0_1px_2px_rgba(0,0,0,0.06)]", label.Color }>
						{ label.Name }
						<button
							type="button"
							class="inline-flex size-4 items-center justify-center rounded text-current/60 transition-colors hover:bg-background/60 hover:text-current focus-visible:outline-none focus-visible:ring-1 focus-visible:ring-ring"
							aria-label={ "Remove label " + label.Name }
							{ templ.Attributes{"data-on-click": onAction("removeLabelMessage", email.ID, label.Name, email.ThreadCount > 1)}... }
						>
							@icon.X(icon.Props{Class: "size-3"})
						</button>
					</span>
				}
			}
			<span class="mail-view-date text-xs text-subtle-foreground tabular-nums">{ email.DateFull }</span>
			if !email.IsDraft {
				// Phone only: the reply bar is hidden there, so Reply joins the bottom toolbar.
				<button type="button" class="mail-view-phone-reply lg:hidden" aria-label="Reply" data-on-click={ onAction("handleReply", nil, "reply") }>
					@icon.Reply(icon.Props{Class: "size-4"})
					<span class="mail-view-phone-reply-label">Reply</span>
				</button>
			}
			@dropdown.Dropdown() {
				@dropdown.Trigger() {
					@button.Button(button.Props{
						Variant:    button.VariantGhost,
						Size:       button.SizeIcon,
						Class:      "h-8 w-8 text-subtle-foreground hover:text-foreground",
						Attributes: templ.Attributes{"aria-label": "More actions"},
					}) {
						@icon.EllipsisVertical(icon.Props{Class: "size-4"})
					}
				}
				@dropdown.Content() {
					if email.IsDraft {
						@dropdown.Item(dropdown.ItemProps{Attributes: templ.Attributes{"data-on-click": onAction("continueEditingDraft", email.ID)}}) {
							<span class="flex items-center gap-2">
								@icon.Pencil(icon.Props{Class: "size-4"})
								Continue editing
							</span>
						}
						@dropdown.Item(dropdown.ItemProps{Attributes: templ.Attributes{"data-on-click": onAction("discardReadPaneDraft", email.ID)}}) {
							<span class="flex items-center gap-2 text-destructive">
								@icon.Trash2(icon.Props{Class: "size-4"})
								Discard draft
							</span>
						}
						@dropdown.Separator()
					} else {
						@dropdown.Item(dropdown.ItemProps{Attributes: templ.Attributes{"data-on-click": onAction("handleReply", nil, "reply")}}) {
							<span class="flex items-center gap-2">
								@icon.Reply(icon.Props{Class: "size-4"})
								Reply
							</span>
						}
						@dropdown.Item(dropdown.ItemProps{Attributes: templ.Attributes{"data-on-click": onAction("handleReply", nil, "forward")}}) {
							<span class="flex items-center gap-2">
								@icon.Forward(icon.Props{Class: "size-4"})
								Forward
							</span>
						}
						@dropdown.Separator()
					}
					@dropdown.Item(dropdown.ItemProps{Attributes: templ.Attributes{"data-on-click": onAction("promptLabelMessage", email.ID, email.ThreadCount > 1)}}) {
						<span class="flex items-center gap-2">
							@icon.Tag(icon.Props{Class: "size-4"})
							Add label
							<span class="ml-auto pl-4">
								@ShortcutKbd("label")
							</span>
						</span>
					}
					@dropdown.Item(dropdown.ItemProps{Attributes: templ.Attributes{"data-on-click": onAction("performMailAction", "move", []string{email.ID}, map[string]bool{"keepSelection": true})}}) {
						<span class="flex items-center gap-2">
							@icon.FolderInput(icon.Props{Class: "size-4"})
							Move to...
							<span class="ml-auto pl-4">
								@ShortcutKbd("move")
							</span>
						</span>
					}
					@dropdown.Separator()
					@dropdown.Item(dropdown.ItemProps{Attributes: templ.Attributes{"data-on-click": onAction("downloadMessageRaw", email.ID)}}) {
						<span class="flex items-center gap-2">
							@icon.Download(icon.Props{Class: "size-4"})
							Download
						</span>
					}
					@dropdown.Item(dropdown.ItemProps{Attributes: templ.Attributes{"data-on-click": onAction("printMessage", email.ID)}}) {
						<span class="flex items-center gap-2">
							@icon.Printer(icon.Props{Class: "size-4"})
							Print
						</span>
					}
					@dropdown.Item() {
						<span class="flex items-center gap-2" data-refetch-email={ email.ID }>
							@icon.RefreshCw(icon.Props{Class: "size-4"})
							Re-fetch
						</span>
					}
				}
			}
		</div>
	</div>
}

templ MailViewSender(email *models.Email) {
	<div class="mail-view-sender flex items-start gap-4">
		@MailViewAvatar(email.From, email.ID, "mail-view-avatar size-10 rounded-full text-sm font-medium shrink-0", "")
		<div class="flex-1 min-w-0">
			<div class="flex items-center gap-2 flex-wrap">
				<span class="font-semibold text-ink">{ email.From.Name }</span>
				<span class="text-xs text-subtle-foreground">&lt;{ email.From.Email }&gt;</span>
			</div>
			<div class="text-xs text-subtle-foreground mt-0.5">
				if len(email.To) > 0 {
					to { contactDisplay(email.To[0]) }
					if len(email.To) > 1 {
						{ fmt.Sprintf(" and %d more", len(email.To)-1) }
					}
				}
				if len(email.CC) > 0 {
					, cc { contactDisplay(email.CC[0]) }
					if len(email.CC) > 1 {
						{ fmt.Sprintf(" and %d more", len(email.CC)-1) }
					}
				}
			</div>
		</div>
		@popover.Root() {
			@popover.Trigger() {
				<button type="button" aria-label="Message details" class="shrink-0 size-7 rounded flex items-center justify-center text-subtle-foreground hover:text-foreground hover:bg-row-hover transition-colors mt-0.5">
					@icon.EllipsisVertical(icon.Props{Class: "size-3.5"})
				</button>
			}
			@popover.Content(popover.ContentProps{
				Placement: popover.PlacementBottomEnd,
				Offset:    8,
				Class:     "w-80 p-0",
			}) {
				<div class="p-4 space-y-3">
					<div class="flex items-start gap-3">
						@ContactAvatar(email.From, "size-10 rounded-full text-sm font-medium shrink-0", "")
						<div class="flex-1 min-w-0">
							<div class="flex items-center gap-2">
								<span class="font-semibold text-sm text-ink truncate">{ email.From.Name }</span>
								@copybutton.CopyButton(copybutton.Props{
									TargetID: "detail-from-email",
									Class:    "h-5 w-5",
								})
							</div>
							<p id="detail-from-email" class="text-xs text-subtle-foreground truncate">{ email.From.Email }</p>
						</div>
					</div>
					if len(email.To) > 0 {
						<div>
							<span class="text-xs font-medium text-subtle-foreground">To</span>
							<div class="mt-1 space-y-0.5">
								for _, c := range email.To {
									<div class="flex items-center gap-2">
										<span class="text-sm text-ink truncate">{ contactDisplay(c) }</span>
										<span class="text-xs text-subtle-foreground truncate">&lt;{ c.Email }&gt;</span>
									</div>
								}
							</div>
						</div>
					}
					if len(email.CC) > 0 {
						<div>
							<span class="text-xs font-medium text-subtle-foreground">Cc</span>
							<div class="mt-1 space-y-0.5">
								for _, c := range email.CC {
									<div class="flex items-center gap-2">
										<span class="text-sm text-ink truncate">{ contactDisplay(c) }</span>
										<span class="text-xs text-subtle-foreground truncate">&lt;{ c.Email }&gt;</span>
									</div>
								}
							</div>
						</div>
					}
					if email.DateFull != "" {
						<div class="pt-2 border-t border-ink/6">
							<div class="flex items-center gap-2 text-xs text-subtle-foreground">
								@icon.Clock(icon.Props{Class: "size-3.5 shrink-0"})
								<span>{ email.DateFull }</span>
							</div>
						</div>
					}
				</div>
			}
		}
	</div>
	<div class="mail-view-subject-row flex items-start justify-between gap-4 mt-5">
		<h1 class="text-[22px] leading-7 font-semibold tracking-tight text-foreground min-w-0 text-balance">{ email.Subject }</h1>
		@EmailBodyStyleTabs(email.ID, true, "h-8", "h-7")
	</div>
	@MailViewSignInCode(email)
	@MailViewAttachments(email)
}

// MailViewSignInCode offers a copy chip when the message carries a sign-in or verification code.
templ MailViewSignInCode(email *models.Email) {
	if code := mailmessage.ExtractSignInCode(email.Subject, email.TextBody); code != "" {
		<div data-signin-code class="mt-3 mb-2 inline-flex items-center gap-1.5 rounded-md border border-ink/6 bg-ink/[0.03] py-0.5 pl-2.5 pr-1 text-xs text-subtle-foreground">
			<span>Sign-in code</span>
			<span id={ "signin-code-" + email.ID } class="font-mono text-sm font-medium tracking-wider text-foreground">{ code }</span>
			@copybutton.CopyButton(copybutton.Props{
				TargetID: "signin-code-" + email.ID,
				Class:    "h-5 w-5",
				Attrs:    templ.Attributes{"aria-label": "Copy code " + code, "title": "Copy code"},
			})
		</div>
	}
}

templ MailViewAttachments(email *models.Email) {
	if len(email.Attachments) > 0 {
		<div class="mt-5 space-y-2">
			for _, att := range email.Attachments {
				if shouldShowAttachment(att) {
					<div class="mail-view-attachment flex items-center gap-3 px-4 py-2.5 rounded-lg border border-ink/8">
						<div class="flex items-center justify-center size-9 rounded-md bg-ink/[0.03] shadow-[0_1px_2px_rgba(0,0,0,0.06)_inset]">
							@icon.File(icon.Props{Class: "size-4 text-subtle-foreground"})
						</div>
						<div class="flex-1 min-w-0">
							<p class="text-sm font-medium text-ink truncate">{ att.Filename }</p>
							<p class="text-xs text-subtle-foreground">{ humanize.Bytes(uint64(att.SizeBytes)) }</p>
						</div>
						<a href={ fmt.Sprintf("/api/attachments/%d/download", att.ID) } download>
							@button.Button(button.Props{
								Variant: button.VariantOutline,
								Size:    button.SizeSm,
								Class:   "shrink-0 border-ink/10 text-muted-foreground hover:text-ink",
							}) {
								<span class="flex items-center gap-1.5">
									@icon.Download(icon.Props{Class: "size-3.5"})
									Download
								</span>
							}
						</a>
					</div>
				}
			}
		</div>
	}
}

// SenderWarningBanner is rendered server-side only when a local look-alike check fired.
templ SenderWarningBanner(warnings []string) {
	if len(warnings) > 0 {
		<div data-sender-warning-banner role="note" class="mt-3 mb-3 w-full px-3 py-2.5 rounded-lg border border-amber-600/20 bg-amber-50/50 dark:bg-amber-900/10 flex items-center gap-3">
			<div class="size-7 rounded-md bg-amber-100 dark:bg-amber-900/30 flex items-center justify-center shrink-0">
				@icon.TriangleAlert(icon.Props{Class: "size-3.5 text-amber-600 dark:text-amber-400"})
			</div>
			<div class="min-w-0 flex-1 text-xs text-muted-foreground">
				for _, warning := range warnings {
					<p>{ warning }</p>
				}
			</div>
		</div>
	}
}

templ MailViewBody(email *models.Email) {
	@MailViewBodyByID(email.ID)
}

templ MailViewBodyByID(emailID string) {
	<div data-remote-content-banner={ emailID } class="hidden mb-3 w-full px-3 py-2.5 rounded-lg border border-amber-600/20 bg-amber-50/50 dark:bg-amber-900/10 flex items-center gap-3">
			<div class="size-7 rounded-md bg-amber-100 dark:bg-amber-900/30 flex items-center justify-center shrink-0">
				@icon.ImageOff(icon.Props{Class: "size-3.5 text-amber-600 dark:text-amber-400"})
			</div>
			<span class="min-w-0 flex-1 text-xs text-muted-foreground">Remote content is blocked to protect your privacy</span>
			<div class="flex shrink-0 items-center">
				<button type="button" data-load-remote={ emailID } class="text-xs font-medium text-amber-700 dark:text-amber-400 hover:text-amber-800 dark:hover:text-amber-300 transition-colors cursor-pointer whitespace-nowrap">
					Show content
				</button>
				@dropdown.Dropdown() {
					@dropdown.Trigger() {
						<button type="button" aria-label="More options for remote content" class="ml-0.5 size-5 rounded flex items-center justify-center text-amber-600 dark:text-amber-400 hover:bg-amber-100 dark:hover:bg-amber-900/30 transition-colors cursor-pointer">
							@icon.ChevronDown(icon.Props{Class: "size-3"})
						</button>
					}
					@dropdown.Content(dropdown.ContentProps{
						Placement: dropdown.PlacementBottomEnd,
					}) {
						@dropdown.Item(dropdown.ItemProps{
							Attributes: templ.Attributes{"data-allow-remote": emailID, "data-allow-mode": "email"},
						}) {
							<span class="flex items-center gap-2">
								@icon.Mail(icon.Props{Class: "size-3.5"})
								<span class="text-xs">Always for this email</span>
							</span>
						}
						@dropdown.Item(dropdown.ItemProps{
							Attributes: templ.Attributes{"data-allow-remote": emailID, "data-allow-mode": "sender"},
						}) {
							<span class="flex items-center gap-2">
								@icon.User(icon.Props{Class: "size-3.5"})
								<span class="text-xs">Always for this sender</span>
							</span>
						}
					}
				}
			</div>
	</div>
	<div data-email-translation-shell={ emailID } class="mb-3">
		<div class="flex items-center justify-end gap-2">
			<div data-email-translation-button={ emailID } data-translated="false" class="inline-flex h-8 overflow-hidden rounded-md border border-transparent text-xs font-medium text-muted-foreground transition-colors hover:border-ink/20 hover:bg-ink/[0.07] hover:text-ink data-[translated=true]:border-copper/40 data-[translated=true]:bg-copper/10 data-[translated=true]:text-copper data-[translated=true]:hover:border-copper/50 data-[translated=true]:hover:bg-copper/15">
					<button type="button" data-translate-email={ emailID } data-translated="false" aria-pressed="false" title="Translated by Google" class="inline-flex h-full items-center gap-1.5 px-2.5 transition-colors data-[translated=true]:text-copper">
						@icon.Languages(icon.Props{Class: "size-3.5"})
						<span data-translate-email-label={ emailID }>Translate</span>
						<span class="text-subtle-foreground">by Google</span>
					</button>
					@dropdown.Dropdown() {
						@dropdown.Trigger() {
							<button type="button" class="email-translation-language-trigger inline-flex h-full w-7 items-center justify-center border-l border-ink/10 transition-colors focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring focus-visible:ring-offset-2 ring-offset-background" aria-label="Choose translation language">
								@icon.ChevronDown(icon.Props{Class: "size-3"})
							</button>
						}
						@dropdown.Content(dropdown.ContentProps{
							Placement: dropdown.PlacementBottomEnd,
							Class:     "email-translation-language-menu w-40 normal-case tracking-normal",
						}) {
							@dropdown.Label(dropdown.LabelProps{Class: "text-xs text-muted-foreground"}) { Translate with Google into }
							for _, language := range translationLanguageOptions() {
								@dropdown.Item(dropdown.ItemProps{
									Class: "email-translation-language-item text-xs group relative justify-start pr-8 font-light outline-none transition-colors duration-150",
									Attributes: templ.Attributes{
										"data-translate-email-language":     emailID,
										"data-translation-language":          language.Value,
										"data-translation-language-selected": "false",
									},
								}) {
									<span>{ language.Label }</span>
								}
							}
						}
					}
			</div>
		</div>
	</div>
	<div data-email-body-loading={ emailID } class="space-y-3 py-2" aria-label="Loading email body">
		<div class="h-4 w-full rounded bg-ink/5 animate-pulse"></div>
		<div class="h-4 w-11/12 rounded bg-ink/5 animate-pulse"></div>
		<div class="h-4 w-4/5 rounded bg-ink/5 animate-pulse"></div>
		<div class="h-4 w-2/3 rounded bg-ink/5 animate-pulse"></div>
	</div>
	// No opacity transition: the frame resizes as its pictures load, and the Mac
	// web view drops what it painted during a fade when the layer resizes, leaving
	// the top of the message blank until it is scrolled.
	<iframe id={ "email-body-frame-" + emailID }
		sandbox="allow-scripts"
		class="w-full border-0 min-h-[100px] overflow-hidden opacity-0"
		data-email-body-frame
		data-email-id={ emailID }>
	</iframe>
}

templ MailViewReplyBar(email *models.Email) {
	<div class="py-3 border-t border-border" id="reply-bar" data-message-id={ email.InternetMessageID } data-references={ email.References } data-subject={ email.Subject } data-from-email={ email.From.Email } data-from-name={ email.From.Name } data-account-id={ email.AccountID } data-date={ email.DateFull } data-to={ formatContacts(email.To) } data-cc={ formatContacts(email.CC) } data-body={ email.TextBody }>
		<div class="mail-view-reply-form mx-auto flex max-w-[720px] items-center gap-2 px-8">
			<button type="button" class="mail-view-reply-input" data-on-click={ onAction("handleReply", actionElement, replyBarInputMode(email)) }>
				{ replyBarInputLabel(email) }
			</button>
			// Rendered hidden when the headers are not stored yet (message synced before they were
			// captured); app.js reveals it once the body fetch has stored them.
			if method, target := UnsubscribeAction(email); method != "" || email.ListUnsubscribe == "" {
				@button.Button(button.Props{
					Variant: button.VariantOutline,
					Class:   unsubscribeButtonClass(method),
					Attributes: templ.Attributes{
						"data-on-click":           onAction("unsubscribeFromMessage", actionElement),
						"data-unsubscribe-id":     email.ID,
						"data-unsubscribe-method": method,
						"data-unsubscribe-target": target,
						"data-unsubscribe-sender": contactDisplay(email.From),
						"aria-label":              "Unsubscribe",
					},
				}) {
					@icon.MailX(icon.Props{Class: "size-4"})
					<span class="mail-view-reply-label text-sm">Unsubscribe</span>
				}
			}
			@button.Button(button.Props{
				Variant:    button.VariantOutline,
				Class:      "h-9 shrink-0 gap-1.5 px-3 border-input bg-background text-foreground hover:bg-row-hover",
				Attributes: templ.Attributes{"data-on-click": onAction("handleReply", actionElement, "forward"), "aria-keyshortcuts": shortcutKeys["forward"], "aria-label": "Forward"},
			}) {
				@icon.Forward(icon.Props{Class: "size-4"})
				<span class="mail-view-reply-label text-sm">Forward</span>
			}
			<div class="mail-view-reply-split inline-flex shrink-0 items-stretch">
				@button.Button(button.Props{
					Variant:    button.VariantDefault,
					Class:      "h-9 gap-1.5 rounded-r-none px-3 bg-foreground text-background hover:bg-foreground/90",
					Attributes: templ.Attributes{"data-on-click": onAction("handleReply", actionElement, "reply"), "aria-keyshortcuts": shortcutKeys["reply"], "aria-label": "Reply"},
				}) {
					@icon.Reply(icon.Props{Class: "size-4"})
					<span class="mail-view-reply-label text-sm">Reply</span>
				}
				@dropdown.Dropdown() {
					@dropdown.Trigger() {
						@button.Button(button.Props{
							Variant:    button.VariantDefault,
							Class:      "h-9 w-8 rounded-l-none border-l border-background/25 px-0 bg-foreground text-background hover:bg-foreground/90",
							Attributes: templ.Attributes{"aria-label": "More reply options"},
						}) {
							@icon.ChevronDown(icon.Props{Class: "size-4"})
						}
					}
					@dropdown.Content() {
						@dropdown.Item(dropdown.ItemProps{Attributes: templ.Attributes{"data-on-click": onAction("handleReply", nil, "reply-all")}}) {
							<span class="flex w-full items-center gap-2">
								@icon.ReplyAll(icon.Props{Class: "size-4"})
								Reply all
								<span class="ml-auto pl-4">
									@ShortcutKbd("reply-all")
								</span>
							</span>
						}
					}
				}
			</div>
		</div>
		<div class="mail-view-hints mx-auto max-w-[720px] px-8" aria-hidden="true">
			<span>
				Reply
				@ShortcutKbd("reply")
				<i>&middot;</i>
				Forward
				@ShortcutKbd("forward")
				<i>&middot;</i>
				Archive
				@ShortcutKbd("archive")
			</span>
			<span>All commands <kbd class="kbd hint-mac">&#8984;K</kbd><kbd class="kbd hint-other">Ctrl K</kbd></span>
		</div>
	</div>
}

// ThreadUnsubscribeID picks the message whose Unsubscribe button a conversation shows:
// the newest with a usable List-Unsubscribe, else the newest when its headers are not
// stored yet (rendered hidden, revealed once the body loads), else "". thread is in display order.
func ThreadUnsubscribeID(thread []models.ThreadItem, newestFirst bool) string {
	if len(thread) < 2 {
		return ""
	}
	at := func(n int) *models.ThreadItem { // n-th newest
		if newestFirst {
			return &thread[n]
		}
		return &thread[len(thread)-1-n]
	}
	for n := range thread {
		if m, _ := UnsubscribeAction(threadItemEmail(at(n))); m != "" {
			return at(n).ID
		}
	}
	if newest := at(0); newest.ListUnsubscribe == "" {
		return newest.ID
	}
	return ""
}

func threadItemEmail(item *models.ThreadItem) *models.Email {
	return &models.Email{ID: item.ID, ListUnsubscribe: item.ListUnsubscribe, ListUnsubscribePost: item.ListUnsubscribePost}
}

func threadUnsubscribeButtonClass(method string) string {
	class := "h-8 shrink-0 border-ink/10 text-subtle-foreground hover:text-ink hover:border-ink/20"
	if method == "" {
		class += " hidden"
	}
	return class
}

// UnsubscribeAction is how the reply bar's Unsubscribe button works for this message
// ("" = no button) and, for mailto, the address the request goes to.
func UnsubscribeAction(email *models.Email) (method, target string) {
	u := mailmessage.ParseListUnsubscribe(email.ListUnsubscribe, email.ListUnsubscribePost)
	method = u.Method()
	if method == mailmessage.UnsubscribeMailto {
		if to, _, _, ok := mailmessage.MailtoRequest(u.Mailto); ok {
			target = to.Address
		} else {
			method = "" // unusable mailto: nothing to offer unless https exists
			if u.HTTPS != "" {
				method = mailmessage.UnsubscribeBrowser
			}
		}
	}
	return method, target
}

func unsubscribeButtonClass(method string) string {
	class := "h-9 shrink-0 gap-1.5 px-3 border-input bg-background text-foreground hover:bg-row-hover"
	if method == "" {
		class += " hidden"
	}
	return class
}

// replyBarInputMode is the action behind the wide "Reply..." field: reply-all when
// there is anyone besides the sender to include.
func replyBarInputMode(email *models.Email) string {
	if len(email.To)+len(email.CC) > 1 {
		return "reply-all"
	}
	return "reply"
}

func replyBarInputLabel(email *models.Email) string {
	if replyBarInputMode(email) == "reply-all" {
		return "Reply all\u2026"
	}
	return "Reply\u2026"
}

templ MailViewDraftBar(email *models.Email) {
	<div class="py-3 border-t border-border" id="reply-bar">
		<div class="mail-view-reply-actions mx-auto flex max-w-[720px] items-center gap-2 px-8">
			@button.Button(button.Props{
				Variant:    button.VariantOutline,
				Class:      "h-9 px-3 border-input bg-background text-foreground hover:bg-row-hover",
				Attributes: templ.Attributes{"data-on-click": onAction("continueEditingDraft", email.ID)},
			}) {
				<span class="flex items-center gap-2 text-sm">
					@icon.Pencil(icon.Props{Class: "size-4"})
					Continue editing
				</span>
			}
			@button.Button(button.Props{
				Variant:    button.VariantOutline,
				Class:      "h-9 px-3 border-input bg-background text-foreground hover:text-destructive hover:bg-row-hover",
				Attributes: templ.Attributes{"data-on-click": onAction("discardReadPaneDraft", email.ID)},
			}) {
				<span class="flex items-center gap-2 text-sm">
					@icon.Trash2(icon.Props{Class: "size-4"})
					Discard draft
				</span>
			}
		</div>
	</div>
}

templ MailViewEmpty() {
	<div class="flex flex-col items-center justify-center h-full text-center" data-mail-view-empty>
		<div class="space-y-4 animate-fade-in">
			<div class="size-12 rounded-xl flex items-center justify-center mx-auto border">
				@icon.Mail(icon.Props{Class: "size-5 text-subtle-foreground"})
			</div>
			<div>
				<h3 class="text-sm font-medium mb-1">Select an email</h3>
				<p class="text-xs text-subtle-foreground">Choose an email from the list to read it</p>
			</div>
		</div>
	</div>
}
